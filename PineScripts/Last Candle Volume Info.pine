//@version=6
indicator("Liquidity Map & Draw on Liquidity", overlay=true, max_lines_count=500, max_boxes_count=20, max_labels_count=500)

leftBars = input.int(5, "Pivot left bars", minval=1, group="Liquidity Detection")
rightBars = input.int(5, "Pivot right bars", minval=1, group="Liquidity Detection")
tolerancePercent = input.float(0.05, "Equal level tolerance (%)", minval=0.001, step=0.01, group="Liquidity Detection")
volumeLength = input.int(20, "Volume SMA length", minval=1, group="Liquidity Strength")
highVolumeMultiplier = input.float(1.0, "High volume multiplier", minval=0.1, step=0.1, group="Liquidity Strength")
maxTargetDistancePercent = input.float(2.0, "Maximum target distance (%)", minval=0.1, step=0.1, group="Target Validation")
useAtrDistanceFilter = input.bool(false, "Use ATR distance cap", group="Target Validation")
atrLength = input.int(14, "ATR length", minval=1, group="Target Validation")
atrDistanceMultiplier = input.float(1.5, "Maximum ATR distance", minval=0.1, step=0.1, group="Target Validation")
negativeDeltaThreshold = input.float(-25.0, "Negative Delta failure threshold", maxval=-0.1, step=1.0, group="Volume Validation")
requireBullConfirmation = input.bool(true, "Require Delta or CMF bull confirmation", group="Volume Validation")
momentumDeltaThreshold = input.float(35.0, "Bullish momentum delta threshold", minval=1.0, maxval=100.0, step=1.0, group="Trend / Momentum Filter")
momentumCmfThreshold = input.float(0.05, "Bullish momentum CMF threshold", minval=0.0, step=0.01, group="Trend / Momentum Filter")
useTrendMomentumFilter = input.bool(true, "Block counter-trend bear sweeps", group="Trend / Momentum Filter")
minorStructureBars = input.int(3, "Minor structure pivot bars", minval=1, group="CHoCH Continuation")
showChochLabels = input.bool(true, "Show CHoCH labels", group="CHoCH Continuation")
string mtfSettingsGroup = "Multi-Timeframe & Lower TF Settings"
h4SweepTimeframe = input.timeframe("240", "Higher timeframe liquidity source", group=mtfSettingsGroup)
showH4Projections = input.bool(true, "Project confirmed HTF levels on lower TFs", group=mtfSettingsGroup)
useInternalStructureSignals = input.bool(true, "Show sweep-confirmed internal CHoCH", group=mtfSettingsGroup)
internalStructureWindow = input.int(3, "Internal CHoCH confirmation window (bars)", minval=1, group=mtfSettingsGroup)
institutionalVolumeSmaLength = input.int(20, "Institutional volume SMA length", minval=1, group=mtfSettingsGroup)
institutionalVolumeMultiplier = input.float(1.8, "Institutional volume spike multiplier", minval=1.0, step=0.1, group=mtfSettingsGroup)
showInstitutionalVolumeMarkers = input.bool(true, "Mark institutional sweeps and absorption", group=mtfSettingsGroup)
cmfLength = input.int(20, "CMF length", minval=1, group="Candle Volume Dashboard")
whaleLength = input.int(20, "Volume average length", minval=1, group="Candle Volume Dashboard")
whaleMultiplier = input.float(2.0, "Volume deviation multiplier", minval=0.1, step=0.1, group="Candle Volume Dashboard")
reversalOutcomeWindow = input.int(20, "Target outcome window (bars)", minval=1, group="Reversal Probability")
highVolumeReversalThreshold = input.float(10000000.0, "High-volume reversal threshold", minval=0.0, step=1000000.0, group="Reversal Probability")
obMergePercent = input.float(0.15, "OB merge tolerance (%)", minval=0.001, step=0.01, group="Order Block Clustering")
useAtrObMerge = input.bool(true, "Use ATR OB merge tolerance", group="Order Block Clustering")
obMergeAtrMultiplier = input.float(0.75, "OB merge ATR multiplier", minval=0.01, step=0.05, group="Order Block Clustering")
mitigationMode = input.string("Wick Sweep", "Mitigation", options=["Wick Sweep", "Close Breach"], group="Liquidity Cleansing")
keepMitigated = input.bool(true, "Keep mitigated levels", group="Liquidity Cleansing")
maxZones = input.int(100, "Maximum stored zones", minval=10, maxval=250, group="Liquidity Map")
bslColor = input.color(#17dfad, "BSL color", group="Liquidity Map", inline="colors")
sslColor = input.color(#dd326b, "SSL color", group="Liquidity Map", inline="colors")
lineTouchTolerancePercent = input.float(0.02, "Line Touch Tolerance %", minval=0.001, step=0.001, group="Institutional Alerts")
absorptionSmaLength = input.int(10, "Absorption volume/body SMA length", minval=1, group="Institutional Alerts")
absorptionVolumeMultiplier = input.float(1.5, "Absorption volume spike multiplier", minval=1.0, step=0.1, group="Institutional Alerts")

type LiquidityZone
    float level
    bool isBsl
    int touches
    bool highVolume
    bool active
    line lineRef

type BullishOrderBlock
    float top
    float bottom
    float power
    float buyVolume
    float totalVolume
    float deltaVolume
    int touches
    bool active
    box boxRef
    label labelRef

type BearishOrderBlock
    float top
    float bottom
    float power
    float sellVolume
    float totalVolume
    float deltaVolume
    int touches
    bool active
    box boxRef
    label labelRef

var array<LiquidityZone> zones = array.new<LiquidityZone>()
var float activeTarget = na
var int targetDirection = 0
var bool targetActive = false
var string activeTrend = "NONE"
var int targetOriginBar = na
var string targetOriginSignal = ""
var bool targetTracksSweepOutcome = false
var int completedOriginBar = na
var int cancelledOriginBar = na
var int supersededOriginBar = na
var int obReachedOriginBar = na
var float targetInvalidationLevel = na
var line targetLine = na
var label targetLabel = na
var line h4HighProjectionLine = na
var line h4LowProjectionLine = na
var float lastMinorLow = na
var float lastMinorHigh = na
var float lastStructuralLow = na
var float lastStructuralHigh = na
var float bullishObTop = na
var float bullishObBottom = na
var bool bullishObActive = false
var box bullishObBox = na
var float bearishObTop = na
var float bearishObBottom = na
var bool bearishObActive = false
var box bearishObBox = na
var array<BullishOrderBlock> bullishObStack = array.new<BullishOrderBlock>()
var array<BearishOrderBlock> bearishObStack = array.new<BearishOrderBlock>()
var array<int> lockedTargetBars = array.new_int()
var array<string> lockedTargetSignals = array.new_string()
var array<int> supersededTargetBars = array.new_int()
var array<string> supersededTargetOutcomes = array.new_string()
var float lastStructureLabelPrice = na
var int lastStructureLabelBar = na
var bool isTrackingReversal = false
var bool trackingHighSweep = false
var float maxPenetration = 0.0
var float[] historicalSweepsHigh = array.new_float()
var float[] historicalSweepsLow = array.new_float()
var int totalLiquiditySweeps = 0
var int successfulSweepReversals = 0
var float lastSignalH4HighDist = na
var float lastSignalH4LowDist = na
var float lastSignalProbability = na
var string lastSignalBiasStr = "TRENDO TĘSINYS"
var string lastSignalDirectionStr = ""
color statCorridorColor = #ff9800

float atrValue = ta.atr(atrLength)
float labelCollisionOffset = math.max(syminfo.mintick * 10.0, atrValue * 0.75)

toleranceAt(float price) => price * tolerancePercent / 100.0

compactVolume(float value) =>
    float absoluteValue = math.abs(value)
    absoluteValue >= 1000000 ? str.tostring(value / 1000000, "#.##") + "M" : absoluteValue >= 1000 ? str.tostring(value / 1000, "#.##") + "K" : str.tostring(value, "#")

structureLabelText(string signalName, float signalTotalVolume, float signalDeltaPercent) =>
    signalName + "\nVol: " + compactVolume(signalTotalVolume) + "\nDelta: " + str.tostring(signalDeltaPercent, "#.#") + "%"

obMergeDistance(float referencePrice) =>
    float percentDistance = referencePrice * obMergePercent / 100.0
    useAtrObMerge ? math.max(percentDistance, atrValue * obMergeAtrMultiplier) : percentDistance

obRangesAreNear(float firstTop, float firstBottom, float secondTop, float secondBottom) =>
    float referencePrice = math.max(math.max(firstTop, firstBottom), math.max(secondTop, secondBottom))
    float mergeDistance = obMergeDistance(referencePrice)
    bool newTopInsideExisting = secondTop <= firstTop + mergeDistance and secondTop >= firstBottom - mergeDistance
    bool newBottomInsideExisting = secondBottom <= firstTop + mergeDistance and secondBottom >= firstBottom - mergeDistance
    bool existingTopInsideNew = firstTop <= secondTop + mergeDistance and firstTop >= secondBottom - mergeDistance
    bool existingBottomInsideNew = firstBottom <= secondTop + mergeDistance and firstBottom >= secondBottom - mergeDistance
    newTopInsideExisting or newBottomInsideExisting or existingTopInsideNew or existingBottomInsideNew

bullishBlockInvalidated(BullishOrderBlock block) => close <= block.bottom

bearishBlockInvalidated(BearishOrderBlock block) => close >= block.top

addBullishOrderBlock(float obTop, float obBottom, float obPower, float obBuyVolume, float obTotalVolume, float obDeltaVolume) =>
    bool matched = false
    int blockCount = array.size(bullishObStack)
    if blockCount > 0
        for blockIndex = 0 to blockCount - 1
            BullishOrderBlock block = array.get(bullishObStack, blockIndex)
            if block.active and obRangesAreNear(block.top, block.bottom, obTop, obBottom)
                block.touches += 1
                block.power := math.min(100.0, block.power + obPower)
                block.buyVolume += obBuyVolume
                block.totalVolume += obTotalVolume
                block.deltaVolume += obDeltaVolume
                block.top := math.max(block.top, obTop)
                block.bottom := math.min(block.bottom, obBottom)
                box.set_top(block.boxRef, block.top)
                box.set_bottom(block.boxRef, block.bottom)
                float blockDeltaPercent = block.totalVolume > 0 ? block.deltaVolume / block.totalVolume * 100.0 : 0.0
                label.set_text(block.labelRef, "Bull OB: " + str.tostring(block.buyVolume, format.volume) + " [+" + str.tostring(blockDeltaPercent, "#") + "%]")
                label.set_y(block.labelRef, block.bottom)
                array.set(bullishObStack, blockIndex, block)
                matched := true
                break
    if not matched
        float blockDeltaPercent = obTotalVolume > 0 ? obDeltaVolume / obTotalVolume * 100.0 : 0.0
        box newBox = box.new(bar_index - rightBars, obTop, bar_index, obBottom, xloc=xloc.bar_index, border_color=color.new(bslColor, 25), bgcolor=color.new(bslColor, 85))
        label newLabel = label.new(bar_index + 10, obBottom, "Bull OB: " + str.tostring(obBuyVolume, format.volume) + " [+" + str.tostring(blockDeltaPercent, "#") + "%]", xloc=xloc.bar_index, style=label.style_label_left, color=#0b3d2e, textcolor=color.white, size=size.tiny)
        array.push(bullishObStack, BullishOrderBlock.new(obTop, obBottom, obPower, obBuyVolume, obTotalVolume, obDeltaVolume, 1, true, newBox, newLabel))
    if array.size(bullishObStack) > 20
        BullishOrderBlock oldestBlock = array.shift(bullishObStack)
        box.delete(oldestBlock.boxRef)
        label.delete(oldestBlock.labelRef)

addBearishOrderBlock(float obTop, float obBottom, float obPower, float obSellVolume, float obTotalVolume, float obDeltaVolume) =>
    bool matched = false
    int blockCount = array.size(bearishObStack)
    if blockCount > 0
        for blockIndex = 0 to blockCount - 1
            BearishOrderBlock block = array.get(bearishObStack, blockIndex)
            if block.active and obRangesAreNear(block.top, block.bottom, obTop, obBottom)
                block.touches += 1
                block.power := math.min(100.0, block.power + obPower)
                block.sellVolume += obSellVolume
                block.totalVolume += obTotalVolume
                block.deltaVolume += obDeltaVolume
                block.top := math.max(block.top, obTop)
                block.bottom := math.min(block.bottom, obBottom)
                box.set_top(block.boxRef, block.top)
                box.set_bottom(block.boxRef, block.bottom)
                float blockDeltaPercent = block.totalVolume > 0 ? block.deltaVolume / block.totalVolume * 100.0 : 0.0
                label.set_text(block.labelRef, "Bear OB: " + str.tostring(block.sellVolume, format.volume) + " [" + str.tostring(blockDeltaPercent, "#") + "%]")
                label.set_y(block.labelRef, block.top)
                array.set(bearishObStack, blockIndex, block)
                matched := true
                break
    if not matched
        float blockDeltaPercent = obTotalVolume > 0 ? obDeltaVolume / obTotalVolume * 100.0 : 0.0
        box newBox = box.new(bar_index - rightBars, obTop, bar_index, obBottom, xloc=xloc.bar_index, border_color=color.new(color.purple, 25), bgcolor=color.new(color.purple, 85))
        label newLabel = label.new(bar_index + 10, obTop, "Bear OB: " + str.tostring(obSellVolume, format.volume) + " [" + str.tostring(blockDeltaPercent, "#") + "%]", xloc=xloc.bar_index, style=label.style_label_left, color=#5a1420, textcolor=color.white, size=size.tiny)
        array.push(bearishObStack, BearishOrderBlock.new(obTop, obBottom, obPower, obSellVolume, obTotalVolume, obDeltaVolume, 1, true, newBox, newLabel))
    if array.size(bearishObStack) > 20
        BearishOrderBlock oldestBlock = array.shift(bearishObStack)
        box.delete(oldestBlock.boxRef)
        label.delete(oldestBlock.labelRef)

zonePriority(LiquidityZone zone) =>
    (zone.touches > 1 ? 1000000 : 0) + (zone.highVolume ? 10000 : 0) + zone.touches

zoneColor(LiquidityZone zone) => zone.isBsl ? bslColor : sslColor

refreshZoneStyle(LiquidityZone zone) =>
    int lineWidth = zone.touches > 1 ? 3 : zone.highVolume ? 2 : 1
    int transparency = zone.touches > 1 ? 0 : zone.highVolume ? 20 : 45
    line.set_color(zone.lineRef, color.new(zoneColor(zone), transparency))
    line.set_width(zone.lineRef, lineWidth)
    line.set_style(zone.lineRef, zone.touches > 1 ? line.style_solid : line.style_dotted)

addOrStrengthenZone(float pivotPrice, bool isBsl, bool pivotHighVolume) =>
    bool matched = false
    int zoneCount = array.size(zones)
    if zoneCount > 0
        for zoneIndex = 0 to zoneCount - 1
            LiquidityZone zone = array.get(zones, zoneIndex)
            if zone.active and zone.isBsl == isBsl and math.abs(zone.level - pivotPrice) <= toleranceAt(pivotPrice)
                zone.touches += 1
                zone.highVolume := zone.highVolume or pivotHighVolume
                refreshZoneStyle(zone)
                matched := true
                break
    if not matched
        color newZoneColor = isBsl ? bslColor : sslColor
        line newLine = line.new(bar_index - rightBars, pivotPrice, bar_index, pivotPrice, xloc=xloc.bar_index, extend=extend.right, color=color.new(newZoneColor, pivotHighVolume ? 20 : 45), width=pivotHighVolume ? 2 : 1, style=line.style_dotted)
        array.push(zones, LiquidityZone.new(pivotPrice, isBsl, 1, pivotHighVolume, true, newLine))
    if array.size(zones) > maxZones
        LiquidityZone oldestZone = array.shift(zones)
        line.delete(oldestZone.lineRef)

float volumeSma = ta.sma(volume, volumeLength)
float pivotHigh = ta.pivothigh(high, leftBars, rightBars)
float pivotLow = ta.pivotlow(low, leftBars, rightBars)
float minorPivotLow = ta.pivotlow(low, minorStructureBars, minorStructureBars)
float minorPivotHigh = ta.pivothigh(high, minorStructureBars, minorStructureBars)
if not na(minorPivotLow)
    lastMinorLow := minorPivotLow
if not na(minorPivotHigh)
    lastMinorHigh := minorPivotHigh
bool bearishChoch = not na(lastMinorLow) and close < lastMinorLow and close[1] >= lastMinorLow
if bearishChoch
    lastMinorLow := na
bool bullishChoch = not na(lastMinorHigh) and close > lastMinorHigh and close[1] <= lastMinorHigh
if bullishChoch
    lastMinorHigh := na

// Confirmed H4 pivots lock a series value per bar; past values never change when a new pivot forms.
float confirmedH4PivotHigh = request.security(syminfo.tickerid, h4SweepTimeframe, ta.pivothigh(high, leftBars, rightBars), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float confirmedH4PivotLow = request.security(syminfo.tickerid, h4SweepTimeframe, ta.pivotlow(low, leftBars, rightBars), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool freshH4PivotHigh = not na(confirmedH4PivotHigh) and na(confirmedH4PivotHigh[1])
bool freshH4PivotLow = not na(confirmedH4PivotLow) and na(confirmedH4PivotLow[1])
var float fixedHigh = na
var float fixedLow = na
if freshH4PivotHigh
    fixedHigh := confirmedH4PivotHigh
if freshH4PivotLow
    fixedLow := confirmedH4PivotLow
float htfHigh = fixedHigh
float htfLow = fixedLow
bool h4HighSweep = ta.crossover(high, htfHigh)
bool h4LowSweep = ta.crossunder(low, htfLow)
if h4HighSweep
    isTrackingReversal := true
    trackingHighSweep := true
    maxPenetration := (high - htfHigh) / htfHigh * 100.0
else if h4LowSweep
    isTrackingReversal := true
    trackingHighSweep := false
    maxPenetration := (htfLow - low) / htfLow * 100.0
else if isTrackingReversal
    float currentSweepLevel = trackingHighSweep ? htfHigh : htfLow
    if not na(currentSweepLevel)
        float currentPenetration = trackingHighSweep ? (high - currentSweepLevel) / currentSweepLevel * 100.0 : (currentSweepLevel - low) / currentSweepLevel * 100.0
        maxPenetration := math.max(maxPenetration, currentPenetration)

bool confirmedH4Reversal = barstate.isconfirmed and isTrackingReversal and ((trackingHighSweep and bearishChoch) or (not trackingHighSweep and bullishChoch))
string confirmedReversalType = trackingHighSweep ? "High" : "Low"
if confirmedH4Reversal
    if trackingHighSweep
        array.unshift(historicalSweepsHigh, maxPenetration)
        if array.size(historicalSweepsHigh) > 10
            array.pop(historicalSweepsHigh)
    else
        array.unshift(historicalSweepsLow, maxPenetration)
        if array.size(historicalSweepsLow) > 10
            array.pop(historicalSweepsLow)
    isTrackingReversal := false

float avgHighSweepPercent = 0.58
float avgLowSweepPercent = 0.72
float statHighPlot = not na(fixedHigh) ? fixedHigh * (1.0 + 0.58 / 100.0) : na
float statLowPlot = not na(fixedLow) ? fixedLow * (1.0 - 0.72 / 100.0) : na
float upper_corridor = statHighPlot
float lower_corridor = statLowPlot
float alertPriceHigh = statHighPlot
float alertPriceLow = statLowPlot
bool historicalHighZoneHit = ta.crossover(high, alertPriceHigh)
bool historicalLowZoneHit = ta.crossunder(low, alertPriceLow)
float pctDropFromHigh = not na(htfHigh) ? math.abs((htfHigh - close) / htfHigh * 100.0) : na
float pctRiseFromLow = not na(htfLow) ? math.abs((close - htfLow) / htfLow * 100.0) : na
float liveHighDeviation = not na(htfHigh) and high > htfHigh ? (high - htfHigh) / htfHigh * 100.0 : 0.0
float liveLowDeviation = not na(htfLow) and low < htfLow ? (htfLow - low) / htfLow * 100.0 : 0.0
float liveSweepPenetration = isTrackingReversal ? maxPenetration : na
float applicableSweepAverage = trackingHighSweep ? avgHighSweepPercent : avgLowSweepPercent
bool inReversalProbabilityZone = isTrackingReversal and not na(applicableSweepAverage) and applicableSweepAverage > 0 and math.abs(liveSweepPenetration - applicableSweepAverage) <= applicableSweepAverage * 0.15

// Step plots write fixed values into the historical series instead of moving line objects.
fixedHighPlot = plot(fixedHigh, "Locked H4 High", color=color.new(bslColor, 35), linewidth=2, style=plot.style_stepline)
statHighBoundaryPlot = plot(statHighPlot, "H4 High Statistical Corridor", color=statCorridorColor, linewidth=2, style=plot.style_stepline)
fixedLowPlot = plot(fixedLow, "Locked H4 Low", color=color.new(sslColor, 35), linewidth=2, style=plot.style_stepline)
statLowBoundaryPlot = plot(statLowPlot, "H4 Low Statistical Corridor", color=statCorridorColor, linewidth=2, style=plot.style_stepline)
fill(fixedHighPlot, statHighBoundaryPlot, color=color.new(statCorridorColor, 92), title="H4 High Statistical Fill")
fill(fixedLowPlot, statLowBoundaryPlot, color=color.new(statCorridorColor, 92), title="H4 Low Statistical Fill")

// Confirmed pivots are projected only below their source timeframe, so lower-TF charts retain non-repainting H4 context.
bool projectH4Levels = showH4Projections and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(h4SweepTimeframe)
if projectH4Levels
    if not na(fixedHigh)
        if na(h4HighProjectionLine)
            h4HighProjectionLine := line.new(bar_index - 1, fixedHigh, bar_index, fixedHigh, xloc=xloc.bar_index, extend=extend.right, color=color.new(bslColor, 55), width=2, style=line.style_dashed)
        else
            line.set_xy1(h4HighProjectionLine, bar_index - 1, fixedHigh)
            line.set_xy2(h4HighProjectionLine, bar_index, fixedHigh)
    if not na(fixedLow)
        if na(h4LowProjectionLine)
            h4LowProjectionLine := line.new(bar_index - 1, fixedLow, bar_index, fixedLow, xloc=xloc.bar_index, extend=extend.right, color=color.new(sslColor, 55), width=2, style=line.style_dashed)
        else
            line.set_xy1(h4LowProjectionLine, bar_index - 1, fixedLow)
            line.set_xy2(h4LowProjectionLine, bar_index, fixedLow)
else
    line.delete(h4HighProjectionLine)
    line.delete(h4LowProjectionLine)
    h4HighProjectionLine := na
    h4LowProjectionLine := na

// TradingView provides total volume, so Buy/Sell values are estimated from the close location in each candle.
float candleRange = high - low
float buyRatio = candleRange > 0 ? (close - low) / candleRange : 0.5
float buyVolume = volume * buyRatio
float sellVolume = volume - buyVolume
float ltf_buy_vol = buyVolume
float ltf_sell_vol = sellVolume
float buyVolumeSma = ta.sma(buyVolume, whaleLength)
float buyVolumeStDev = ta.stdev(buyVolume, whaleLength)
float sellVolumeSma = ta.sma(sellVolume, whaleLength)
float sellVolumeStDev = ta.stdev(sellVolume, whaleLength)
float whaleVolumeAverage = ta.sma(volume, whaleLength)
bool isWhaleBuyVolume = buyVolume > buyVolumeSma + whaleMultiplier * buyVolumeStDev
bool isWhaleSellVolume = sellVolume > sellVolumeSma + whaleMultiplier * sellVolumeStDev
float totalVolume = buyVolume + sellVolume
float totalVolumeSma = ta.sma(totalVolume, 20)
bool isVolumeClimax = totalVolume > totalVolumeSma * 1.5
float institutionalVolumeBaseline = ta.sma(volume, institutionalVolumeSmaLength)
bool institutionalVolumeSpike = not na(institutionalVolumeBaseline) and volume > institutionalVolumeBaseline * institutionalVolumeMultiplier
float deltaVol = buyVolume - sellVolume
float deltaPercent = totalVolume > 0 ? (buyVolume - sellVolume) / totalVolume * 100 : 0.0
float closeLocationValue = candleRange > 0 ? ((close - low) - (high - close)) / candleRange : 0.0
float moneyFlowVolume = closeLocationValue * nz(volume, 0)
float cmfVolumeSum = math.sum(moneyFlowVolume, cmfLength)
float cmfTotalVolume = math.sum(nz(volume, 0), cmfLength)
float cmfValue = cmfTotalVolume > 0 ? cmfVolumeSum / cmfTotalVolume : 0.0
bool strongBullishClose = close > open and deltaPercent >= momentumDeltaThreshold and cmfValue >= momentumCmfThreshold
bool bearTargetMomentumInvalidated = targetActive and targetDirection == -1 and bar_index == targetOriginBar + 1 and strongBullishClose

if bearTargetMomentumInvalidated
    supersededOriginBar := targetOriginBar
    array.push(supersededTargetBars, targetOriginBar)
    array.push(supersededTargetOutcomes, "SUPERCEDED -> BULLISH MOMENTUM")
    if array.size(supersededTargetBars) > 20
        array.shift(supersededTargetBars)
        array.shift(supersededTargetOutcomes)
    line.delete(targetLine)
    targetLine := na
    label.delete(targetLabel)
    targetLabel := na
    targetActive := false
    activeTarget := na
    targetDirection := 0
    activeTrend := "NONE"
    targetInvalidationLevel := na
    targetOriginBar := na
    targetOriginSignal := ""
    targetTracksSweepOutcome := false

bool bullishObReclaim = false
int activeBlockCount = array.size(bullishObStack)
if targetActive and activeTrend == "BEAR" and deltaPercent > 0 and cmfValue > 0 and activeBlockCount > 0
    for blockIndex = 0 to activeBlockCount - 1
        BullishOrderBlock block = array.get(bullishObStack, blockIndex)
        bool isTargetedBlock = block.active and math.abs(activeTarget - block.top) <= toleranceAt(block.top)
        if isTargetedBlock and low <= block.top and high >= block.bottom
            bullishObReclaim := true
            break

// A target is cancelled when price reverses beyond the originating sweep candle.
bool targetCancelled = targetActive and ((targetDirection == 1 and low < targetInvalidationLevel) or (targetDirection == -1 and high > targetInvalidationLevel))
int cancelledTargetDirection = targetCancelled ? targetDirection : 0
if targetCancelled
    cancelledOriginBar := targetOriginBar
    line.delete(targetLine)
    targetLine := na
    label.delete(targetLabel)
    targetLabel := na
    targetActive := false
    activeTarget := na
    targetDirection := 0
    activeTrend := "NONE"
    targetInvalidationLevel := na
    targetOriginBar := na
    targetOriginSignal := ""
    targetTracksSweepOutcome := false

if bullishObReclaim
    obReachedOriginBar := targetOriginBar
    line.delete(targetLine)
    targetLine := na
    targetActive := false
    activeTarget := na
    targetDirection := 0
    activeTrend := "NONE"
    targetInvalidationLevel := na
    targetOriginBar := na
    targetOriginSignal := ""
    targetTracksSweepOutcome := false

// Complete an existing forecast before a new sweep can replace it.
bool targetHit = not bullishObReclaim and targetActive and bar_index - targetOriginBar <= reversalOutcomeWindow and ((targetDirection == 1 and high >= activeTarget) or (targetDirection == -1 and low <= activeTarget))
if targetHit
    if targetTracksSweepOutcome
        successfulSweepReversals += 1
    completedOriginBar := targetOriginBar
    array.push(lockedTargetBars, targetOriginBar)
    array.push(lockedTargetSignals, targetOriginSignal)
    if array.size(lockedTargetBars) > 20
        array.shift(lockedTargetBars)
        array.shift(lockedTargetSignals)
    line.set_extend(targetLine, extend.none)
    line.set_x2(targetLine, bar_index)
    line.set_style(targetLine, line.style_dashed)
    line.set_color(targetLine, color.new(color.gray, 55))
    label.delete(targetLabel)
    targetLabel := na
    targetActive := false
    activeTarget := na
    targetDirection := 0
    activeTrend := "NONE"
    targetInvalidationLevel := na
    targetOriginBar := na
    targetOriginSignal := ""
    targetTracksSweepOutcome := false

bool targetExpired = targetActive and bar_index - targetOriginBar > reversalOutcomeWindow
if targetExpired
    line.delete(targetLine)
    targetLine := na
    label.delete(targetLabel)
    targetLabel := na
    targetActive := false
    activeTarget := na
    targetDirection := 0
    activeTrend := "NONE"
    targetInvalidationLevel := na
    targetOriginBar := na
    targetOriginSignal := ""
    targetTracksSweepOutcome := false

bool bslSwept = false
bool sslSwept = false
int zoneCount = array.size(zones)
if zoneCount > 0
    for zoneIndex = 0 to zoneCount - 1
        LiquidityZone zone = array.get(zones, zoneIndex)
        bool breached = mitigationMode == "Wick Sweep" ? (zone.isBsl ? high >= zone.level : low <= zone.level) : (zone.isBsl ? close > zone.level : close < zone.level)
        if zone.active and breached
            zone.active := false
            bslSwept := bslSwept or zone.isBsl
            sslSwept := sslSwept or not zone.isBsl
            if keepMitigated
                line.set_extend(zone.lineRef, extend.none)
                line.set_x2(zone.lineRef, bar_index)
                line.set_style(zone.lineRef, line.style_dashed)
                line.set_color(zone.lineRef, color.new(color.gray, 55))
            else
                line.delete(zone.lineRef)

if bslSwept
    totalLiquiditySweeps += 1
if sslSwept
    totalLiquiditySweeps += 1

bool recentSslSweep = ta.barssince(sslSwept) <= internalStructureWindow
bool recentBslSweep = ta.barssince(bslSwept) <= internalStructureWindow
bool internalBullishChoch = useInternalStructureSignals and recentSslSweep and bullishChoch
bool internalBearishChoch = useInternalStructureSignals and recentBslSweep and bearishChoch

if not na(pivotHigh)
    addOrStrengthenZone(pivotHigh, true, volume[rightBars] > volumeSma[rightBars] * highVolumeMultiplier)
    lastStructuralHigh := pivotHigh
    bearishObTop := high[rightBars]
    bearishObBottom := low[rightBars]
    bearishObActive := true
    float bearishObPower = not na(volumeSma[rightBars]) and volumeSma[rightBars] > 0 ? math.min(100.0, volume[rightBars] / volumeSma[rightBars] * 100) : 0.0
    addBearishOrderBlock(bearishObTop, bearishObBottom, bearishObPower, sellVolume[rightBars], totalVolume[rightBars], deltaVol[rightBars])
if not na(pivotLow)
    addOrStrengthenZone(pivotLow, false, volume[rightBars] > volumeSma[rightBars] * highVolumeMultiplier)
    lastStructuralLow := pivotLow
    bullishObTop := high[rightBars]
    bullishObBottom := low[rightBars]
    bullishObActive := true
    float bullishObPower = not na(volumeSma[rightBars]) and volumeSma[rightBars] > 0 ? math.min(100.0, volume[rightBars] / volumeSma[rightBars] * 100) : 0.0
    addBullishOrderBlock(bullishObTop, bullishObBottom, bullishObPower, buyVolume[rightBars], totalVolume[rightBars], deltaVol[rightBars])

bool isPotentialReversal = ta.barssince(sslSwept) <= 3 and volume > whaleVolumeAverage * 1.5 and deltaVol > 0
bool isPotentialBearishReversal = ta.barssince(bslSwept) <= 3 and volume > whaleVolumeAverage * 1.5 and deltaVol < 0

bool insideBullishOb = false
int bullishBlockCount = array.size(bullishObStack)
if bullishBlockCount > 0
    for blockIndex = 0 to bullishBlockCount - 1
        BullishOrderBlock block = array.get(bullishObStack, blockIndex)
        if block.active
            box.set_right(block.boxRef, bar_index)
            if bullishBlockInvalidated(block)
                block.active := false
                box.set_extend(block.boxRef, extend.none)
                box.set_bgcolor(block.boxRef, color.new(color.gray, 90))
                label.delete(block.labelRef)
                array.set(bullishObStack, blockIndex, block)
            else if low <= block.top and high >= block.bottom
                insideBullishOb := true
            if block.active
                label.set_x(block.labelRef, bar_index + 10)
                label.set_y(block.labelRef, block.bottom)
bool insideBearishOb = false
bool bearishObAbove = false
float bearishObCeiling = na
int bearishBlockCount = array.size(bearishObStack)
if bearishBlockCount > 0
    for blockIndex = 0 to bearishBlockCount - 1
        BearishOrderBlock block = array.get(bearishObStack, blockIndex)
        if block.active
            box.set_right(block.boxRef, bar_index)
            if bearishBlockInvalidated(block)
                block.active := false
                box.set_extend(block.boxRef, extend.none)
                box.set_bgcolor(block.boxRef, color.new(color.gray, 90))
                label.delete(block.labelRef)
                array.set(bearishObStack, blockIndex, block)
            else
                insideBearishOb := insideBearishOb or (high >= block.bottom and low <= block.top)
                bearishObAbove := bearishObAbove or block.bottom > close
                bearishObCeiling := na(bearishObCeiling) ? block.top : math.max(bearishObCeiling, block.top)
            if block.active
                label.set_x(block.labelRef, bar_index + 10)
                label.set_y(block.labelRef, block.top)
bool sellSideBiasLocked = bearishObAbove and not isPotentialReversal
bool is_wheel_buy = insideBullishOb and isWhaleBuyVolume and deltaPercent > 0 and totalVolume > totalVolumeSma and not isPotentialBearishReversal
bool is_wheel_sell = insideBearishOb and isWhaleSellVolume and deltaPercent < 0 and totalVolume > totalVolumeSma

bool volumeThresholdAlert = barstate.isconfirmed and institutionalVolumeSpike

float upperCorridorTolerance = not na(upper_corridor) ? upper_corridor * lineTouchTolerancePercent / 100.0 : na
float lowerCorridorTolerance = not na(lower_corridor) ? lower_corridor * lineTouchTolerancePercent / 100.0 : na
bool upperCorridorTouched = not na(upperCorridorTolerance) and high >= upper_corridor - upperCorridorTolerance and low <= upper_corridor + upperCorridorTolerance
bool lowerCorridorTouched = not na(lowerCorridorTolerance) and low <= lower_corridor + lowerCorridorTolerance and high >= lower_corridor - lowerCorridorTolerance
bool corridorTouchAlert = barstate.isconfirmed and (upperCorridorTouched or lowerCorridorTouched)
float reversalBaselineProbability = totalLiquiditySweeps > 0 ? successfulSweepReversals * 100.0 / totalLiquiditySweeps : 0.0
bool reversalAlignmentActive = isPotentialReversal or isPotentialBearishReversal
float deltaRatio = volume > 0 ? math.abs(deltaVol) / volume : 0.0
float reversalVolumeWeight = reversalAlignmentActive ? volume > totalVolumeSma * 2.0 ? 15.0 : volume > totalVolumeSma * 1.5 ? 10.0 : 0.0 : 0.0
float reversalDeltaWeight = reversalAlignmentActive ? deltaRatio > 0.35 ? 15.0 : deltaRatio > 0.20 ? 10.0 : 0.0 : 0.0
bool bullishH4ReversalConfluence = isPotentialReversal and not na(lower_corridor) and low <= lower_corridor
bool bearishH4ReversalConfluence = isPotentialBearishReversal and not na(upper_corridor) and high >= upper_corridor
float reversalH4Weight = bullishH4ReversalConfluence or bearishH4ReversalConfluence ? 15.0 : 0.0
float reversalProbability = math.min(99.0, math.max(0.0, reversalBaselineProbability + reversalVolumeWeight + reversalDeltaWeight + reversalH4Weight))
string reversalProbabilityText = str.tostring(math.round(reversalProbability)) + "%"
bool weakReversalSignal = reversalProbability < 50.0
bool highVolumeReversalSignal = totalVolume >= highVolumeReversalThreshold
string reversalStrengthText = weakReversalSignal ? highVolumeReversalSignal ? "HIGH VOL" : "WEAK" : "STRONG"
string bullishReversalLabelText = reversalProbabilityText + " " + reversalStrengthText + "\nBuy: " + compactVolume(buyVolume)
string bearishReversalLabelText = reversalProbabilityText + " " + reversalStrengthText + "\nSell: " + compactVolume(sellVolume)
color bullishReversalLabelColor = weakReversalSignal ? highVolumeReversalSignal ? color.blue : color.orange : color.teal
color bearishReversalLabelColor = weakReversalSignal ? highVolumeReversalSignal ? color.purple : color.gray : color.orange
bool reversalSignalStarted = (isPotentialReversal and not isPotentialReversal[1]) or (isPotentialBearishReversal and not isPotentialBearishReversal[1])
if barstate.isconfirmed and reversalSignalStarted
    lastSignalH4HighDist := pctDropFromHigh
    lastSignalH4LowDist := pctRiseFromLow
    lastSignalProbability := reversalProbability
    lastSignalBiasStr := reversalProbability > 55 ? "DIDELĖ TIKIMYBĖ" : reversalProbability < 40 ? "MAŽA TIKIMYBĖ" : "VIDUTINĖ TIKIMYBĖ"
    lastSignalDirectionStr := isPotentialBearishReversal ? " (BEAR REVERSAL)" : " (BULL REVERSAL)"
if isPotentialReversal
    float bullishReversalLabelOffset = labelCollisionOffset
    float bullishReversalLabelPrice = low - bullishReversalLabelOffset
    bool bullishReversalWouldOverlap = not na(lastStructureLabelPrice) and not na(lastStructureLabelBar) and bar_index - lastStructureLabelBar <= 10 and math.abs(bullishReversalLabelPrice - lastStructureLabelPrice) < bullishReversalLabelOffset
    if bullishReversalWouldOverlap
        bullishReversalLabelPrice := lastStructureLabelPrice - bullishReversalLabelOffset
    label.new(bar_index, bullishReversalLabelPrice, bullishReversalLabelText, style=label.style_label_up, color=bullishReversalLabelColor, textcolor=color.white, size=size.small)
    lastStructureLabelPrice := bullishReversalLabelPrice
    lastStructureLabelBar := bar_index
if isPotentialBearishReversal
    float bearishReversalLabelOffset = labelCollisionOffset
    float bearishReversalLabelPrice = high + bearishReversalLabelOffset
    bool bearishReversalWouldOverlap = not na(lastStructureLabelPrice) and not na(lastStructureLabelBar) and bar_index - lastStructureLabelBar <= 10 and math.abs(bearishReversalLabelPrice - lastStructureLabelPrice) < bearishReversalLabelOffset
    if bearishReversalWouldOverlap
        bearishReversalLabelPrice := lastStructureLabelPrice + bearishReversalLabelOffset
    label.new(bar_index, bearishReversalLabelPrice, bearishReversalLabelText, style=label.style_label_down, color=bearishReversalLabelColor, textcolor=color.white, size=size.small)
    lastStructureLabelPrice := bearishReversalLabelPrice
    lastStructureLabelBar := bar_index

bool wheelExecutionAlert = false
string wheelDashboardState = "NONE"

float buyVolumeAverage = ta.sma(ltf_buy_vol, absorptionSmaLength)
float sellVolumeAverage = ta.sma(ltf_sell_vol, absorptionSmaLength)
float candleBody = math.abs(close - open)
float averageCandleBody = ta.sma(candleBody, absorptionSmaLength)
bool absorptionAlert = barstate.isconfirmed and ltf_buy_vol > buyVolumeAverage * absorptionVolumeMultiplier and ltf_sell_vol > sellVolumeAverage * absorptionVolumeMultiplier and candleBody <= averageCandleBody
bool institutionalSweepMarker = showInstitutionalVolumeMarkers and institutionalVolumeSpike and (sslSwept or bslSwept or absorptionAlert)
plotshape(institutionalSweepMarker and deltaPercent >= 0, "Bullish institutional volume", shape.diamond, location.belowbar, color=color.new(bslColor, 0), size=size.tiny)
plotshape(institutionalSweepMarker and deltaPercent < 0, "Bearish institutional volume", shape.diamond, location.abovebar, color=color.new(sslColor, 0), size=size.tiny)

alertcondition(volumeThresholdAlert, "Relative institutional volume spike", "Volume exceeded the configured local SMA multiplier on {{ticker}}.")
alertcondition(corridorTouchAlert, "H4 corridor touch", "Price touched the H4 statistical corridor on {{ticker}}.")
alertcondition(absorptionAlert, "Volume spike and price absorption", "Concurrent buy/sell volume spike with price absorption detected on {{ticker}}.")
alertcondition(internalBullishChoch, "LTF bullish internal CHoCH", "Bullish internal structure shifted after a sell-side liquidity sweep on {{ticker}}.")
alertcondition(internalBearishChoch, "LTF bearish internal CHoCH", "Bearish internal structure shifted after a buy-side liquidity sweep on {{ticker}}.")
alertcondition(isPotentialReversal, "WHEEL Buy / Reversal Alignment", "Institutional bullish trend shift aligned after a sell-side liquidity sweep on {{ticker}}.")
alertcondition(isPotentialBearishReversal, "WHEEL Sell / Bearish Reversal Alignment", "Institutional top-side reversal confirmed by aggressive negative Delta after a high-volume buy-side liquidity sweep on {{ticker}}.")

bool bearishBos = not na(lastStructuralLow) and close < lastStructuralLow and close[1] >= lastStructuralLow
if bearishBos
    lastStructuralLow := na

// Equal levels outrank high-volume levels, which outrank normal pivots; distance resolves ties.
float forecastTarget = na
int bestPriority = -1
float bestDistance = na
bool bullishSweep = sslSwept and not bslSwept
bool bearishSweep = bslSwept and not sslSwept
bool freshWhaleBuy = insideBullishOb and isWhaleBuyVolume and deltaPercent > 0 and totalVolume > totalVolumeSma and not isPotentialBearishReversal
bool recentBullishMomentum = strongBullishClose or (deltaPercent[1] >= momentumDeltaThreshold and cmfValue[1] >= momentumCmfThreshold) or (deltaPercent[2] >= momentumDeltaThreshold and cmfValue[2] >= momentumCmfThreshold)
bool bullishSwingBreakout = not na(lastStructuralHigh) and close > lastStructuralHigh
bool bullishMomentumContext = freshWhaleBuy or recentBullishMomentum or bullishSwingBreakout
bool counterTrendBearSweep = useTrendMomentumFilter and bearishSweep and bullishMomentumContext
bool bullMetricsConfirm = deltaPercent > 0 or cmfValue > 0 or (cmfValue > cmfValue[1] and cmfValue[1] < 0)
bool bullSweepFailed = bullishSweep and ((deltaPercent <= negativeDeltaThreshold and cmfValue < 0) or (requireBullConfirmation and not bullMetricsConfirm))
bool reversalToBear = targetCancelled and cancelledTargetDirection == 1
bool reversalToBull = targetCancelled and cancelledTargetDirection == -1
bool needsUpsideTarget = (bullishSweep and not bullSweepFailed) or reversalToBull or counterTrendBearSweep
bool needsDownsideTarget = (bearishSweep and not counterTrendBearSweep) or bullSweepFailed or reversalToBear
string requestedTrend = needsUpsideTarget and not needsDownsideTarget ? "BULL" : needsDownsideTarget and not needsUpsideTarget ? "BEAR" : "NONE"
bool whaleSellEvent = insideBearishOb and isWhaleSellVolume and deltaPercent < 0 and totalVolume > totalVolumeSma
bool alertBullishMomentum = barstate.isconfirmed and counterTrendBearSweep
bool alertWhaleSell = barstate.isconfirmed and whaleSellEvent

// Only one forecast can be active. A fresh directional event replaces the prior forecast immediately.
if requestedTrend != "NONE" and targetActive
    supersededOriginBar := targetOriginBar
    array.push(supersededTargetBars, targetOriginBar)
    array.push(supersededTargetOutcomes, activeTrend == "BEAR" ? "SUPERCEDED -> BEARISH MOMENTUM" : "SUPERCEDED -> BULLISH MOMENTUM")
    if array.size(supersededTargetBars) > 20
        array.shift(supersededTargetBars)
        array.shift(supersededTargetOutcomes)
    line.delete(targetLine)
    targetLine := na
    label.delete(targetLabel)
    targetLabel := na
    targetActive := false
    activeTarget := na
    targetDirection := 0
    activeTrend := "NONE"
    targetInvalidationLevel := na
    targetTracksSweepOutcome := false

zoneCount := array.size(zones)
if requestedTrend != "NONE" and zoneCount > 0
    for zoneIndex = 0 to zoneCount - 1
        LiquidityZone zone = array.get(zones, zoneIndex)
        bool correctSide = requestedTrend == "BULL" ? zone.isBsl and zone.level > close : not zone.isBsl and zone.level < close
        if zone.active and correctSide
            int priority = zonePriority(zone)
            float distance = math.abs(zone.level - close)
            if priority > bestPriority or (priority == bestPriority and (na(bestDistance) or distance < bestDistance))
                bestPriority := priority
                bestDistance := distance
                forecastTarget := zone.level

float targetDistancePercent = not na(forecastTarget) ? math.abs(close - forecastTarget) / close * 100 : na
bool targetIsDistant = not na(forecastTarget) and (targetDistancePercent > maxTargetDistancePercent or (useAtrDistanceFilter and math.abs(close - forecastTarget) > atrValue * atrDistanceMultiplier))
if targetIsDistant
    forecastTarget := na

string barSignal = ""
if bullSweepFailed
    barSignal := "SWEEP FAILED -> CONTINUATION DOWN"
if reversalToBear
    barSignal := "REVERSAL"
if reversalToBull
    barSignal := "REVERSAL"
if needsUpsideTarget
    barSignal := counterTrendBearSweep ? "BULLISH MOMENTUM -> UPSIDE BIAS" : "SWEEP (Bull)"
    if reversalToBull
        barSignal := "REVERSAL"
    if not na(forecastTarget)
        barSignal += reversalToBull ? " -> BULL TGT: " + str.tostring(forecastTarget, format.mintick) : " -> BULL TARGET: " + str.tostring(forecastTarget, format.mintick)
        if not na(targetLine)
            line.delete(targetLine)
        label.delete(targetLabel)
        targetLine := line.new(bar_index, forecastTarget, bar_index + 1, forecastTarget, xloc=xloc.bar_index, extend=extend.right, color=color.yellow, width=2)
        targetLabel := label.new(bar_index + 10, forecastTarget, "BULL TARGET", xloc=xloc.bar_index, style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny)
        activeTarget := forecastTarget
        targetDirection := 1
        targetActive := true
        activeTrend := "BULL"
        targetOriginBar := bar_index
        targetOriginSignal := barSignal
        targetInvalidationLevel := low
        targetTracksSweepOutcome := true
    else
        barSignal += reversalToBull ? " -> BULL TGT DISTANT" : " -> TGT DISTANT"
if needsDownsideTarget
    barSignal := reversalToBear ? "REVERSAL" : bullSweepFailed ? "SWEEP FAILED -> CONTINUATION DOWN" : "SWEEP (Bear)"
    if not na(forecastTarget)
        barSignal += reversalToBear ? " -> BEAR TGT: " + str.tostring(forecastTarget, format.mintick) : " -> BEAR TARGET: " + str.tostring(forecastTarget, format.mintick)
        if not na(targetLine)
            line.delete(targetLine)
        label.delete(targetLabel)
        targetLine := line.new(bar_index, forecastTarget, bar_index + 1, forecastTarget, xloc=xloc.bar_index, extend=extend.right, color=color.yellow, width=2)
        targetLabel := label.new(bar_index + 10, forecastTarget, "BEAR TARGET", xloc=xloc.bar_index, style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny)
        activeTarget := forecastTarget
        targetDirection := -1
        targetActive := true
        activeTrend := "BEAR"
        targetOriginBar := bar_index
        targetOriginSignal := barSignal
        targetInvalidationLevel := high
        targetTracksSweepOutcome := true
    else
        barSignal += reversalToBear ? " -> BEAR TGT DISTANT" : " -> TGT DISTANT"

// Bearish BOS/CHoCH expansion targets the strongest available bullish institutional block below price.
bool bearishContinuation = bearishBos or bearishChoch
float continuationTarget = na
float bestObPower = -1.0
int bestObTouches = -1
float bestObDistance = na
bool bearishStructureLabelDrawn = false
if bearishContinuation
    bullishBlockCount := array.size(bullishObStack)
    if bullishBlockCount > 0
        for blockIndex = 0 to bullishBlockCount - 1
            BullishOrderBlock block = array.get(bullishObStack, blockIndex)
            bool validSupport = block.active and block.top < close
            float distance = close - block.top
            if validSupport and (block.power > bestObPower or (block.power == bestObPower and (block.touches > bestObTouches or (block.touches == bestObTouches and (na(bestObDistance) or distance < bestObDistance)))))
                bestObPower := block.power
                bestObTouches := block.touches
                bestObDistance := distance
                continuationTarget := block.top
    if not na(continuationTarget)
        if targetActive
            supersededOriginBar := targetOriginBar
            array.push(supersededTargetBars, targetOriginBar)
            array.push(supersededTargetOutcomes, "SUPERCEDED -> BEARISH MOMENTUM")
            if array.size(supersededTargetBars) > 20
                array.shift(supersededTargetBars)
                array.shift(supersededTargetOutcomes)
            line.delete(targetLine)
            label.delete(targetLabel)
        targetLine := line.new(bar_index, continuationTarget, bar_index + 1, continuationTarget, xloc=xloc.bar_index, extend=extend.right, color=color.yellow, width=2)
        targetLabel := label.new(bar_index + 10, continuationTarget, "BEAR TARGET: OB", xloc=xloc.bar_index, style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny)
        activeTarget := continuationTarget
        targetDirection := -1
        targetActive := true
        activeTrend := "BEAR"
        targetOriginBar := bar_index
        targetOriginSignal := (bearishBos ? "BOS CONFIRMED" : "CHoCH CONFIRMED") + " -> BEAR TGT: OB " + str.tostring(continuationTarget, format.mintick)
        targetInvalidationLevel := high
        targetTracksSweepOutcome := false
        barSignal := targetOriginSignal
        if showChochLabels
            float baseLabelOffset = labelCollisionOffset
            float labelOffset = isPotentialBearishReversal ? baseLabelOffset * 3.0 : baseLabelOffset
            float labelPrice = high + labelOffset
            bool labelWouldOverlap = not na(lastStructureLabelPrice) and not na(lastStructureLabelBar) and bar_index - lastStructureLabelBar <= 10 and math.abs(labelPrice - lastStructureLabelPrice) < labelOffset
            if labelWouldOverlap
                labelPrice := lastStructureLabelPrice + labelOffset
            string structureSignalName = bearishBos ? "Bear BOS" : "Bear CHoCH"
            structureSignalName := internalBearishChoch ? structureSignalName + " + LTF Bear CHoCH" : structureSignalName
            label.new(bar_index, labelPrice, structureLabelText(structureSignalName, totalVolume, deltaPercent), style=label.style_label_down, color=sslColor, textcolor=color.white, size=size.tiny)
            lastStructureLabelPrice := labelPrice
            lastStructureLabelBar := bar_index
            bearishStructureLabelDrawn := true

if internalBullishChoch
    barSignal := barSignal == "" ? "LTF BULL CHoCH -> EARLY ENTRY" : barSignal + " | LTF BULL CHoCH"
if internalBearishChoch
    barSignal := barSignal == "" ? "LTF BEAR CHoCH -> EARLY ENTRY" : barSignal + " | LTF BEAR CHoCH"
if showChochLabels and internalBullishChoch
    float bullChochLabelOffset = labelCollisionOffset
    float bullChochLabelPrice = low - bullChochLabelOffset
    bool bullChochWouldOverlap = not na(lastStructureLabelPrice) and not na(lastStructureLabelBar) and bar_index - lastStructureLabelBar <= 10 and math.abs(bullChochLabelPrice - lastStructureLabelPrice) < bullChochLabelOffset
    if bullChochWouldOverlap
        bullChochLabelPrice := lastStructureLabelPrice - bullChochLabelOffset
    label.new(bar_index, bullChochLabelPrice, structureLabelText("LTF Bull CHoCH", totalVolume, deltaPercent), style=label.style_label_up, color=bslColor, textcolor=color.white, size=size.tiny)
    lastStructureLabelPrice := bullChochLabelPrice
    lastStructureLabelBar := bar_index
if showChochLabels and internalBearishChoch and not bearishStructureLabelDrawn
    float bearChochLabelOffset = labelCollisionOffset
    float bearChochLabelPrice = high + bearChochLabelOffset
    bool bearChochWouldOverlap = not na(lastStructureLabelPrice) and not na(lastStructureLabelBar) and bar_index - lastStructureLabelBar <= 10 and math.abs(bearChochLabelPrice - lastStructureLabelPrice) < bearChochLabelOffset
    if bearChochWouldOverlap
        bearChochLabelPrice := lastStructureLabelPrice + bearChochLabelOffset
    label.new(bar_index, bearChochLabelPrice, structureLabelText("LTF Bear CHoCH", totalVolume, deltaPercent), style=label.style_label_down, color=sslColor, textcolor=color.white, size=size.tiny)
    lastStructureLabelPrice := bearChochLabelPrice
    lastStructureLabelBar := bar_index

var table infoPanel = table.new(position.bottom_right, 7, 11, frame_color=color.new(chart.fg_color, 60), frame_width=1, border_color=color.new(chart.fg_color, 80), border_width=1)
var table h4StatsPanel = table.new(position.top_right, 2, 4, frame_color=color.new(chart.fg_color, 60), frame_width=1, border_color=color.new(chart.fg_color, 80), border_width=1)
if targetActive and not na(targetLabel)
    label.set_x(targetLabel, bar_index + 10)
    label.set_y(targetLabel, activeTarget)
if barstate.islast or barstate.islastconfirmedhistory
    float displayedH4HighDist = na(lastSignalH4HighDist) ? pctDropFromHigh : lastSignalH4HighDist
    float displayedH4LowDist = na(lastSignalH4LowDist) ? pctRiseFromLow : lastSignalH4LowDist
    float displayedProbability = na(lastSignalProbability) ? reversalProbability : lastSignalProbability
    string displayedBias = na(lastSignalProbability) ? (displayedProbability > 55 ? "DIDELĖ TIKIMYBĖ" : displayedProbability < 40 ? "MAŽA TIKIMYBĖ" : "VIDUTINĖ TIKIMYBĖ") : lastSignalBiasStr
    string displayedDirection = na(lastSignalProbability) ? (isPotentialBearishReversal ? " (BEAR REVERSAL)" : isPotentialReversal ? " (BULL REVERSAL)" : "") : lastSignalDirectionStr
    bool highProbabilityReversal = displayedProbability > 75
    string probabilityText = str.tostring(displayedProbability, "#.##") + "% " + displayedBias + displayedDirection
    color probabilityBackground = highProbabilityReversal ? color.new(statCorridorColor, 0) : displayedProbability >= 50 ? color.new(color.teal, 55) : color.new(color.black, 25)
    table.cell(h4StatsPanel, 0, 0, "H4 Lygių Analizė", text_color=color.white, text_size=size.small, bgcolor=color.black)
    table.cell(h4StatsPanel, 1, 0, "Live", text_color=color.white, text_size=size.small, bgcolor=color.black)
    table.cell(h4StatsPanel, 0, 1, "Atstumas nuo H4 High", text_color=chart.fg_color, text_size=size.small, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 1, 1, na(displayedH4HighDist) ? "-" : str.tostring(displayedH4HighDist, "#.##") + "%", text_color=statCorridorColor, text_size=size.small, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 0, 2, "Atstumas nuo H4 Low", text_color=chart.fg_color, text_size=size.small, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 1, 2, na(displayedH4LowDist) ? "-" : str.tostring(displayedH4LowDist, "#.##") + "%", text_color=statCorridorColor, text_size=size.small, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 0, 3, "Apsisukimo tikimybė:", text_color=chart.fg_color, text_size=size.small, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 1, 3, probabilityText, text_color=highProbabilityReversal ? color.black : chart.fg_color, text_size=size.small, bgcolor=probabilityBackground)
    table.cell(infoPanel, 0, 0, "Bar", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), text_halign=text.align_center)
    table.cell(infoPanel, 1, 0, "BUY (V)", text_color=bslColor, text_size=size.tiny, bgcolor=color.new(color.black, 15), text_halign=text.align_center)
    table.cell(infoPanel, 2, 0, "SELL (V)", text_color=sslColor, text_size=size.tiny, bgcolor=color.new(color.black, 15), text_halign=text.align_center)
    table.cell(infoPanel, 3, 0, "TOTAL", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), text_halign=text.align_center)
    table.cell(infoPanel, 4, 0, "DELTA", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), text_halign=text.align_center)
    table.cell(infoPanel, 5, 0, "CMF", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), text_halign=text.align_center)
    table.cell(infoPanel, 6, 0, "SIGNAL / BIAS", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=30, text_halign=text.align_center)
    for candleIndex = 0 to 9
        int row = candleIndex + 1
        bool hasCandle = not na(close[candleIndex])
        int candleBar = bar_index - candleIndex
        float candleBuy = buyVolume[candleIndex]
        float candleSell = sellVolume[candleIndex]
        float candleTotal = totalVolume[candleIndex]
        float candleDelta = deltaPercent[candleIndex]
        float candleCmf = cmfValue[candleIndex]
        bool isRedCandle = close[candleIndex] < open[candleIndex]
        bool isGreenCandle = close[candleIndex] > open[candleIndex]
        bool candleInsideBullishOb = insideBullishOb[candleIndex]
        bool candleInsideBearishOb = insideBearishOb[candleIndex]
        bool candleBearishObAbove = bearishObAbove[candleIndex]
        bool candlePotentialReversal = hasCandle and isPotentialReversal[candleIndex]
        bool candlePotentialBearishReversal = hasCandle and isPotentialBearishReversal[candleIndex]
        bool candleInternalBullishChoch = hasCandle and internalBullishChoch[candleIndex]
        bool candleInternalBearishChoch = hasCandle and internalBearishChoch[candleIndex]
        bool candleInstitutionalVolumeSpike = hasCandle and institutionalVolumeSpike[candleIndex]
        float candleReversalProbability = reversalProbability[candleIndex]
        // The resistance cap is live-state only; never retroactively replace C2-C10 history.
        bool candleSellSideBiasLocked = candleIndex == 0 and sellSideBiasLocked
        float candleBearishObPrice = bearishObBottom[candleIndex]
        bool whaleBuy = hasCandle and not candleSellSideBiasLocked and candleInsideBullishOb and isWhaleBuyVolume[candleIndex] and candleDelta > 0 and candleTotal > totalVolumeSma[candleIndex]
        bool whaleSell = hasCandle and candleInsideBearishOb and isWhaleSellVolume[candleIndex] and candleDelta < 0 and candleTotal > totalVolumeSma[candleIndex]
        bool bullishObTestingWaiting = hasCandle and not candleSellSideBiasLocked and candleInsideBullishOb and candleDelta <= 0
        bool bearishObTestingWaiting = hasCandle and candleInsideBearishOb and candleDelta >= 0
        bool absorptionBuy = hasCandle and isRedCandle and candleDelta > 0 and candleCmf < 0.02 and buyRatio[candleIndex] <= 0.40 and isVolumeClimax[candleIndex]
        bool absorptionSell = hasCandle and isGreenCandle and candleDelta < 0 and candleCmf > -0.02 and buyRatio[candleIndex] >= 0.60 and isVolumeClimax[candleIndex]
        string liquiditySignal = hasCandle ? barSignal[candleIndex] : ""
        string internalStructureText = candleInternalBullishChoch ? "LTF BULL CHoCH" : candleInternalBearishChoch ? "LTF BEAR CHoCH" : ""
        string whaleBuyText = whaleBuy ? candleBearishObAbove ? "WHALE BUY -> TGT: BEAR OB " + str.tostring(candleBearishObPrice, format.mintick) : "WHALE BUY" : ""
        string signalText = candlePotentialBearishReversal ? "🔄 BEARISH REVERSAL (Prob: " + str.tostring(candleReversalProbability, "#.##") + "%)" + (internalStructureText != "" ? " | " + internalStructureText : "") : candlePotentialReversal ? "🔄 REVERSAL ALIGNMENT (Prob: " + str.tostring(candleReversalProbability, "#.##") + "%)" + (internalStructureText != "" ? " | " + internalStructureText : "") : candleSellSideBiasLocked ? "SELL-SIDE BIAS / BEAR OB CAP" : liquiditySignal != "" ? liquiditySignal : internalStructureText != "" ? internalStructureText + " -> EARLY ENTRY" : whaleBuy ? whaleBuyText : whaleSell ? "WHALE SELL" : bullishObTestingWaiting ? "🐂 BULL OB TEST / AWAITING DELTA" : bearishObTestingWaiting ? "🐻 BEAR OB TEST / AWAITING DELTA" : candleInstitutionalVolumeSpike ? "INSTITUTIONAL VOLUME SPIKE" : absorptionBuy ? "AbBuyV" : absorptionSell ? "AbSellV" : ""
        string lockedTargetSignal = ""
        int lockedTargetCount = array.size(lockedTargetBars)
        if lockedTargetCount > 0
            for lockedIndex = 0 to lockedTargetCount - 1
                if candleBar == array.get(lockedTargetBars, lockedIndex)
                    lockedTargetSignal := array.get(lockedTargetSignals, lockedIndex)
        bool isTargetHitRow = lockedTargetSignal != ""
        string supersededTargetOutcome = ""
        int supersededTargetCount = array.size(supersededTargetBars)
        if supersededTargetCount > 0
            for supersededIndex = 0 to supersededTargetCount - 1
                if candleBar == array.get(supersededTargetBars, supersededIndex)
                    supersededTargetOutcome := array.get(supersededTargetOutcomes, supersededIndex)
        bool isTargetCancelledRow = candleBar == cancelledOriginBar
        bool isTargetSupersededRow = supersededTargetOutcome != ""
        bool isObReachedRow = candleBar == obReachedOriginBar
        if not candlePotentialReversal and not candlePotentialBearishReversal
            if isTargetHitRow
                signalText := lockedTargetSignal + " -> TARGET HIT -> LOCKED"
            if isTargetCancelledRow
                signalText := "REVERSAL / TGT CANCELLED"
            if isTargetSupersededRow
                signalText := supersededTargetOutcome
            if isObReachedRow
                signalText := "OB REACHED -> WAITING FOR CONFIRMATION"
        if candleIndex == 0
            wheelDashboardState := str.contains(signalText, "WHALE BUY") ? "BUY" : str.contains(signalText, "WHALE SELL") ? "SELL" : "NONE"
        color deltaColor = candleDelta >= 0 ? bslColor : sslColor
        color cmfColor = candleCmf >= 0 ? bslColor : sslColor
        bool reversalSignal = str.contains(signalText, "REVERSAL")
        bool bullishReversal = reversalSignal and (str.contains(signalText, "BULL") or candleDelta >= momentumDeltaThreshold)
        bool bearishReversal = reversalSignal and (str.contains(signalText, "BEAR") or candleDelta <= -momentumDeltaThreshold)
        bool bullishSignal = str.contains(signalText, "BULLISH MOMENTUM") or str.contains(signalText, "UPSIDE BIAS") or str.contains(signalText, "BULL TARGET") or str.contains(signalText, "WHALE BUY")
        bool bearishSignal = str.contains(signalText, "BEAR TARGET") or str.contains(signalText, "CONTINUATION DOWN") or str.contains(signalText, "WHALE SELL")
        color signalBackground = candlePotentialBearishReversal ? color.new(color.orange, 40) : candlePotentialReversal ? color.new(color.teal, 50) : isTargetHitRow ? color.new(color.blue, 20) : isTargetCancelledRow ? color.new(color.orange, 20) : isTargetSupersededRow ? color.rgb(45, 48, 52) : isObReachedRow ? color.new(bslColor, 35) : bullishObTestingWaiting ? color.new(color.teal, 65) : bearishObTestingWaiting ? color.new(color.orange, 65) : bullishReversal ? color.new(#00e676, 72) : bearishReversal ? color.new(color.red, 85) : signalText == "" ? color.new(color.black, 25) : bullishSignal ? color.new(#00e676, 72) : bearishSignal ? color.new(color.red, 85) : color.new(color.black, 25)
        string buyText = hasCandle ? compactVolume(candleBuy) : "-"
        string sellText = hasCandle ? compactVolume(candleSell) : "-"
        string totalText = hasCandle ? compactVolume(candleTotal) : "-"
        string deltaText = hasCandle ? str.tostring(candleDelta, "#.#") + "%" : "-"
        string cmfText = hasCandle ? str.tostring(candleCmf, "#.####") : "-"
        table.cell(infoPanel, 0, row, hasCandle ? "C" + str.tostring(candleIndex + 1) : "-", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25), text_halign=text.align_center)
        table.cell(infoPanel, 1, row, buyText, text_color=bslColor, text_size=size.tiny, bgcolor=color.new(color.black, 25), text_halign=text.align_center)
        table.cell(infoPanel, 2, row, sellText, text_color=sslColor, text_size=size.tiny, bgcolor=color.new(color.black, 25), text_halign=text.align_center)
        table.cell(infoPanel, 3, row, totalText, text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25), text_halign=text.align_center)
        table.cell(infoPanel, 4, row, deltaText, text_color=deltaColor, text_size=size.tiny, bgcolor=color.new(color.black, 25), text_halign=text.align_center)
        table.cell(infoPanel, 5, row, cmfText, text_color=cmfColor, text_size=size.tiny, bgcolor=color.new(color.black, 25), text_halign=text.align_center)
        table.cell(infoPanel, 6, row, signalText, text_color=chart.fg_color, text_size=size.tiny, bgcolor=signalBackground, width=30, text_halign=text.align_center)

    wheelExecutionAlert := barstate.isconfirmed and wheelDashboardState != "NONE"
    if wheelExecutionAlert
        alert(syminfo.ticker + " (" + timeframe.period + ") - WHEEL " + wheelDashboardState + " CONFIRMED BY DASHBOARD at " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

alertcondition(wheelExecutionAlert, "WHEEL execution", "WHEEL buy or sell execution confirmed by the dashboard on {{ticker}}.")

if alertBullishMomentum
    alert(syminfo.ticker + " (" + timeframe.period + ") - BULLISH MOMENTUM Detected at price " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

if alertWhaleSell
    alert(syminfo.ticker + " (" + timeframe.period + ") - WARNING: WHALE SELL Event Confirmed at price " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

if historicalHighZoneHit and array.size(historicalSweepsHigh) > 0
    alert("🎯 BTC/ETH STATS ALERT: Price hit the Historic Reversal Zone above H4 High! Target Price: " + str.tostring(close, format.mintick) + ". Current deviation matches the historical average of " + str.tostring(avgHighSweepPercent, "#.##") + "%.", alert.freq_once_per_bar)

if historicalLowZoneHit and array.size(historicalSweepsLow) > 0
    alert("🎯 BTC/ETH STATS ALERT: Price hit the Historic Reversal Zone below H4 Low! Target Price: " + str.tostring(close, format.mintick) + ". Current deviation matches the historical average of " + str.tostring(avgLowSweepPercent, "#.##") + "%.", alert.freq_once_per_bar)

if confirmedH4Reversal
    float historicalAverage = confirmedReversalType == "High" ? avgHighSweepPercent : avgLowSweepPercent
    alert("REVERSAL CONFIRMED | Type: " + confirmedReversalType + " | Peak Penetration: " + str.tostring(maxPenetration, "#.##") + "% | Historic Average for this Asset: " + str.tostring(historicalAverage, "#.##") + "%", alert.freq_once_per_bar_close)