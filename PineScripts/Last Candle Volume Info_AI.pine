showReversalFailureTable = input.bool(false, "Show invalidated Order Block failure table", group="Data / Analysis")

type LiquidityZone
    float level
    bool isBsl
    int touches
    bool highVolume
    bool active
    line lineRef

type BullishOrderBlock
    float top
    float bottom
    float power
    float buyVolume
    float totalVolume
    float deltaVolume
    int touches
    bool active
    bool reversalLabelPrinted
    box boxRef
    label labelRef

type BearishOrderBlock
    float top
    float bottom
    float power
    float sellVolume
    float totalVolume
    float deltaVolume
    int touches
    bool active
    bool reversalLabelPrinted
    box boxRef
    label labelRef

