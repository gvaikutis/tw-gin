bool bearishObTouchReversalSetup = bearishObTouchCandidate and isRed and close < close[1] and bearishCloseNearRangeBottom and visibleUpperObTouchWick and deltaVol < 0
bool obTouchReversalSetup = bullishObTouchReversalSetup or bearishObTouchReversalSetup
bool bullishExhaustionSetup = exhaustionTimeframe and exhaustionCooldownComplete and (insideBullishOb or recentSslSweepForExhaustion) and longLowerWick and isGreen and exhaustionVolumeDrop and deltaVol > 0
bool bearishExhaustionSetup = exhaustionTimeframe and exhaustionCooldownComplete and (insideBearishOb or recentBslSweepForExhaustion) and longUpperWick and isRed and exhaustionVolumeDrop and deltaVol < 0
