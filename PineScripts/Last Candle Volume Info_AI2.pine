float distanceToBullPct = not na(bullLevelPrice) and close != 0 ? (close - bullLevelPrice) / close * 100.0 : na
string bearDistStr = not na(distanceToBearPct) ? "BEAR: +" + str.tostring(distanceToBearPct, "#.0") + "%" : "BEAR: NONE"
string bullDistStr = not na(distanceToBullPct) ? "BULL: -" + str.tostring(distanceToBullPct, "#.0") + "%" : "BULL: NONE"

