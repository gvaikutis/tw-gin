bool exhaustionTimeframe = (timeframe.isminutes and timeframe.multiplier >= 240) or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
bool longLowerWick = lowerWickPct >= 55.0
bool longUpperWick = upperWickPct >= 55.0
bool exhaustionVolumeDrop = totalVolumeUsdt < totalVolumeSma * 0.85
bool exhaustionCooldownComplete = na(lastExhaustionLabelBar) or bar_index - lastExhaustionLabelBar > 5
