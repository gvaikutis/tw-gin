float reversalBaselineProbability = obTouchReversalSetup ? 40.0 : sweepOrExhaustionProbabilitySetup ? totalLiquiditySweeps > 0 ? successfulSweepReversals * 100.0 / totalLiquiditySweeps : 45.0 : 0.0
