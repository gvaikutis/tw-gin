bool liveBearishCvdDivergence = not na(priorLiveCvdPriceHigh) and not na(priorLiveCvdHigh) and close > priorLiveCvdPriceHigh and cvd < priorLiveCvdHigh
bool liveBullishCvdDivergencePulse = liveBullishCvdDivergence and not liveBullishCvdDivergence[1]
bool liveBearishCvdDivergencePulse = liveBearishCvdDivergence and not liveBearishCvdDivergence[1]
isPotentialReversal := isPotentialReversal or liveBullishCvdDivergence
isPotentialBearishReversal := isPotentialBearishReversal or liveBearishCvdDivergence
