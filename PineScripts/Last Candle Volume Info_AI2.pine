type LiquidityZone
    float level
    bool isBsl
    int touches
    bool highVolume
    bool active
    line lineRef

type BullishOrderBlock
    float top
    float bottom
    float power
    float buyVolume
    float totalVolume
    float deltaVolume
    int touches
    bool active
    bool reversalLabelPrinted
    bool wasTouched
    box boxRef
    label labelRef

type BearishOrderBlock
    float top
    float bottom
    float power
    float sellVolume
    float totalVolume
    float deltaVolume
    int touches
    bool active
    bool reversalLabelPrinted
    bool wasTouched
    box boxRef
    label labelRef

f_evaluateCandleAnatomy() =>
    float cRange = high - low
    float cBody = math.abs(close - open)
    float upperWick = high - math.max(open, close)
    float lowerWick = math.min(open, close) - low
    float bodyPct = cRange > 0 ? cBody / cRange * 100.0 : 0.0
    float upperWickPct = cRange > 0 ? upperWick / cRange * 100.0 : 0.0
    float lowerWickPct = cRange > 0 ? lowerWick / cRange * 100.0 : 0.0
    float closePosPct = cRange > 0 ? (close - low) / cRange * 100.0 : 0.0
    bool isGreen = close >= open
    bool isRed = close < open
    [cRange, cBody, upperWick, lowerWick, bodyPct, upperWickPct, lowerWickPct, closePosPct, isGreen, isRed]

f_resolveVolumeAccumulation(bool accumulationCandidate, float buyVolumeValue, float sellVolumeValue, float currentClose, float fastTrendEma, float previousHigh) =>
    float totalVolumeValue = math.max(1.0, buyVolumeValue + sellVolumeValue)
    float deltaDominance = math.abs(buyVolumeValue - sellVolumeValue) / totalVolumeValue * 100.0
    bool aggressiveUpwardExpansion = currentClose > fastTrendEma and currentClose > previousHigh
    bool accumulationEligible = accumulationCandidate and buyVolumeValue > sellVolumeValue and deltaDominance >= 15.0 and not aggressiveUpwardExpansion
    string accumulationStrength = deltaDominance >= 35.0 ? "STRONG" : deltaDominance >= 20.0 ? "MED" : "WEAK"
    [accumulationEligible, accumulationStrength, deltaDominance]

f_getMarketStructureSignal(bool bearishBos, bool isBullChochActiveInWindow, bool isBearChochActiveInWindow, bool internalBullishChoch, bool internalBearishChoch, bool freshBullishOrderBlock, bool freshBearishOrderBlock, bool bullishObTest, bool bearishObTest, bool bullishObInvalidated, bool bearishObInvalidated, bool institutionalVolumeSpike, bool heavySellingPressure, bool isGreenCandle, bool isRedCandle, float bodyPercent, float currentDeltaVol, float currentVolume, float averageVolume) =>
    bool hasVolumeAverage = not na(averageVolume) and averageVolume > 0
    bool lowVolume = hasVolumeAverage and currentVolume < averageVolume
    bool institutionalBullishOb = freshBullishOrderBlock and institutionalVolumeSpike and currentDeltaVol > 0 and not bullishObInvalidated
    bool institutionalBearishOb = freshBearishOrderBlock and institutionalVolumeSpike and currentDeltaVol < 0 and not bearishObInvalidated
    bool institutionalCrashProfile = heavySellingPressure and isRedCandle and bodyPercent >= 50.0
    // Use the 5-bar structural-break memory latch instead of a raw single-bar Choch flag, so a
    // breakout candle and its later OB/volume confirmation no longer need to share a bar index.
    bool buyStrong = isBullChochActiveInWindow and institutionalBullishOb
    bool buyMedium = internalBullishChoch or (bullishObTest and currentDeltaVol > 0 and not bullishObInvalidated)
    bool buyWeak = isGreenCandle and lowVolume and bodyPercent < 50.0
    bool sellStrong = ((bearishBos or isBearChochActiveInWindow) and institutionalBearishOb and heavySellingPressure) or institutionalCrashProfile
    bool sellMedium = internalBearishChoch or (bearishObTest and currentDeltaVol < 0 and not bearishObInvalidated) or bullishObInvalidated
    bool sellWeak = isRedCandle and lowVolume and bodyPercent < 50.0
    string marketStructureSignal = "NEUTRAL"
    if sellStrong
        marketStructureSignal := "SELL_STRONG"
    else if buyStrong
        marketStructureSignal := "BUY_STRONG"
    else if sellMedium
        marketStructureSignal := "SELL_MEDIUM"
    else if buyMedium
        marketStructureSignal := "BUY_MEDIUM"
    else if sellWeak
        marketStructureSignal := "SELL_WEAK"
    else if buyWeak
        marketStructureSignal := "BUY_WEAK"
    marketStructureSignal

f_resolveSqueezeStatus(bool institutionalVolumeSpike, bool extremeDeltaVolumeClimax, float currentDeltaVol, bool confirmedBullishCvdDivergence, bool confirmedBearishCvdDivergence, bool htfBullish, bool htfBearish, bool bullishPriceRejection, bool bearishPriceRejection, float currentVolumeUsdt, bool matrixInstitutionalHandover, int matrixHandoverDirection, bool bullishVelocityNoiseGate, bool bearishPeakValidated, float highPurgeThreshold, bool aggressiveUpwardExpansion) =>
    bool highVolumeInstitutionalPurge = currentVolumeUsdt >= highPurgeThreshold
    bool immediateInstitutionalOverride = institutionalVolumeSpike or extremeDeltaVolumeClimax
    bool bullishCvdInterception = confirmedBullishCvdDivergence and htfBearish and (currentDeltaVol > 0 or bullishPriceRejection)
    bool bearishCvdInterception = confirmedBearishCvdDivergence and htfBullish and (currentDeltaVol < 0 or bearishPriceRejection)
    bool bearishEventAllowed = not bullishVelocityNoiseGate or bearishPeakValidated
    string resolvedStatus = "NEUTRAL"
    if highVolumeInstitutionalPurge and bearishEventAllowed
        resolvedStatus := "INSTITUTIONAL_PURGE"
    else if matrixInstitutionalHandover
        resolvedStatus := matrixHandoverDirection == -1 ? "INSTITUTIONAL_PURGE" : "INSTITUTIONAL_ACCUMULATION"
    else if bearishCvdInterception and bearishEventAllowed
        resolvedStatus := "INSTITUTIONAL_PURGE"
    else if bullishCvdInterception
        resolvedStatus := "INSTITUTIONAL_ACCUMULATION"
    else if immediateInstitutionalOverride
        if currentDeltaVol > 0
            resolvedStatus := aggressiveUpwardExpansion ? "TRUE_BULL_REVERSAL" : "INSTITUTIONAL_ACCUMULATION"
        else if bearishEventAllowed
            resolvedStatus := "INSTITUTIONAL_PURGE"
    resolvedStatus

f_formatDashboardSignal(string squeezeStatus, string structuralLabel, string marketVerdict, string consolidationBias) =>
    string squeezeSignal = ""
    bool isInstitutionalAccumulation = squeezeStatus == "INSTITUTIONAL_ACCUMULATION"
    bool isInstitutionalPurge = squeezeStatus == "INSTITUTIONAL_PURGE"
    bool isTrueBullReversal = squeezeStatus == "TRUE_BULL_REVERSAL"
    bool isBearishObWait = structuralLabel == "OB TEST (S)" and marketVerdict == "SELL_WEAK"
    bool isLiveCvdReversal = structuralLabel == "BULL REV (CVD)" or structuralLabel == "BEAR REV (CVD)"

    if isInstitutionalPurge
        squeezeSignal := "LSQ PURGE"
    else if isInstitutionalAccumulation
        squeezeSignal := "LSQ ACTIVE"
    else if isTrueBullReversal
        squeezeSignal := "LSQ BULL REV"

    bool isDominantSqueezeSignal = isInstitutionalPurge or isInstitutionalAccumulation or isTrueBullReversal

    array<string> mergedParts = array.new_string()
    if squeezeSignal != "" and squeezeSignal != "NEUTRAL"
        array.push(mergedParts, squeezeSignal)
    if structuralLabel != "" and structuralLabel != "NEUTRAL"
        string cleanLabel = structuralLabel
        if isBtcAsset and (str.contains(cleanLabel, "ALT WEAK") or str.contains(cleanLabel, "ALT STRONG") or str.contains(cleanLabel, "BTC RISING") or str.contains(cleanLabel, "BTC FALLING"))
            cleanLabel := ""
        else if isBearishObWait
            cleanLabel := "WAIT Δ (S)"
        if cleanLabel != ""
            array.push(mergedParts, cleanLabel)
    string compactMarketVerdict = marketVerdict == "SELL_STRONG" ? "STRONG S" : marketVerdict == "SELL_MEDIUM" ? "MED S" : marketVerdict == "SELL_WEAK" ? "WEAK BIAS" : marketVerdict == "BUY_STRONG" ? "STRONG B" : marketVerdict == "BUY_MEDIUM" ? "MED B" : marketVerdict == "BUY_WEAK" ? "WEAK B" : marketVerdict
    if compactMarketVerdict != "" and compactMarketVerdict != "NEUTRAL" and not isBearishObWait
        array.push(mergedParts, compactMarketVerdict)
    if consolidationBias != "" and consolidationBias != "NEUTRAL"
        array.push(mergedParts, consolidationBias)

    string finalSignal = ""
    int mergedSize = array.size(mergedParts)
    if mergedSize > 0
        for i = 0 to mergedSize - 1
            string part = array.get(mergedParts, i)
            bool isDuplicate = false
            if i > 0
                for j = 0 to i - 1
                    if part == array.get(mergedParts, j)
                        isDuplicate := true
            if not isDuplicate
                finalSignal := finalSignal == "" ? part : finalSignal + " | " + part

    bool isNeutralConsolidation = str.contains(consolidationBias, "CONSOL (NEUT)")
    bool isRobWeakConsolidation = str.contains(structuralLabel, "ROB") and marketVerdict == "SELL_WEAK" and str.contains(consolidationBias, "CONSOL")
    bool isShortTestNeutralConsolidation = structuralLabel == "OB TEST (S)" and isNeutralConsolidation
    bool isCancelledStrongSell = structuralLabel == "REV CANCEL" and marketVerdict == "SELL_STRONG"
    if isDominantSqueezeSignal
        finalSignal := squeezeSignal
    else if isLiveCvdReversal
        finalSignal := structuralLabel
    else if isRobWeakConsolidation
        finalSignal := "ROB / WEAK BIAS"
    else if isShortTestNeutralConsolidation
        finalSignal := "IT (S) / NEUT"
    else if isCancelledStrongSell
        finalSignal := "REV CANCEL (S)"
    finalSignal == "" ? "NEUTRAL" : finalSignal

