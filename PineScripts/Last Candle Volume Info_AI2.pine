bool recentBslSweepForExhaustion = ta.barssince(bslSwept) <= 3
bool visibleLowerObTouchWick = lowerWickPct >= 45.0
bool visibleUpperObTouchWick = upperWickPct >= 45.0
bool bullishCloseNearRangeTop = candleRange > 0 and closePosPct > 60.0
bool bearishCloseNearRangeBottom = candleRange > 0 and closePosPct < 40.0
