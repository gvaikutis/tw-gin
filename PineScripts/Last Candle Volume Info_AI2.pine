bool bearishProbabilityLabel = isPotentialBearishReversal or (bearishExhaustionSetup or bearishObTouchReversalSetup) or heavySellingPressure
bool exhaustionReversalSetup = (bullishExhaustionSetup or bearishExhaustionSetup) and not obTouchReversalSetup
