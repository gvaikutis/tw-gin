toleranceAt(float price) => price * tolerancePercent / 100.0

compactVolume(float value) =>
    float absoluteValue = math.abs(value)
    absoluteValue >= 1000000 ? str.tostring(value / 1000000, "#") + "M" : absoluteValue >= 1000 ? str.tostring(value / 1000, "#") + "K" : str.tostring(value, "#")

compactUsdt(float value) =>
    float absoluteValue = math.abs(value)
    absoluteValue >= 1000000000 ? str.tostring(value / 1000000000, "#") + "B" : absoluteValue >= 1000000 ? str.tostring(value / 1000000, "#") + "M" : absoluteValue >= 1000 ? str.tostring(value / 1000, "#") + "K" : str.tostring(value, "#")

compactDashboardUsdt(float value) =>
    float absoluteValue = math.abs(value)
    absoluteValue >= 1000000000 ? str.tostring(value / 1000000000, "#.0") + "B" : absoluteValue >= 1000000 ? str.tostring(value / 1000000, "#.0") + "M" : absoluteValue >= 1000 ? str.tostring(value / 1000, "#.0") + "K" : str.tostring(value, "#.0")

f_mergeChartTexts(string structureName, string probabilityText, string currentProbabilityText, float buyVolUsdt, float sellVolUsdt, bool isPivotLow, bool isPivotHigh, bool isSweep, bool isVolumeAccumulation, string volumeAccumulationStrength) =>
    string line1 = structureName
    bool isVolumeAccumulationFallback = false
    if line1 == "" or line1 == "NEUTRAL" or line1 == "-"
        if isPivotLow
            line1 := "PIV L"
        else if isPivotHigh
            line1 := "PIV H"
        else if isSweep
            line1 := "⚡ SWEEP"
        else
            isVolumeAccumulationFallback := isVolumeAccumulation
            line1 := isVolumeAccumulation ? "VOL ACC " + volumeAccumulationStrength : ""
    string line2 = probabilityText != "" and probabilityText != "NEUTRAL" and probabilityText != "-" ? probabilityText : currentProbabilityText
    string probabilityToken = str.contains(line2, "%") ? array.get(str.split(line2, " "), 0) : line2
    if isVolumeAccumulationFallback and str.contains(line2, "%")
        line2 := probabilityToken + " " + volumeAccumulationStrength
    else if str.contains(line2, "BEAR REVERSAL") or str.contains(line2, "BEAR REV")
        line2 := probabilityToken + " BEAR REV"
    else if str.contains(line2, "BULL REVERSAL") or str.contains(line2, "BULL REV")
        line2 := probabilityToken + " BULL REV"
    else if isSweep and str.contains(line2, "%")
        line2 := probabilityToken + " SWEEP"
    string line3 = "B: $" + compactUsdt(buyVolUsdt)
    string line4 = "S: $" + compactUsdt(sellVolUsdt)
    string labelText = ""
    if line1 != ""
        labelText := line1
    if line2 != ""
        labelText := labelText == "" ? line2 : labelText + "\n" + line2
    labelText := labelText == "" ? line3 : labelText + "\n" + line3
    labelText := labelText + "\n" + line4
    labelText

var string globalBarStructureText = ""
var string globalBarProbabilityText = ""

obMergeDistance(float referencePrice) =>
    float percentDistance = referencePrice * obMergePercent / 100.0
    useAtrObMerge ? math.max(percentDistance, atrValue * obMergeAtrMultiplier) : percentDistance

obRangesAreNear(float firstTop, float firstBottom, float secondTop, float secondBottom) =>
    float referencePrice = math.max(math.max(firstTop, firstBottom), math.max(secondTop, secondBottom))
    float mergeDistance = obMergeDistance(referencePrice)
    bool newTopInsideExisting = secondTop <= firstTop + mergeDistance and secondTop >= firstBottom - mergeDistance
    bool newBottomInsideExisting = secondBottom <= firstTop + mergeDistance and secondBottom >= firstBottom - mergeDistance
    bool existingTopInsideNew = firstTop <= secondTop + mergeDistance and firstTop >= secondBottom - mergeDistance
    bool existingBottomInsideNew = firstBottom <= secondTop + mergeDistance and firstBottom >= secondBottom - mergeDistance
    newTopInsideExisting or newBottomInsideExisting or existingTopInsideNew or existingBottomInsideNew

bullishBlockInvalidated(BullishOrderBlock block, float currentDeltaPercent, float currentRelativeVolume, float cumulativeDeltaPercent) => close < block.bottom and ((currentDeltaPercent < -25.0 and not na(currentRelativeVolume) and currentRelativeVolume > 1.5) or (not na(cumulativeDeltaPercent) and cumulativeDeltaPercent < -40.0))

bearishBlockInvalidated(BearishOrderBlock block, float currentDeltaPercent, float currentRelativeVolume, float cumulativeDeltaPercent) => close > block.top and ((currentDeltaPercent > 25.0 and not na(currentRelativeVolume) and currentRelativeVolume > 1.5) or (not na(cumulativeDeltaPercent) and cumulativeDeltaPercent > 40.0))

addBullishOrderBlock(float obTop, float obBottom, float obPower, float obBuyVolume, float obTotalVolume, float obDeltaVolume) =>
    if barstate.isconfirmed
        bool matched = false
        int blockCount = array.size(bullishObStack)
        if blockCount > 0
            for blockIndex = 0 to blockCount - 1
                BullishOrderBlock block = array.get(bullishObStack, blockIndex)
                if block.active and obRangesAreNear(block.top, block.bottom, obTop, obBottom)
                    block.touches += 1
                    block.power := math.min(100.0, block.power + obPower)
                    block.buyVolume += obBuyVolume
                    block.totalVolume += obTotalVolume
                    block.deltaVolume += obDeltaVolume
                    block.top := math.max(block.top, obTop)
                    block.bottom := math.min(block.bottom, obBottom)
                    box.set_top(block.boxRef, block.top)
                    box.set_bottom(block.boxRef, block.bottom)
                    array.set(bullishObStack, blockIndex, block)
                    matched := true
                    break
        if not matched
            box newBox = box.new(bar_index - rightBars, obTop, bar_index, obBottom, xloc=xloc.bar_index, extend=extend.right, border_color=color.new(bslColor, 25), border_width=1, bgcolor=color.new(bslColor, 85))
            array.push(bullishObStack, BullishOrderBlock.new(obTop, obBottom, obPower, obBuyVolume, obTotalVolume, obDeltaVolume, 1, true, false, false, newBox, na))
        if array.size(bullishObStack) > 5
            BullishOrderBlock oldestBlock = array.shift(bullishObStack)
            if not na(oldestBlock.boxRef)
                box.delete(oldestBlock.boxRef)

addBearishOrderBlock(float obTop, float obBottom, float obPower, float obSellVolume, float obTotalVolume, float obDeltaVolume) =>
    if barstate.isconfirmed
        bool matched = false
        int blockCount = array.size(bearishObStack)
        if blockCount > 0
            for blockIndex = 0 to blockCount - 1
                BearishOrderBlock block = array.get(bearishObStack, blockIndex)
                if block.active and obRangesAreNear(block.top, block.bottom, obTop, obBottom)
                    block.touches += 1
                    block.power := math.min(100.0, block.power + obPower)
                    block.sellVolume += obSellVolume
                    block.totalVolume += obTotalVolume
                    block.deltaVolume += obDeltaVolume
                    block.top := math.max(block.top, obTop)
                    block.bottom := math.min(block.bottom, obBottom)
                    box.set_top(block.boxRef, block.top)
                    box.set_bottom(block.boxRef, block.bottom)
                    array.set(bearishObStack, blockIndex, block)
                    matched := true
                    break
        if not matched
            box newBox = box.new(bar_index - rightBars, obTop, bar_index, obBottom, xloc=xloc.bar_index, extend=extend.right, border_color=color.new(color.purple, 25), border_width=1, bgcolor=color.new(color.purple, 85))
            array.push(bearishObStack, BearishOrderBlock.new(obTop, obBottom, obPower, obSellVolume, obTotalVolume, obDeltaVolume, 1, true, false, false, newBox, na))
        if array.size(bearishObStack) > 5
            BearishOrderBlock oldestBlock = array.shift(bearishObStack)
            if not na(oldestBlock.boxRef)
                box.delete(oldestBlock.boxRef)

zonePriority(LiquidityZone zone) =>
    (zone.touches > 1 ? 1000000 : 0) + (zone.highVolume ? 10000 : 0) + zone.touches

zoneColor(LiquidityZone zone) => zone.isBsl ? bslColor : sslColor

refreshZoneStyle(LiquidityZone zone) =>
    line.set_color(zone.lineRef, color.new(zoneColor(zone), 45))
    line.set_width(zone.lineRef, 1)
    line.set_style(zone.lineRef, zone.touches > 1 ? line.style_solid : line.style_dotted)

refreshNearestLiquidityStyles(int nearestBslIndex, int nearestSslIndex) =>
    int activeZoneCount = array.size(zones)
    if activeZoneCount > 0
        for zoneIndex = 0 to activeZoneCount - 1
            LiquidityZone zone = array.get(zones, zoneIndex)
            if zone.active
                bool isNearestBsl = not na(nearestBslIndex) and zoneIndex == nearestBslIndex
                bool isNearestSsl = not na(nearestSslIndex) and zoneIndex == nearestSslIndex
                bool isNearest = isNearestBsl or isNearestSsl
                line.set_color(zone.lineRef, color.new(zoneColor(zone), isNearest ? 0 : 45))
                line.set_width(zone.lineRef, isNearest ? 3 : 1)
                line.set_style(zone.lineRef, isNearest or zone.touches > 1 ? line.style_solid : line.style_dotted)

addOrStrengthenZone(float pivotPrice, bool isBsl, bool pivotHighVolume) =>
    bool matched = false
    int zoneCount = array.size(zones)
    if zoneCount > 0
        for zoneIndex = 0 to zoneCount - 1
            LiquidityZone zone = array.get(zones, zoneIndex)
            if zone.active and zone.isBsl == isBsl and math.abs(zone.level - pivotPrice) <= toleranceAt(pivotPrice)
                zone.touches += 1
                zone.highVolume := zone.highVolume or pivotHighVolume
                refreshZoneStyle(zone)
                matched := true
                break
    if not matched
        color newZoneColor = isBsl ? bslColor : sslColor
        line newLine = line.new(bar_index - rightBars, pivotPrice, bar_index, pivotPrice, xloc=xloc.bar_index, extend=extend.right, color=color.new(newZoneColor, 45), width=1, style=line.style_dotted)
        array.push(zones, LiquidityZone.new(pivotPrice, isBsl, 1, pivotHighVolume, true, newLine))
    if array.size(zones) > maxZones
        LiquidityZone oldestZone = array.shift(zones)
        line.delete(oldestZone.lineRef)

float pivotHigh = ta.pivothigh(high, leftBars, rightBars)
float pivotLow = ta.pivotlow(low, leftBars, rightBars)
float minorPivotLow = ta.pivotlow(low, minorStructureBars, minorStructureBars)
float minorPivotHigh = ta.pivothigh(high, minorStructureBars, minorStructureBars)
if not na(minorPivotLow)
    lastMinorLow := minorPivotLow
if not na(minorPivotHigh)
    lastMinorHigh := minorPivotHigh
bool bearishChoch = not na(lastMinorLow) and close < lastMinorLow and close[1] >= lastMinorLow
if bearishChoch
    lastMinorLow := na
bool bullishChoch = not na(lastMinorHigh) and close > lastMinorHigh and close[1] <= lastMinorHigh
if bullishChoch
    lastMinorHigh := na
// Memory latch: a structural break stays valid context for 5 bars so multi-bar OB/volume
// confirmations don't need to land on the exact same bar as the breakout candle itself.
bool isBullChochActiveInWindow = ta.barssince(bullishChoch) <= 5
bool isBearChochActiveInWindow = ta.barssince(bearishChoch) <= 5

// Confirmed H4 pivots lock a series value per bar; past values never change when a new pivot forms.
float confirmedH4PivotHigh = request.security(syminfo.tickerid, h4SweepTimeframe, ta.pivothigh(high, leftBars, rightBars), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float confirmedH4PivotLow = request.security(syminfo.tickerid, h4SweepTimeframe, ta.pivotlow(low, leftBars, rightBars), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool freshH4PivotHigh = not na(confirmedH4PivotHigh) and na(confirmedH4PivotHigh[1])
bool freshH4PivotLow = not na(confirmedH4PivotLow) and na(confirmedH4PivotLow[1])
var float fixedHigh = na
var float fixedLow = na
if freshH4PivotHigh
    fixedHigh := confirmedH4PivotHigh
if freshH4PivotLow
    fixedLow := confirmedH4PivotLow
float htfHigh = fixedHigh
float htfLow = fixedLow
bool h4HighSweep = ta.crossover(high, htfHigh)
bool h4LowSweep = ta.crossunder(low, htfLow)
if h4HighSweep
    isTrackingReversal := true
    trackingHighSweep := true
    maxPenetration := (high - htfHigh) / htfHigh * 100.0
else if h4LowSweep
    isTrackingReversal := true
    trackingHighSweep := false
    maxPenetration := (htfLow - low) / htfLow * 100.0
else if isTrackingReversal
    float currentSweepLevel = trackingHighSweep ? htfHigh : htfLow
    if not na(currentSweepLevel)
        float currentPenetration = trackingHighSweep ? (high - currentSweepLevel) / currentSweepLevel * 100.0 : (currentSweepLevel - low) / currentSweepLevel * 100.0
        maxPenetration := math.max(maxPenetration, currentPenetration)

bool confirmedH4Reversal = barstate.isconfirmed and isTrackingReversal and ((trackingHighSweep and bearishChoch) or (not trackingHighSweep and bullishChoch))
string confirmedReversalType = trackingHighSweep ? "High" : "Low"
if confirmedH4Reversal
    if trackingHighSweep
        array.unshift(historicalSweepsHigh, maxPenetration)
        if array.size(historicalSweepsHigh) > 10
            array.pop(historicalSweepsHigh)
    else
        array.unshift(historicalSweepsLow, maxPenetration)
        if array.size(historicalSweepsLow) > 10
            array.pop(historicalSweepsLow)
    isTrackingReversal := false

float avgHighSweepPercent = 0.58
float avgLowSweepPercent = 0.72
float statHighPlot = not na(fixedHigh) ? fixedHigh * (1.0 + 0.58 / 100.0) : na
float statLowPlot = not na(fixedLow) ? fixedLow * (1.0 - 0.72 / 100.0) : na
float upper_corridor = statHighPlot
float lower_corridor = statLowPlot
float alertPriceHigh = statHighPlot
float alertPriceLow = statLowPlot
bool historicalHighZoneHit = ta.crossover(high, alertPriceHigh)
bool historicalLowZoneHit = ta.crossunder(low, alertPriceLow)
float pctDropFromHigh = not na(htfHigh) ? math.abs((htfHigh - close) / htfHigh * 100.0) : na
float pctRiseFromLow = not na(htfLow) ? math.abs((close - htfLow) / htfLow * 100.0) : na
float liveHighDeviation = not na(htfHigh) and high > htfHigh ? (high - htfHigh) / htfHigh * 100.0 : 0.0
float liveLowDeviation = not na(htfLow) and low < htfLow ? (htfLow - low) / htfLow * 100.0 : 0.0
float liveSweepPenetration = isTrackingReversal ? maxPenetration : na
float applicableSweepAverage = trackingHighSweep ? avgHighSweepPercent : avgLowSweepPercent
bool inReversalProbabilityZone = isTrackingReversal and not na(applicableSweepAverage) and applicableSweepAverage > 0 and math.abs(liveSweepPenetration - applicableSweepAverage) <= applicableSweepAverage * 0.15

// Step plots write fixed values into the historical series instead of moving line objects.
fixedHighPlot = plot(fixedHigh, "Locked H4 High", color=color.new(bslColor, 35), linewidth=2, style=plot.style_stepline)
statHighBoundaryPlot = plot(statHighPlot, "H4 High Statistical Corridor", color=statCorridorColor, linewidth=2, style=plot.style_stepline)
fixedLowPlot = plot(fixedLow, "Locked H4 Low", color=color.new(sslColor, 35), linewidth=2, style=plot.style_stepline)
statLowBoundaryPlot = plot(statLowPlot, "H4 Low Statistical Corridor", color=statCorridorColor, linewidth=2, style=plot.style_stepline)
fill(fixedHighPlot, statHighBoundaryPlot, color=color.new(statCorridorColor, 92), title="H4 High Statistical Fill")
fill(fixedLowPlot, statLowBoundaryPlot, color=color.new(statCorridorColor, 92), title="H4 Low Statistical Fill")

// Confirmed pivots are projected only below their source timeframe, so lower-TF charts retain non-repainting H4 context.
bool projectH4Levels = showH4Projections and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(h4SweepTimeframe)
if projectH4Levels
    if not na(fixedHigh)
        if na(h4HighProjectionLine)
            h4HighProjectionLine := line.new(bar_index - 1, fixedHigh, bar_index, fixedHigh, xloc=xloc.bar_index, extend=extend.right, color=color.new(bslColor, 55), width=2, style=line.style_dashed)
        else
            line.set_xy1(h4HighProjectionLine, bar_index - 1, fixedHigh)
            line.set_xy2(h4HighProjectionLine, bar_index, fixedHigh)
    if not na(fixedLow)
        if na(h4LowProjectionLine)
            h4LowProjectionLine := line.new(bar_index - 1, fixedLow, bar_index, fixedLow, xloc=xloc.bar_index, extend=extend.right, color=color.new(sslColor, 55), width=2, style=line.style_dashed)
        else
            line.set_xy1(h4LowProjectionLine, bar_index - 1, fixedLow)
            line.set_xy2(h4LowProjectionLine, bar_index, fixedLow)
else
    line.delete(h4HighProjectionLine)
    line.delete(h4LowProjectionLine)
    h4HighProjectionLine := na
    h4LowProjectionLine := na

// Classify each available one-minute intrabar by its candle direction. This remains
// directional-volume analysis, not exchange-provided bid/ask order-flow data.
[candleRange, candleBody, upperWick, lowerWick, bodyPct, upperWickPct, lowerWickPct, closePosPct, isGreen, isRed] = f_evaluateCandleAnatomy()
float barVolumeUsdt = volume * close
float legacyBuyRatio = candleRange > 0 ? closePosPct / 100.0 : 0.5
float legacyBuyVolume = volume * legacyBuyRatio
float legacySellVolume = volume - legacyBuyVolume
bool supportsOneMinuteIntrabars = not na(chartTimeframeSeconds) and chartTimeframeSeconds > 60
array<float> intrabarBuyVolumes = array.new_float()
array<float> intrabarSellVolumes = array.new_float()
if supportsOneMinuteIntrabars
    intrabarBuyVolumes := request.security_lower_tf(syminfo.tickerid, "1", close > open ? volume : close < open ? 0.0 : volume * 0.5)
    intrabarSellVolumes := request.security_lower_tf(syminfo.tickerid, "1", close < open ? volume : close > open ? 0.0 : volume * 0.5)
float intrabarBuyVolume = array.sum(intrabarBuyVolumes)
float intrabarSellVolume = array.sum(intrabarSellVolumes)
bool hasIntrabarVolume = array.size(intrabarBuyVolumes) > 0 and array.size(intrabarSellVolumes) > 0 and not na(intrabarBuyVolume) and not na(intrabarSellVolume)
float intrabarTotalVolume = intrabarBuyVolume + intrabarSellVolume
varip float liveClassifiedIntrabarVolume = 0.0
varip float livePendingBuyVolume = 0.0
varip float livePendingSellVolume = 0.0
varip float liveAccountedVolume = 0.0
varip float livePreviousPrice = na
bool isLiveChartBar = barstate.islast and barstate.isrealtime
if isLiveChartBar
    bool startsNewChartBar = barstate.isnew
    bool completedIntrabarVolumeChanged = not startsNewChartBar and intrabarTotalVolume != liveClassifiedIntrabarVolume
    if startsNewChartBar or completedIntrabarVolumeChanged or volume < liveAccountedVolume
        liveClassifiedIntrabarVolume := intrabarTotalVolume
        livePendingBuyVolume := 0.0
        livePendingSellVolume := 0.0
        liveAccountedVolume := intrabarTotalVolume
    if startsNewChartBar
        livePreviousPrice := close
    float incomingLiveVolume = math.max(volume - liveAccountedVolume, 0.0)
    if incomingLiveVolume > 0
        if na(livePreviousPrice) or close == livePreviousPrice
            livePendingBuyVolume += incomingLiveVolume * 0.5
            livePendingSellVolume += incomingLiveVolume * 0.5
        else if close > livePreviousPrice
            livePendingBuyVolume += incomingLiveVolume
        else
            livePendingSellVolume += incomingLiveVolume
        liveAccountedVolume += incomingLiveVolume
    livePreviousPrice := close
// Closed one-minute bars retain their LTF classification; only the still-developing
// portion is classified from each incoming tick, so provisional values do not decrease.
float liveBuyVolume = intrabarBuyVolume + livePendingBuyVolume
float liveSellVolume = intrabarSellVolume + livePendingSellVolume
float buyVolume = isLiveChartBar ? liveBuyVolume : hasIntrabarVolume ? intrabarBuyVolume : legacyBuyVolume
float sellVolume = isLiveChartBar ? liveSellVolume : hasIntrabarVolume ? intrabarSellVolume : legacySellVolume
float buyRatio = volume > 0 ? buyVolume / volume : 0.5
float ltf_buy_vol = buyVolume
float ltf_sell_vol = sellVolume
float buyVolumeUsdt = buyVolume * close
float sellVolumeUsdt = sellVolume * close
float totalVolumeUsdt = barVolumeUsdt
float btc_close = request.security(btc_ticker, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float btc_high = request.security(btc_ticker, timeframe.period, high, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float btc_low = request.security(btc_ticker, timeframe.period, low, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool has_btc_smt_history = not na(btc_close[lookback_bars]) and not na(btc_high[lookback_bars]) and not na(btc_low[lookback_bars]) and not na(close[lookback_bars]) and not na(high[lookback_bars]) and not na(low[lookback_bars])
bool btc_is_rising = false
bool alt_is_failing = false
bool btc_is_falling = false
bool alt_is_holding = false
if has_btc_smt_history
    btc_is_rising := btc_close > btc_close[lookback_bars] or btc_high > btc_high[lookback_bars]
    alt_is_failing := close < close[lookback_bars] or high < high[lookback_bars]
    btc_is_falling := btc_close < btc_close[lookback_bars] or btc_low < btc_low[lookback_bars]
    alt_is_holding := close > close[lookback_bars] or low > low[lookback_bars]
bool is_chart_reference_asset = syminfo.tickerid == btc_ticker
bool is_bitcoin_chart = syminfo.basecurrency == "BTC"
bool isAltAsset = not isBtcAsset and not is_chart_reference_asset and not is_bitcoin_chart
bool suppress_smt_context = not isAltAsset
bool btc_divergence_bearish = not suppress_smt_context and show_btc_div and btc_is_rising and alt_is_failing
bool btc_divergence_bullish = not suppress_smt_context and show_btc_div and btc_is_falling and alt_is_holding
bool isAltWeak = btc_divergence_bearish
bool isAltStrong = btc_divergence_bullish
// TradingView publishes perpetual OI under the chart contract's standard ticker plus the _OI suffix.
string oiTicker = str.format("{0}_OI", ticker.standard(syminfo.tickerid))
float cryptoOpenInterest = request.security(oiTicker, timeframe.period, close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float rawOiDelta = cryptoOpenInterest - cryptoOpenInterest[1]
float oiDeltaUsdt = rawOiDelta * close
float totalOiUsdt = cryptoOpenInterest * close
float tradedVolumeUsdt = barVolumeUsdt
bool isOiSignificant = not na(oiDeltaUsdt) and not na(tradedVolumeUsdt) and math.abs(oiDeltaUsdt) > tradedVolumeUsdt * oiSignificancePercent / 100.0
float volumeSma = ta.sma(barVolumeUsdt, volumeLength)
float buyVolumeSma = ta.sma(buyVolumeUsdt, whaleLength)
float buyVolumeStDev = ta.stdev(buyVolumeUsdt, whaleLength)
float sellVolumeSma = ta.sma(sellVolumeUsdt, whaleLength)
float sellVolumeStDev = ta.stdev(sellVolumeUsdt, whaleLength)
float whaleVolumeAverage = ta.sma(barVolumeUsdt, whaleLength)
float relativeVolume = whaleVolumeAverage > 0 ? barVolumeUsdt / whaleVolumeAverage : na
float scoreVolumeSma = ta.sma(volume, whaleLength)
float rvol = scoreVolumeSma > 0 ? volume / scoreVolumeSma : 0.0
float vMult = rvol * volSensitivity
bool isWhaleBuyVolume = buyVolumeUsdt > buyVolumeSma + whaleMultiplier * buyVolumeStDev
bool isWhaleSellVolume = sellVolumeUsdt > sellVolumeSma + whaleMultiplier * sellVolumeStDev
float totalVolume = buyVolume + sellVolume
float dashboardBuyVolume = buyVolumeUsdt
float dashboardSellVolume = sellVolumeUsdt
float totalVolumeSma = ta.sma(totalVolumeUsdt, 20)
float dynamicVolumeSma = ta.sma(totalVolumeUsdt, 50)
float highVolThreshold = dynamicVolumeSma * 1.5
float volumeSma20 = ta.sma(barVolumeUsdt, 20)
bool isHighVolume = not na(volumeSma20) and barVolumeUsdt > volumeSma20 * 1.8
bool isLowVolume = not na(volumeSma20) and barVolumeUsdt < volumeSma20 * 0.8
bool isVolumeClimax = isHighVolume
float institutionalVolumeBaseline = ta.sma(barVolumeUsdt, dynamicInstitutionalVolumeLength)
bool institutionalVolumeSpike = not na(institutionalVolumeBaseline) and barVolumeUsdt > institutionalVolumeBaseline * institutionalVolumeMultiplier
float deltaVol = buyVolume - sellVolume
float deltaVolUsdt = buyVolumeUsdt - sellVolumeUsdt
cvd := cvd + nz(deltaVol)
float deltaPercent = totalVolume > 0 ? (buyVolume - sellVolume) / totalVolume * 100 : 0.0
bool isExtremeVolSpike = not na(totalVolumeSma) and totalVolumeUsdt > totalVolumeSma * 1.8
bool heavySellingPressure = isExtremeVolSpike and deltaPercent < -12.0
bool heavyBuyingPressure = isExtremeVolSpike and deltaPercent > 12.0

float ema1_core = ta.ema(close, cmLength)
float ema2_core = ta.ema(ema1_core, cmLength)
float ema3_core = ta.ema(ema2_core, cmLength)
float smoothTema = 3.0 * (ema1_core - ema2_core) + ema3_core
bool isTemaGoingUp = smoothTema >= smoothTema[cmSmoothe]
bool isTemaGoingDown = smoothTema < smoothTema[cmSmoothe]
float smoothSlope = math.abs(smoothTema - smoothTema[cmSmoothe])
float smoothAtr = ta.atr(14) * flatFilter
bool isTemaInChop = smoothSlope < smoothAtr
int chopLean = 0
if isTemaInChop and totalVolumeUsdt > totalVolumeSma * 1.10
    if deltaPercent > 12.0
        chopLean := 1
    else if deltaPercent < -12.0
        chopLean := -1

color smooth3Color = color.orange
if not isTemaInChop
    if isTemaGoingUp and close > smoothTema
        smooth3Color := color.lime
    else if isTemaGoingDown and close < smoothTema
        smooth3Color := color.fuchsia
bool isTemaLime = smooth3Color == color.lime
bool isTemaFuchsia = smooth3Color == color.fuchsia
bool isTemaOrange = smooth3Color == color.orange
plot(smoothTema, title="3-Color Smooth TEMA Bias", color=smooth3Color, linewidth=3)

bool inAsiaSession = not na(time(timeframe.period, asiaSession, sessionTimezone))
bool inLondonSession = not na(time(timeframe.period, londonSession, sessionTimezone))
bool inNewYorkSession = not na(time(timeframe.period, newYorkSession, sessionTimezone))
bool asiaSessionStarted = inAsiaSession and not inAsiaSession[1]
bool londonSessionStarted = inLondonSession and not inLondonSession[1]
bool newYorkSessionStarted = inNewYorkSession and not inNewYorkSession[1]
bool asiaSessionEnded = inAsiaSession[1] and not inAsiaSession

var float sessionOpenPrice = na
var float htfDailyOpenFallback = na
var string activeSessionLabel = "NONE"
var float asiaHigh = na
var float asiaLow = na
var float lockedAsiaHigh = na
var float lockedAsiaLow = na
var bool londonSweptAsiaHigh = false
var bool londonSweptAsiaLow = false
var string londonManipulationState = ""

if barstate.isfirst or ta.change(time("D")) != 0
    htfDailyOpenFallback := open

if asiaSessionStarted
    sessionOpenPrice := open
    activeSessionLabel := "ASIA"
if londonSessionStarted
    sessionOpenPrice := open
    activeSessionLabel := "LDN"
if newYorkSessionStarted
    sessionOpenPrice := open
    activeSessionLabel := "NY"

if asiaSessionStarted
    asiaHigh := high
    asiaLow := low
else if inAsiaSession
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow, low)

if asiaSessionEnded
    lockedAsiaHigh := asiaHigh
    lockedAsiaLow := asiaLow

if londonSessionStarted
    londonSweptAsiaHigh := false
    londonSweptAsiaLow := false
    londonManipulationState := ""

if inLondonSession and not na(lockedAsiaHigh) and not na(lockedAsiaLow)
    londonSweptAsiaHigh := londonSweptAsiaHigh or high > lockedAsiaHigh
    londonSweptAsiaLow := londonSweptAsiaLow or low < lockedAsiaLow
    if londonManipulationState == ""
        if londonSweptAsiaHigh and (close < open or deltaPercent < -20.0)
            londonManipulationState := "LM: BEAR FAKEOUT"
        else if londonSweptAsiaLow and (close > open or deltaPercent > 20.0)
            londonManipulationState := "LM: BULL FAKEOUT"

if not inLondonSession and inLondonSession[1]
    londonManipulationState := ""
    londonSweptAsiaHigh := false
    londonSweptAsiaLow := false

float activeSessionOpenPrice = not na(sessionOpenPrice) ? sessionOpenPrice : htfDailyOpenFallback
string sessionBiasText = na(activeSessionOpenPrice) ? "-" : activeSessionLabel + ": " + (close >= activeSessionOpenPrice ? "BULL" : "BEAR")
string londonManipulationText = ""
if inLondonSession
    if londonManipulationState != ""
        londonManipulationText := londonManipulationState
    else if londonSweptAsiaHigh or londonSweptAsiaLow
        londonManipulationText := "LM: SWEEP IN PROGRESS"
    else
        londonManipulationText := "LM: NO SWEEP"
float fastTrendEma = ta.ema(close, 9)
bool aggressiveUpwardExpansion = close > fastTrendEma and close > high[1]
bool rawInstitutionalAccumulation = isOiSignificant and oiDeltaUsdt > 0 and math.abs(deltaPercent) <= neutralDeltaBound
[institutionalAccumulation, volumeAccumulationStrength, volumeAccumulationDeltaDominance] = f_resolveVolumeAccumulation(rawInstitutionalAccumulation, buyVolumeUsdt, sellVolumeUsdt, close, fastTrendEma, high[1])
bool aggressiveShortSqueeze = isOiSignificant and oiDeltaUsdt < 0 and deltaPercent > bullishDeltaThreshold
bool aggressiveLongSqueeze = isOiSignificant and oiDeltaUsdt < 0 and deltaPercent < bearishDeltaThreshold
float cumulativeDeltaPercent3 = math.sum(deltaPercent, 3)
bool recentBuyClimax = (isHighVolume[1] and close[1] > open[1] and deltaPercent[1] > 0) or (isHighVolume[2] and close[2] > open[2] and deltaPercent[2] > 0) or (isHighVolume[3] and close[3] > open[3] and deltaPercent[3] > 0)
bool noDemandBearishReversal = close < open and close < close[1] and isLowVolume and not na(relativeVolume) and relativeVolume < 0.8 and recentBuyClimax
float closeLocationValue = candleRange > 0 ? closePosPct * 0.02 - 1.0 : 0.0
float moneyFlowVolume = closeLocationValue * nz(volume, 0)
float cmfVolumeSum = math.sum(moneyFlowVolume, cmfLength)
float cmfTotalVolume = math.sum(nz(volume, 0), cmfLength)
float cmfValue = cmfTotalVolume > 0 ? cmfVolumeSum / cmfTotalVolume : 0.0
float htfTrendEma = request.security(syminfo.tickerid, trendBiasTimeframe, ta.ema(close, trendBiasEmaLength), lookahead=barmerge.lookahead_off)
string trendBias = na(htfTrendEma) ? "RANGE" : close > htfTrendEma ? "UP" : close < htfTrendEma ? "DOWN" : "RANGE"
bool strongBullishClose = close > open and deltaPercent >= momentumDeltaThreshold and cmfValue >= momentumCmfThreshold
bool bearTargetMomentumInvalidated = targetActive and targetDirection == -1 and bar_index == targetOriginBar + 1 and strongBullishClose

if bearTargetMomentumInvalidated
    supersededOriginBar := targetOriginBar
    array.push(supersededTargetBars, targetOriginBar)
    array.push(supersededTargetOutcomes, "SUP -> BULL MOM")
    if array.size(supersededTargetBars) > 20
        array.shift(supersededTargetBars)
        array.shift(supersededTargetOutcomes)
    line.delete(targetLine)
