    for zoneIndex = 0 to zoneCount - 1
        LiquidityZone zone = array.get(zones, zoneIndex)
        if zone.active and zone.isBsl and zone.level > close
            float bslDistance = zone.level - close
            if na(nearestBslDistance) or bslDistance < nearestBslDistance
                nearestActiveBsl := zone.level
                nearestBslDistance := bslDistance
                nearestBslIndex := zoneIndex
        if zone.active and not zone.isBsl and zone.level < close
            float sslDistance = close - zone.level
            if na(nearestSslDistance) or sslDistance < nearestSslDistance
                nearestActiveSsl := zone.level
                nearestSslDistance := sslDistance
                nearestSslIndex := zoneIndex

refreshNearestLiquidityStyles(nearestBslIndex, nearestSslIndex)

bool bslSwept = false
bool sslSwept = false
if barstate.isconfirmed and zoneCount > 0
    for zoneIndex = 0 to zoneCount - 1
        LiquidityZone zone = array.get(zones, zoneIndex)
        bool breached = mitigationMode == "Wick Sweep" ? (zone.isBsl ? high >= zone.level : low <= zone.level) : (zone.isBsl ? close > zone.level : close < zone.level)
        if zone.active and breached
            zone.active := false
            bslSwept := bslSwept or zone.isBsl
            sslSwept := sslSwept or not zone.isBsl
            if keepMitigated
                line.set_extend(zone.lineRef, extend.none)
                line.set_x2(zone.lineRef, bar_index)
                line.set_style(zone.lineRef, line.style_dashed)
