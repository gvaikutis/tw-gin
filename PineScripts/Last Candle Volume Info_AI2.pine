bool isShortSqueezeCompleted = bslSweepOccurredWithin3Bars and not na(squeezeVolumeSma50) and totalVolumeUsdt >= squeezeVolumeSma50 * 1.15 and upperWickPct >= 35.0 and closePosPct <= 55.0 and (deltaVol < 0 or deltaPercent < 5.0) and squeezeValidationBacking
bool isLongSqueezeCompleted = sslSweepOccurredWithin3Bars and not na(squeezeVolumeSma50) and totalVolumeUsdt >= squeezeVolumeSma50 * 1.15 and lowerWickPct >= 35.0 and closePosPct >= 45.0 and (deltaVol > 0 or deltaPercent > -5.0) and squeezeValidationBacking
var string squeezeStatus = "NEUTRAL"
