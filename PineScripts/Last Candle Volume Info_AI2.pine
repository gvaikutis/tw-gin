bool testsBullishLiquidity = sslSwept or lowerCorridorTouched or insideBullishOb
bool bearishInstitutionalHandover = isRed and deltaPercent <= bearishDeltaThreshold and (institutionalVolumeSpike or isExtremeVolSpike)
bool bullishInstitutionalHandover = isGreen and deltaPercent >= bullishDeltaThreshold and (institutionalVolumeSpike or isExtremeVolSpike)
bool aggressiveBearishReversalAttempt = barstate.isconfirmed and isTemaLime and bullishVelocityRun and testsBearishLiquidity and bearishInstitutionalHandover
bool aggressiveBullishReversalAttempt = barstate.isconfirmed and isTemaFuchsia and bearishVelocityRun and testsBullishLiquidity and bullishInstitutionalHandover
bool aggressiveBearishReversalPulse = aggressiveBearishReversalAttempt and not aggressiveBearishReversalAttempt[1]
bool aggressiveBullishReversalPulse = aggressiveBullishReversalAttempt and not aggressiveBullishReversalAttempt[1]
isPotentialReversal := isPotentialReversal or aggressiveBullishReversalAttempt
isPotentialBearishReversal := isPotentialBearishReversal or aggressiveBearishReversalAttempt
bool sellSideBiasLocked = bearishObAbove and not isPotentialReversal
bool is_wheel_buy = insideBullishOb and isWhaleBuyVolume and deltaPercent > 0 and totalVolumeUsdt > totalVolumeSma and not isPotentialBearishReversal
bool is_wheel_sell = insideBearishOb and isWhaleSellVolume and deltaPercent < 0 and totalVolumeUsdt > totalVolumeSma
bool volumeThresholdAlert = barstate.isconfirmed and institutionalVolumeSpike
bool corridorTouchAlert = barstate.isconfirmed and (upperCorridorTouched or lowerCorridorTouched)
