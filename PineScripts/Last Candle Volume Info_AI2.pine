bool bearishQualifyingSetup = isPotentialBearishReversal or bearishObTouchReversalSetup or heavySellingPressure
bool heavyVolumeBullishCvdConfluence = bullishQualifyingSetup and recentBullishCvdDivergenceForAi and buyVolumeUsdt > 1000000
bool bearishVolClimaxReversalSetup = isPotentialBearishReversal or bearishObTouchReversalSetup
float reversalSmtWeight = 0.0
if bullishQualifyingSetup
    reversalSmtWeight := isAltStrong ? 15.0 : isAltWeak ? -15.0 : 0.0
else if bearishQualifyingSetup
    reversalSmtWeight := isAltWeak ? 15.0 : isAltStrong ? -15.0 : 0.0
float reversalTemaTrendWeight = bullishProbabilityLabel and isTemaLime ? 15.0 : bearishProbabilityLabel and isTemaFuchsia ? 15.0 : 0.0
float reversalOpposingTemaPenalty = bullishQualifyingSetup and isTemaFuchsia and not heavyVolumeBullishCvdConfluence ? -15.0 : 0.0
bool recentBearBreakTrap = isBearBreakTrap or isBearBreakTrap[1]
bool recentBullAbs = isBullAbs or isBullAbs[1]
float reversalTrapWeight = isPotentialReversal and recentBearBreakTrap ? 15.0 : isPotentialBearishReversal and recentBullAbs ? 15.0 : 0.0
float upperBandWidth = h4UpperCorridor - h4High
float lowerBandWidth = h4Low - h4LowerCorridor
bool bullishShallowCorridorPenetration = not obTouchReversalSetup and bullishQualifyingSetup and not na(lowerBandWidth) and lowerBandWidth > 0 and close < h4Low and close > h4Low - lowerBandWidth * 0.5
bool bearishShallowCorridorPenetration = not obTouchReversalSetup and bearishQualifyingSetup and not na(upperBandWidth) and upperBandWidth > 0 and close > h4High and close < h4High + upperBandWidth * 0.5
bool bullishDeepCorridorPenetration = not obTouchReversalSetup and bullishQualifyingSetup and not na(lowerBandWidth) and lowerBandWidth > 0 and close <= h4Low - lowerBandWidth * 0.5
bool bearishDeepCorridorPenetration = not obTouchReversalSetup and bearishQualifyingSetup and not na(upperBandWidth) and upperBandWidth > 0 and close >= h4High + upperBandWidth * 0.5
float reversalH4Weight = bullishDeepCorridorPenetration or bearishDeepCorridorPenetration ? 20.0 : bullishShallowCorridorPenetration or bearishShallowCorridorPenetration ? 10.0 : 0.0
bool recentVolClimaxAbsCeiling = not na(volClimaxAbsCeiling) and not na(volClimaxAbsCeilingBar) and bar_index - volClimaxAbsCeilingBar <= 10
bool testsVolClimaxAbsCeiling = recentVolClimaxAbsCeiling and math.abs(high - volClimaxAbsCeiling) / volClimaxAbsCeiling <= 0.05 / 100.0
float reversalVolClimaxWeight = bearishVolClimaxReversalSetup and testsVolClimaxAbsCeiling ? 15.0 : 0.0
float reversalDivergenceWeight = heavyVolumeBullishCvdConfluence ? 25.0 : ((bullishProbabilityLabel and recentBullishCvdDivergence) or (bearishProbabilityLabel and recentBearishCvdDivergence)) ? 15.0 : 0.0
float reversalChopLeanWeight = 0.0
if isTemaOrange
    if bullishProbabilityLabel
        reversalChopLeanWeight := chopLean == 1 ? 10.0 : chopLean == -1 ? -15.0 : 0.0
    else if bearishProbabilityLabel
        reversalChopLeanWeight := chopLean == -1 ? 10.0 : chopLean == 1 ? -15.0 : 0.0
float reversalMomentumWeight = heavySellingPressure or heavyBuyingPressure ? 30.0 : 0.0
float reversalVelocityWeight = aggressiveBullishReversalAttempt or aggressiveBearishReversalAttempt ? 30.0 : 0.0
float reversalLiveCvdWeight = liveBullishCvdDivergence or liveBearishCvdDivergence ? 30.0 : 0.0
f_getSynchronizedScoreChange(bool isWhaleBuy, bool isWhaleSell, float baseScore, float volumeMultiplier, float candleRange, float candleBody, float upperWick, float lowerWick, float closePosPct, bool isGreen, bool isRed) =>
    float finalScore = baseScore
    bool touchesDistributionWall = (not na(h4UpperCorridor) and high >= h4UpperCorridor) or insideBearishOb
    bool whaleDistributionWall = touchesDistributionWall and deltaPercent > 12.0 and candleRange > 0 and closePosPct <= 50.0 and upperWick > candleBody
    string ruleCode = "R"
    // Rejected aggressive buying at overhead institutional resistance takes priority over Whale Buy.
    if whaleDistributionWall
        finalScore := -20.0 * rvol
        ruleCode := "W"
    else if isWhaleBuy
        finalScore := 15.0 * math.max(1.0, volumeMultiplier)
        ruleCode := "W"
    else if isWhaleSell
        finalScore := -15.0 * math.max(1.0, volumeMultiplier)
        ruleCode := "W"
    else if isGreen
        bool isTrueTopRejection = upperWick > candleBody * 1.2 and upperWick > candleRange * 0.4
        if isTrueTopRejection
            finalScore := -10.0 * volumeMultiplier
            ruleCode := "A"
        else
            finalScore := baseScore < 0 ? 0.0 : (baseScore == 0 ? 5.0 : baseScore) * volumeMultiplier
            ruleCode := "R"
    else if isRed
        if lowerWick > candleBody * 1.5
            finalScore := 10.0 * volumeMultiplier
            ruleCode := "A"
        else
            finalScore := baseScore > 0 ? -baseScore * volumeMultiplier : baseScore == 0 ? -5.0 * volumeMultiplier : baseScore * volumeMultiplier
            ruleCode := "R"
    [finalScore, ruleCode]

float preMicroProbability = reversalBaselineProbability + reversalVolumeWeight + reversalDeltaWeight + reversalSmtWeight + reversalTemaTrendWeight + reversalOpposingTemaPenalty + reversalTrapWeight + reversalH4Weight + reversalVolClimaxWeight + reversalDivergenceWeight + reversalChopLeanWeight + reversalMomentumWeight + reversalVelocityWeight + reversalLiveCvdWeight
float preMicroScoreChange = preMicroProbability - nz(preMicroProbability[1], preMicroProbability)
[alignedScoreChange, activeRuleCode] = f_getSynchronizedScoreChange(is_wheel_buy, is_wheel_sell, preMicroScoreChange, vMult, candleRange, candleBody, upperWick, lowerWick, closePosPct, isGreen, isRed)
string volumeTierCode = rvol >= 2.0 ? "W" : rvol >= 1.5 ? "H" : rvol >= 0.85 ? "M" : "L"
string matrixCode = activeRuleCode + volumeTierCode
bool isWhaleMatrixPressure = matrixCode == "WW" or matrixCode == "WH"
bool isMatrixAbsorptionHandover = activeRuleCode == "A" and (volumeTierCode == "H" or volumeTierCode == "W")
float matrixConfluenceAdjustment = 0.0
if reversalAlignmentActive
    if isWhaleMatrixPressure
        matrixConfluenceAdjustment := 30.0
    else if matrixCode == "AH"
        matrixConfluenceAdjustment := 15.0
    else if matrixCode == "AM" or matrixCode == "RM"
        matrixConfluenceAdjustment := 5.0
    else if matrixCode == "AL" or matrixCode == "RL"
        matrixConfluenceAdjustment := -10.0
alignedScoreChange += matrixConfluenceAdjustment
float squeezeScoreAdjustment = isLongSqueezeCompleted ? 30.0 : isShortSqueezeCompleted ? -30.0 : 0.0
alignedScoreChange += squeezeScoreAdjustment
float rawMicroVolumeDeltaShift = deltaPercent * 0.15 * rvol
float microVolumeDeltaShift = rawMicroVolumeDeltaShift
var float aiScore = na
float dynamicAggregatedProbability = nz(aiScore[1], reversalBaselineProbability) + alignedScoreChange + microVolumeDeltaShift
int roundedScoreChange = math.round(alignedScoreChange)
string scorePrefix = roundedScoreChange > 0 ? "+" : ""
bool verifiedReactiveBuying = is_wheel_buy or bullishInstitutionalHandover or heavyBuyingPressure or institutionalAccumulation
bool verifiedReactiveSelling = is_wheel_sell or bearishInstitutionalHandover or heavySellingPressure
bool exceptionalBullishMatrixRating = (matrixCode == "RW" or matrixCode == "RH") and roundedScoreChange >= 25
bool exceptionalBearishMatrixRating = (matrixCode == "RW" or matrixCode == "RH") and roundedScoreChange <= -25
bool markdownContinuation = isRed and closePosPct <= 25.0 and close < close[1] and deltaVol <= 0
bool uninterruptedMarkdown = markdownContinuation and markdownContinuation[1] and markdownContinuation[2]
bool deepMarkdownContext = markdownContinuation[1] and markdownContinuation[2]
bool hasCounterAbsorption = lowerWickPct >= 35.0 or recentBullishCvdDivergence or bullishCvdDivergence or liveBullishCvdDivergence
bool bullishCounterTrendContext = (trendBias == "DOWN" and isTemaFuchsia) or (isTemaOrange and deepMarkdownContext)
bool bearishCounterTrendContext = trendBias == "UP" and isTemaLime
bool bullishReactiveBuying = lowerWickPct >= 35.0 or (isRed and deltaVol > 0) or recentBullishCvdDivergence or bullishCvdDivergence or liveBullishCvdDivergence
bool bearishReactiveSelling = upperWickPct >= 35.0 or (isGreen and deltaVol < 0) or recentBearishCvdDivergence or bearishCvdDivergence or liveBearishCvdDivergence
bool bullishMatrixInstitutionalHandover = bullishCounterTrendContext and verifiedReactiveBuying and bullishReactiveBuying and (is_wheel_buy or (isMatrixAbsorptionHandover and (heavyBuyingPressure or institutionalAccumulation)) or exceptionalBullishMatrixRating or isAbsorption) and not (uninterruptedMarkdown and not hasCounterAbsorption)
bool bearishMatrixHandoverCandidate = bearishCounterTrendContext and verifiedReactiveSelling and bearishReactiveSelling and (is_wheel_sell or (isMatrixAbsorptionHandover and heavySellingPressure) or exceptionalBearishMatrixRating)
bool bearishImmediatePeakExhaustion = bearishMatrixHandoverCandidate and bearishPeakExhaustion
bool bearishPeakValidated = bearishImmediatePeakExhaustion
bool bearishMatrixInstitutionalHandover = bearishPeakValidated
int matrixHandoverDirection = bullishMatrixInstitutionalHandover ? 1 : bearishMatrixInstitutionalHandover ? -1 : 0
bool matrixInstitutionalHandover = matrixHandoverDirection != 0
string resolvedSqueezeStatus = f_resolveSqueezeStatus(institutionalVolumeSpike, extremeDeltaVolumeClimax, deltaVol, bullishCvdDivergence, bearishCvdDivergence, trendBias == "UP", trendBias == "DOWN", lowerWickPct >= 35.0 and closePosPct >= 45.0, upperWickPct >= 35.0 and closePosPct <= 55.0, totalVolumeUsdt, matrixInstitutionalHandover, matrixHandoverDirection, bullishVelocityNoiseGate, bearishPeakValidated, highPurgeUsdtThreshold, aggressiveUpwardExpansion)
bool highVolumePurgeEvent = barstate.isconfirmed and resolvedSqueezeStatus == "INSTITUTIONAL_PURGE" and totalVolumeUsdt >= highPurgeUsdtThreshold
if barstate.isconfirmed
    squeezeStatus := resolvedSqueezeStatus
    liveC1SqueezeStatus := resolvedSqueezeStatus
else if barstate.islast
    liveC1SqueezeStatus := resolvedSqueezeStatus
bool showBullishInstitutionalEventMarker = barstate.isconfirmed and squeezeStatus == "INSTITUTIONAL_ACCUMULATION" and matrixHandoverDirection == 1
bool showInstitutionalPurgeMarker = barstate.isconfirmed and squeezeStatus == "INSTITUTIONAL_PURGE"
aiScore := math.min(99.0, math.max(0.0, dynamicAggregatedProbability))
bool whaleMatrixFloorActive = reversalAlignmentActive and isWhaleMatrixPressure
if heavySellingPressure or heavyBuyingPressure or aggressiveBullishReversalAttempt or aggressiveBearishReversalAttempt or liveBullishCvdDivergence or liveBearishCvdDivergence or whaleMatrixFloorActive
    aiScore := math.min(99.0, math.max(aiScore, 75.0))
float reversalProbabilityFixed = aiScore
float reversalProbability = reversalProbabilityFixed
bool maximumAiProbability = reversalProbability >= 85.0
alertcondition(barstate.isconfirmed and aiScore >= 85.0, "Maximum AI reversal probability", "AI reversal probability reached 85% or higher on {{ticker}}.")
string reversalProbabilityText = str.tostring(math.round(reversalProbabilityFixed)) + "%"
bool weakReversalSignal = reversalProbabilityFixed < 50.0
bool highVolumeReversalSignal = totalVolumeUsdt >= highVolThreshold
string reversalStrengthText = weakReversalSignal ? highVolumeReversalSignal ? "HIGH VOL" : "WEAK" : "STRONG"
float localBarTotalVol = barVolumeUsdt
float localBarBuyVol = dashboardBuyVolume[0]
float localBarSellVol = dashboardSellVolume[0]
float aiFeatureF1 = math.max(-100.0, math.min(100.0, deltaPercent))
float aiFeatureF2 = relativeVolume
float aiCorridorRange = upper_corridor - lower_corridor
float aiFeatureF3 = not na(upper_corridor) and not na(lower_corridor) and aiCorridorRange > 0 ? math.max(0.0, math.min(1.0, (close - lower_corridor) / aiCorridorRange)) : na
bool aiFeaturesAvailable = not na(aiFeatureF2) and not na(aiFeatureF3)
bool aiBullishSweepReversalEvent = isPotentialReversal and not isPotentialReversal[1]
bool aiBearishSweepReversalEvent = isPotentialBearishReversal and not isPotentialBearishReversal[1]
bool aiSweepReversalEvent = aiBullishSweepReversalEvent or aiBearishSweepReversalEvent
int aiNeighborCount = 5
int aiMaxHistorySize = 200

f_queryKnnConfidence(float feature1, float feature2, float feature3, int neighborCount) =>
    array<float> nearestDistances = array.new_float()
    array<int> nearestOutcomes = array.new_int()
    int historyCount = array.size(historical_outcomes)
    if historyCount > 0
        for historyIndex = 0 to historyCount - 1
            int historicalOutcome = array.get(historical_outcomes, historyIndex)
            if not na(historicalOutcome)
                float historicalF1 = array.get(historical_f1, historyIndex)
                float historicalF2 = array.get(historical_f2, historyIndex)
                float historicalF3 = array.get(historical_f3, historyIndex)
                float f1Distance = (feature1 - historicalF1) / 100.0
                float f2Distance = feature2 - historicalF2
                float f3Distance = feature3 - historicalF3
                float euclideanDistance = math.sqrt(f1Distance * f1Distance + f2Distance * f2Distance + f3Distance * f3Distance)
                int nearestCount = array.size(nearestDistances)
                if nearestCount < neighborCount
                    array.push(nearestDistances, euclideanDistance)
                    array.push(nearestOutcomes, historicalOutcome)
                else
                    int farthestIndex = 0
                    float farthestDistance = array.get(nearestDistances, 0)
                    for neighborIndex = 1 to nearestCount - 1
                        float neighborDistance = array.get(nearestDistances, neighborIndex)
                        if neighborDistance > farthestDistance
                            farthestDistance := neighborDistance
                            farthestIndex := neighborIndex
                    if euclideanDistance < farthestDistance
                        array.set(nearestDistances, farthestIndex, euclideanDistance)
                        array.set(nearestOutcomes, farthestIndex, historicalOutcome)
    float confidence = na
    if array.size(nearestOutcomes) == neighborCount
        int successfulNeighbors = 0
        for neighborIndex = 0 to neighborCount - 1
            successfulNeighbors += array.get(nearestOutcomes, neighborIndex)
        confidence := successfulNeighbors * 100.0 / neighborCount
    confidence

// Resolve samples only after their horizon closes, preventing future leakage in predictions.
int aiHistoryCount = array.size(historical_outcomes)
if barstate.isconfirmed and aiHistoryCount > 0
    for historyIndex = 0 to aiHistoryCount - 1
        int historicalOutcome = array.get(historical_outcomes, historyIndex)
        int historicalOriginBar = array.get(historical_origin_bars, historyIndex)
        if na(historicalOutcome) and bar_index - historicalOriginBar >= dynamicKnnOutcomeBars
            int historicalDirection = array.get(historical_directions, historyIndex)
            float historicalEntryPrice = array.get(historical_entry_prices, historyIndex)
            bool historicalSuccess = historicalDirection == 1 ? close > historicalEntryPrice : close < historicalEntryPrice
            array.set(historical_outcomes, historyIndex, historicalSuccess ? 1 : 0)

float aiConfidenceScore = aiSweepReversalEvent and aiFeaturesAvailable ? f_queryKnnConfidence(aiFeatureF1, aiFeatureF2, aiFeatureF3, aiNeighborCount) : na

if barstate.isconfirmed and aiSweepReversalEvent and aiFeaturesAvailable
    int aiEventDirection = aiBullishSweepReversalEvent ? 1 : -1
    array.push(historical_f1, aiFeatureF1)
    array.push(historical_f2, aiFeatureF2)
    array.push(historical_f3, aiFeatureF3)
    array.push(historical_outcomes, na)
    array.push(historical_directions, aiEventDirection)
    array.push(historical_entry_prices, close)
    array.push(historical_origin_bars, bar_index)
    if array.size(historical_outcomes) > aiMaxHistorySize
        array.shift(historical_f1)
        array.shift(historical_f2)
        array.shift(historical_f3)
        array.shift(historical_outcomes)
        array.shift(historical_directions)
        array.shift(historical_entry_prices)
        array.shift(historical_origin_bars)

float proximityThreshold = 0.30
bool isNearBearLine = not na(distanceToBearPct) and distanceToBearPct >= 0 and distanceToBearPct <= proximityThreshold
bool isNearBullLine = not na(distanceToBullPct) and distanceToBullPct >= 0 and distanceToBullPct <= proximityThreshold
float preSweepVolumeSma = ta.sma(volume, 20)
bool isVolumeSurging = not na(preSweepVolumeSma) and volume > preSweepVolumeSma * 1.25
bool preSweepBearWarning = isNearBearLine and isVolumeSurging
bool preSweepBullWarning = isNearBullLine and isVolumeSurging
float knnPreSweepConfidence = (preSweepBearWarning or preSweepBullWarning) and aiFeaturesAvailable ? f_queryKnnConfidence(aiFeatureF1, aiFeatureF2, aiFeatureF3, aiNeighborCount) : na
bool preSweepBearHighRisk = preSweepBearWarning and not na(knnPreSweepConfidence) and knnPreSweepConfidence >= 60.0
bool preSweepBullHighRisk = preSweepBullWarning and not na(knnPreSweepConfidence) and knnPreSweepConfidence >= 60.0

string knnString = not na(aiConfidenceScore) ? "\nAI: " + str.tostring(math.round(aiConfidenceScore)) + "%" : ""
string deltaTextStr = scorePrefix + str.tostring(roundedScoreChange) + "\n" + matrixCode + knnString
string candleRatingStr = deltaTextStr
bool isCandleCloseBullish = candleRange > 0 and closePosPct > 60.0 and close > close[1]
bool isCandleCloseBearish = candleRange > 0 and closePosPct < 40.0 and close < close[1]
bool isHighVolClassification = weakReversalSignal and highVolumeReversalSignal
bool drawBullishProbabilityLabel = bullishProbabilityLabel and not bullishProbabilityLabel[1] and isCandleCloseBullish
bool drawBearishProbabilityLabel = bearishProbabilityLabel and not bearishProbabilityLabel[1] and isCandleCloseBearish and close < open
if drawBullishProbabilityLabel
    globalBarProbabilityText := reversalProbabilityText + " BULL REV"
if drawBearishProbabilityLabel
    globalBarProbabilityText := reversalProbabilityText + " BEAR REV"
bool qualifiedBullishReversalSetup = barstate.isconfirmed and drawBullishProbabilityLabel and reversalProbability >= 75.0 and reversalStrengthText == "STRONG"
bool qualifiedBearishReversalSetup = barstate.isconfirmed and drawBearishProbabilityLabel and reversalProbability >= 75.0 and reversalStrengthText == "STRONG"
if qualifiedBullishReversalSetup
    trappedLongsIcebergLevel := low
    trappedLongsOriginBar := bar_index
    trappedLongsTargetLevel := na
    trappedLongsProbabilityText := reversalProbabilityText + " BULL REV"
if qualifiedBearishReversalSetup
    trappedShortsIcebergLevel := high
    trappedShortsOriginBar := bar_index
    trappedShortsTargetLevel := na
    trappedShortsProbabilityText := reversalProbabilityText + " BEAR REV"
bool reversalSignalStarted = (bullishProbabilityLabel and not bullishProbabilityLabel[1]) or (bearishProbabilityLabel and not bearishProbabilityLabel[1])
if barstate.isconfirmed and reversalSignalStarted
    lastSignalH4HighDist := pctDropFromHigh
    lastSignalH4LowDist := pctRiseFromLow
    lastSignalProbability := reversalProbability
    lastSignalBiasStr := ""
    lastSignalDirectionStr := bearishProbabilityLabel ? " BEAR REV" : " BULL REV"
if barstate.isconfirmed and exhaustionReversalSetup
    lastExhaustionLabelBar := bar_index
if barstate.isconfirmed and bullishObTouchReversalSetup
    if currentBullishBlockCount > 0
        for blockIndex = 0 to currentBullishBlockCount - 1
            BullishOrderBlock block = array.get(bullishObStack, blockIndex)
            if block.active and low <= block.top and high >= block.bottom and not block.reversalLabelPrinted
                block.reversalLabelPrinted := true
                array.set(bullishObStack, blockIndex, block)
if barstate.isconfirmed and bearishObTouchReversalSetup
    if currentBearishBlockCount > 0
        for blockIndex = 0 to currentBearishBlockCount - 1
            BearishOrderBlock block = array.get(bearishObStack, blockIndex)
            if block.active and high >= block.bottom and low <= block.top and not block.reversalLabelPrinted
                block.reversalLabelPrinted := true
                array.set(bearishObStack, blockIndex, block)

bool wheelExecutionAlert = false
string wheelDashboardState = "NONE"

float upperWickForAbsorption = upperWick
bool absorptionAlert = barstate.isconfirmed and isAbsorption

// Mid-range context uses the established volume, delta, CVD, and locked H4 series.
float candleVolumeUSDT = barVolumeUsdt
float volumeSmaUSDT = volumeSma20
float deltaPct = deltaPercent
bool isMidRangeVolume = not na(volumeSmaUSDT) and candleVolumeUSDT > volumeSmaUSDT * 1.25
bool isInsideH4Range = not na(h4High) and not na(h4Low) and not na(h4UpperCorridor) and not na(h4LowerCorridor) and high < h4High and high < h4UpperCorridor and low > h4Low and low > h4LowerCorridor
bool hasMidRangeContext = useMidRangeContext and isMidRangeVolume and isInsideH4Range
bool isMidRangeAbsBull = hasMidRangeContext and deltaPct > 20
bool isMidRangeAbsBear = hasMidRangeContext and deltaPct < -20
bool hiddenBearDiv = hasMidRangeContext and not na(cvd[3]) and high < high[3] and cvd > cvd[3]
bool hiddenBullDiv = hasMidRangeContext and not na(cvd[3]) and low > low[3] and cvd < cvd[3]
bool hasCvdAbsorption = hiddenBearDiv or hiddenBullDiv
string midRangeContextText = ""
if hasMidRangeContext
    if deltaPct > 20
        midRangeContextText := "MID BULL (+" + str.tostring(deltaPct, "#.0") + "%)"
    else if deltaPct < -20
        midRangeContextText := "MID BEAR (" + str.tostring(deltaPct, "#.0") + "%)"
    if hasCvdAbsorption
        midRangeContextText := midRangeContextText == "" ? "CVD ABSORP" : midRangeContextText + " | CVD ABSORP"

int absorptionCeilingCount = array.size(absorptionCeilingLines)
if barstate.isconfirmed and absorptionCeilingCount > 0
    for ceilingIndex = 0 to absorptionCeilingCount - 1
        line ceilingLine = array.get(absorptionCeilingLines, ceilingIndex)
        float ceilingPrice = array.get(absorptionCeilingPrices, ceilingIndex)
        bool ceilingIsActive = array.get(absorptionCeilingActive, ceilingIndex)
        if ceilingIsActive and close > ceilingPrice
            line.set_extend(ceilingLine, extend.none)
            line.set_x2(ceilingLine, bar_index)
            line.set_color(ceilingLine, color.gray)
            line.set_style(ceilingLine, line.style_dashed)
            line.set_width(ceilingLine, 1)
            array.set(absorptionCeilingActive, ceilingIndex, false)

if barstate.isconfirmed and isAbsorption
    volClimaxAbsCeiling := high
    volClimaxAbsCeilingBar := bar_index
    line newAbsorptionCeiling = line.new(x1=bar_index, y1=high, x2=bar_index + 1, y2=high, xloc=xloc.bar_index, extend=extend.right, color=color.orange, width=2)
    array.push(absorptionCeilingLines, newAbsorptionCeiling)
    array.push(absorptionCeilingPrices, high)
    array.push(absorptionCeilingActive, true)
    if array.size(absorptionCeilingLines) > 20
        line.delete(array.shift(absorptionCeilingLines))
        array.shift(absorptionCeilingPrices)
        array.shift(absorptionCeilingActive)

plotshape(isAbsorption, title="VOL CLIMAX ABS", style=shape.circle, location=location.abovebar, color=color.yellow, size=size.small)
plotshape(isExhaustionReversal, title="Exhaustion reversal", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="EXH", textcolor=color.white)
plotshape(showCvdDivergence and bullishCvdDivergence, "Bullish CVD divergence", shape.triangleup, location.belowbar, color=color.new(bslColor, 0), size=size.tiny, offset=-rightBars)
plotshape(showCvdDivergence and bearishCvdDivergence, "Bearish CVD divergence", shape.triangledown, location.abovebar, color=color.new(sslColor, 0), size=size.tiny, offset=-rightBars)
plotshape(showBullishInstitutionalEventMarker, title="Institutional Accumulation", style=shape.triangleup, location=location.belowbar, color=bslColor, size=size.small, text="LSQ", textcolor=color.white, force_overlay=true)
plotshape(showInstitutionalPurgeMarker, title="Institutional Purge", style=shape.triangledown, location=location.abovebar, color=color.fuchsia, size=size.small, text="PURGE", textcolor=color.white, force_overlay=true)
plotshape(institutionalAccumulation, title="Institutional Accumulation", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.small)
plotshape(aggressiveShortSqueeze, title="Aggressive Short Squeeze", style=shape.triangleup, location=location.belowbar, color=color.fuchsia, size=size.small, text="SQ", textcolor=color.white)
plotshape(aggressiveLongSqueeze, title="Aggressive Long Squeeze", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="LQ", textcolor=color.white)

// Hidden per-candle metrics for hover inspection and CSV export; never drawn on the chart.
plot(exportAnalysisData ? reversalProbability : na, "AN Reversal Probability %", display=display.data_window)
plot(exportAnalysisData ? deltaPercent : na, "AN Delta %", display=display.data_window)
plot(exportAnalysisData ? cmfValue : na, "AN CMF", display=display.data_window)
plot(exportAnalysisData ? cvd : na, "AN CVD", display=display.data_window)
plot(exportAnalysisData ? relativeVolume : na, "AN RVOL", display=display.data_window)
plot(exportAnalysisData ? dashboardBuyVolume : na, "AN Buy Volume (USDT)", display=display.data_window)
plot(exportAnalysisData ? dashboardSellVolume : na, "AN Sell Volume (USDT)", display=display.data_window)
plot(exportAnalysisData ? (isTrackingReversal ? maxPenetration : na) : na, "AN Sweep Penetration %", display=display.data_window)
plot(exportAnalysisData ? (bullishProbabilityLabel ? 1 : bearishProbabilityLabel ? -1 : 0) : na, "AN Reversal Flag (1 bull / -1 bear)", display=display.data_window)
plot(exportAnalysisData ? (bullishCvdDivergence ? 1 : bearishCvdDivergence ? -1 : 0) : na, "AN CVD Divergence Flag", display=display.data_window)
plot(exportAnalysisData ? (trendBias == "UP" ? 1 : trendBias == "DOWN" ? -1 : 0) : na, "AN HTF Trend (1 up / -1 down)", display=display.data_window)

alertcondition(volumeThresholdAlert, "Relative institutional volume spike", "Volume exceeded the configured local SMA multiplier on {{ticker}}.")
alertcondition(corridorTouchAlert, "H4 corridor touch", "Price touched the H4 statistical corridor on {{ticker}}.")
alertcondition(absorptionAlert, "Volume spike and price absorption", "Concurrent buy/sell volume spike with price absorption detected on {{ticker}}.")
alertcondition(internalBullishChoch, "LTF bullish internal CHoCH", "Bullish internal structure shifted after a sell-side liquidity sweep on {{ticker}}.")
alertcondition(internalBearishChoch, "LTF bearish internal CHoCH", "Bearish internal structure shifted after a buy-side liquidity sweep on {{ticker}}.")
alertcondition(isPotentialReversal, "WHEEL Buy / Reversal Alignment", "Institutional bullish trend shift aligned after a sell-side liquidity sweep on {{ticker}}.")
alertcondition(isPotentialBearishReversal, "WHEEL Sell / Bearish Reversal Alignment", "Institutional top-side reversal confirmed by aggressive negative Delta after a high-volume buy-side liquidity sweep on {{ticker}}.")
alertcondition(bullishCvdDivergence, "Bullish CVD divergence", "Bullish CVD divergence: price made a lower low while CVD made a higher low on {{ticker}}.")
alertcondition(bearishCvdDivergence, "Bearish CVD divergence", "Bearish CVD divergence: price made a higher high while CVD made a lower high on {{ticker}}.")
alertcondition(institutionalAccumulation, "Institutional Accumulation", "Institutional Accumulation Detected! Massive OI Influx under limit absorption. Potential explosive move brewing.")
alertcondition(aggressiveShortSqueeze, "Aggressive Short Squeeze", "Short Squeeze Active! Price driving up by forced short liquidations. High momentum warning.")
alertcondition(aggressiveLongSqueeze, "Aggressive Long Squeeze", "Long Squeeze Active! Price driving down by forced long liquidations. High downside momentum warning.")
alertcondition(isShortSqueezeCompleted and barstate.isconfirmed, "Short Squeeze Completed", "A buy-side liquidity sweep was rejected with high volume and negative Delta. Target active sell-side liquidity.")
alertcondition(isLongSqueezeCompleted and barstate.isconfirmed, "Long Squeeze Completed", "A sell-side liquidity sweep was rejected with high volume and positive Delta. Target active buy-side liquidity.")
alertcondition(preSweepBearHighRisk, "Pre-sweep Short Squeeze risk", "High KNN confidence for a Short Squeeze near the active bearish squeeze level on {{ticker}}.")
alertcondition(preSweepBullHighRisk, "Pre-sweep Long Squeeze risk", "High KNN confidence for a Long Squeeze near the active bullish squeeze level on {{ticker}}.")

if bearishBos
    lastStructuralLow := na

// Equal levels outrank high-volume levels, which outrank normal pivots; distance resolves ties.
float forecastTarget = na
int bestPriority = -1
float bestDistance = na
float swingHigh = ta.highest(high, 20)
float swingLow = ta.lowest(low, 20)
float swingRange = swingHigh - swingLow
float fibCapPrice = swingHigh - swingRange * 0.618
float fibCapPriceBull = swingLow + swingRange * 0.618
float targetDirectionOffset = ta.atr(14) * 0.5
bool confirmedLiveBullishCvdPulse = barstate.isconfirmed and liveBullishCvdDivergencePulse
bool confirmedLiveBearishCvdPulse = barstate.isconfirmed and liveBearishCvdDivergencePulse
bool bullishSweep = (sslSwept or aggressiveBullishReversalPulse or confirmedLiveBullishCvdPulse) and not (bslSwept or aggressiveBearishReversalPulse or confirmedLiveBearishCvdPulse)
bool bearishSweep = (bslSwept or aggressiveBearishReversalPulse or confirmedLiveBearishCvdPulse) and not (sslSwept or aggressiveBullishReversalPulse or confirmedLiveBullishCvdPulse)
bool freshWhaleBuy = insideBullishOb and isWhaleBuyVolume and deltaPercent > 0 and totalVolumeUsdt > totalVolumeSma and not isPotentialBearishReversal
bool recentBullishMomentum = strongBullishClose or (deltaPercent[1] >= momentumDeltaThreshold and cmfValue[1] >= momentumCmfThreshold) or (deltaPercent[2] >= momentumDeltaThreshold and cmfValue[2] >= momentumCmfThreshold)
bool bullishSwingBreakout = not na(lastStructuralHigh) and close > lastStructuralHigh
bool bullishMomentumContext = freshWhaleBuy or recentBullishMomentum or bullishSwingBreakout
bool counterTrendBearSweep = useTrendMomentumFilter and bearishSweep and bullishMomentumContext and not aggressiveBearishReversalPulse and not confirmedLiveBearishCvdPulse
bool bullMetricsConfirm = deltaPercent > 0 or cmfValue > 0 or (cmfValue > cmfValue[1] and cmfValue[1] < 0)
bool bullSweepFailed = bullishSweep and not aggressiveBullishReversalPulse and not confirmedLiveBullishCvdPulse and ((deltaPercent <= negativeDeltaThreshold and cmfValue < 0) or (requireBullConfirmation and not bullMetricsConfirm))
bool reversalToBear = targetCancelled and cancelledTargetDirection == 1
bool reversalToBull = targetCancelled and cancelledTargetDirection == -1
bool needsUpsideTarget = (bullishSweep and not bullSweepFailed) or reversalToBull or counterTrendBearSweep
bool needsDownsideTarget = (bearishSweep and not counterTrendBearSweep) or bullSweepFailed or reversalToBear
string requestedTrend = needsUpsideTarget and not needsDownsideTarget ? "BULL" : needsDownsideTarget and not needsUpsideTarget ? "BEAR" : "NONE"
bool whaleSellEvent = insideBearishOb and isWhaleSellVolume and deltaPercent < 0 and totalVolumeUsdt > totalVolumeSma
bool freshWhaleBuyAgainstBearTarget = freshWhaleBuy and activeTrend == "BEAR"
bool freshWhaleSellAgainstBullTarget = whaleSellEvent and activeTrend == "BULL"
if barstate.isconfirmed
    if requestedTrend == "BEAR"
        whaleBuyRecoveryActive := false
    if requestedTrend == "BULL"
        whaleSellRecoveryActive := false
    if freshWhaleBuyAgainstBearTarget
        whaleBuyRecoveryActive := true
        whaleSellRecoveryActive := false
    if freshWhaleSellAgainstBullTarget
        whaleSellRecoveryActive := true
        whaleBuyRecoveryActive := false
bool alertBullishMomentum = barstate.isconfirmed and counterTrendBearSweep
bool alertWhaleSell = barstate.isconfirmed and whaleSellEvent

// Only one forecast can be active. A fresh directional event replaces the prior forecast immediately.
if requestedTrend != "NONE" and targetActive
    supersededOriginBar := targetOriginBar
    array.push(supersededTargetBars, targetOriginBar)
    array.push(supersededTargetOutcomes, activeTrend == "BEAR" ? "SUP -> BEAR MOM" : "SUP -> BULL MOM")
    if array.size(supersededTargetBars) > 20
        array.shift(supersededTargetBars)
        array.shift(supersededTargetOutcomes)
    line.delete(targetLine)
    targetLine := na
    label.delete(targetLabel)
    targetLabel := na
    targetActive := false
    activeTarget := na
    targetDirection := 0
    activeTrend := "NONE"
    targetInvalidationLevel := na
    targetTracksSweepOutcome := false

zoneCount := array.size(zones)
if requestedTrend != "NONE" and zoneCount > 0
    for zoneIndex = 0 to zoneCount - 1
        LiquidityZone zone = array.get(zones, zoneIndex)
        bool correctSide = requestedTrend == "BULL" ? zone.isBsl and zone.level > close : not zone.isBsl and zone.level < close
        if zone.active and correctSide
            int priority = zonePriority(zone)
            float distance = math.abs(zone.level - close)
            if priority > bestPriority or (priority == bestPriority and (na(bestDistance) or distance < bestDistance))
                bestPriority := priority
                bestDistance := distance
                forecastTarget := zone.level

if requestedTrend == "BEAR" and not na(forecastTarget) and forecastTarget < fibCapPrice
    forecastTarget := fibCapPrice
else if requestedTrend == "BULL" and not na(forecastTarget) and forecastTarget > fibCapPriceBull
    forecastTarget := fibCapPriceBull
if requestedTrend == "BEAR" and not na(forecastTarget) and forecastTarget >= close
    forecastTarget := low - targetDirectionOffset
else if requestedTrend == "BULL" and not na(forecastTarget) and forecastTarget <= close
    forecastTarget := high + targetDirectionOffset

float targetDistancePercent = not na(forecastTarget) ? math.abs(close - forecastTarget) / close * 100 : na
bool targetIsDistant = not na(forecastTarget) and (targetDistancePercent > maxTargetDistancePercent or (useAtrDistanceFilter and math.abs(close - forecastTarget) > atrValue * atrDistanceMultiplier))
if targetIsDistant
    forecastTarget := na

string barSignal = ""
if bullSweepFailed
    barSignal := "SWEEP FAIL -> DOWN"
if reversalToBear
    barSignal := "REVERSAL"
if reversalToBull
    barSignal := "REVERSAL"
if needsUpsideTarget
    barSignal := counterTrendBearSweep ? "BULL MOM -> UP" : "BULL SWEEP"
    if reversalToBull
        barSignal := "REVERSAL"
    if not na(forecastTarget)
        barSignal += reversalToBull ? " -> BULL TGT: " + str.tostring(forecastTarget, format.mintick) : " -> BULL TGT: " + str.tostring(forecastTarget, format.mintick)
        if not na(targetLine)
            line.delete(targetLine)
        label.delete(targetLabel)
        targetLine := line.new(bar_index, forecastTarget, bar_index + 1, forecastTarget, xloc=xloc.bar_index, extend=extend.right, color=color.yellow, width=2)
        targetLabel := na
        activeTarget := forecastTarget
        targetDirection := 1
        targetActive := true
        activeTrend := "BULL"
        targetOriginBar := bar_index
        targetOriginSignal := barSignal
        targetInvalidationLevel := low
        targetTracksSweepOutcome := true
    else
        barSignal += reversalToBull ? " -> BULL TGT DISTANT" : " -> TGT DISTANT"
if needsDownsideTarget
    barSignal := reversalToBear ? "REVERSAL" : bullSweepFailed ? "SWEEP FAIL -> DOWN" : "BEAR SWEEP"
    if not na(forecastTarget)
        barSignal += reversalToBear ? " -> BEAR TGT: " + str.tostring(forecastTarget, format.mintick) : " -> BEAR TGT: " + str.tostring(forecastTarget, format.mintick)
        if not na(targetLine)
            line.delete(targetLine)
        label.delete(targetLabel)
        targetLine := line.new(bar_index, forecastTarget, bar_index + 1, forecastTarget, xloc=xloc.bar_index, extend=extend.right, color=color.yellow, width=2)
        targetLabel := na
        activeTarget := forecastTarget
        targetDirection := -1
        targetActive := true
        activeTrend := "BEAR"
        targetOriginBar := bar_index
        targetOriginSignal := barSignal
        targetInvalidationLevel := high
        targetTracksSweepOutcome := true
    else
        barSignal += reversalToBear ? " -> BEAR TGT DISTANT" : " -> TGT DISTANT"

// A confirmed bearish structural break targets the strongest active bullish block below price.
bool bearishContinuation = barstate.isconfirmed and (bearishBos or bearishChoch)
float continuationTarget = na
float bestObPower = -1.0
int bestObTouches = -1
float bestObDistance = na
bool bearishStructureLabelDrawn = false
bool bearObTargetEstablished = false
if bearishContinuation
    bullishBlockCount := array.size(bullishObStack)
    if bullishBlockCount > 0
        for blockIndex = 0 to bullishBlockCount - 1
            BullishOrderBlock block = array.get(bullishObStack, blockIndex)
            bool validSupport = block.active and block.top < close
            float distance = close - block.top
            if validSupport and (block.power > bestObPower or (block.power == bestObPower and (block.touches > bestObTouches or (block.touches == bestObTouches and (na(bestObDistance) or distance < bestObDistance)))))
                bestObPower := block.power
                bestObTouches := block.touches
                bestObDistance := distance
                continuationTarget := block.top
    if not na(continuationTarget)
        if targetActive
            supersededOriginBar := targetOriginBar
            array.push(supersededTargetBars, targetOriginBar)
            array.push(supersededTargetOutcomes, "SUP -> BEAR MOM")
            if array.size(supersededTargetBars) > 20
                array.shift(supersededTargetBars)
                array.shift(supersededTargetOutcomes)
            line.delete(targetLine)
            label.delete(targetLabel)
        targetLine := line.new(bar_index, continuationTarget, bar_index + 1, continuationTarget, xloc=xloc.bar_index, extend=extend.right, color=color.yellow, width=2)
        targetLabel := na
        activeTarget := continuationTarget
        targetDirection := -1
        targetActive := true
        activeTrend := "BEAR"
        targetOriginBar := bar_index
        targetOriginSignal := "BEAR TARGET: OB"
        targetInvalidationLevel := high
        targetTracksSweepOutcome := false
        barSignal := targetOriginSignal
        bearObTargetEstablished := true
        if showChochLabels
            float baseLabelOffset = labelCollisionOffset
            float labelOffset = isPotentialBearishReversal ? baseLabelOffset * 3.0 : baseLabelOffset
            float labelPrice = high + labelOffset
            bool labelWouldOverlap = not na(lastStructureLabelPrice) and not na(lastStructureLabelBar) and bar_index - lastStructureLabelBar <= 10 and math.abs(labelPrice - lastStructureLabelPrice) < labelOffset
            if labelWouldOverlap
                labelPrice := lastStructureLabelPrice + labelOffset
            string structureSignalName = bearishBos ? "Bear BOS" : "Bear CHoCH"
            structureSignalName := internalBearishChoch ? structureSignalName + " + LTF Bear CHoCH" : structureSignalName
            if buyVolume > sellVolume * 1.5
                plotBearTrapSquare := true
            globalBarStructureText := structureSignalName
            lastStructureLabelPrice := labelPrice
            lastStructureLabelBar := bar_index
            bearishStructureLabelDrawn := true

if barstate.isconfirmed and heavySellingPressure and bearishContinuation and not bearishStructureLabelDrawn
    float heavySellLabelPrice = high + labelCollisionOffset
    string heavySellStructureName = (bearishBos ? "Bear BOS" : "Bear CHoCH") + " | EXTREME SELL"
    globalBarStructureText := heavySellStructureName
    lastStructureLabelPrice := heavySellLabelPrice
    lastStructureLabelBar := bar_index
    bearishStructureLabelDrawn := true

if internalBullishChoch and not bearObTargetEstablished
    barSignal := barSignal == "" ? "LTF BULL CHoCH -> EARLY ENTRY" : barSignal + " | LTF BULL CHoCH"
if internalBearishChoch and not bearObTargetEstablished
    barSignal := barSignal == "" ? "LTF BEAR CHoCH -> EARLY ENTRY" : barSignal + " | LTF BEAR CHoCH"
if showChochLabels and internalBullishChoch
    if sellVolume > buyVolume * 1.5
        plotBullTrapSquare := true
    globalBarStructureText := "LTF Bull CHoCH"
if showChochLabels and internalBearishChoch and not bearishStructureLabelDrawn and not drawBearishProbabilityLabel
    if buyVolume > sellVolume * 1.5
        plotBearTrapSquare := true
    globalBarStructureText := "LTF Bear CHoCH"

// Priority ranking: INSTITUTIONAL PURGE > INDUCEMENT TRAP > standard liquidity SWEEP.
// A higher-priority event instantly tears down any lower-priority forecast still on the chart.
// (Pine functions cannot reassign global-scope variables, so the teardown is inlined at each call site.)
bool isLongInducementTrap = false
bool isShortInducementTrap = false
if barstate.isconfirmed and not na(trappedLongsIcebergLevel)
    if trappedLongsOriginBar == targetOriginBar and targetDirection == 1
        trappedLongsTargetLevel := activeTarget
    int longTrapAge = bar_index - trappedLongsOriginBar
    if longTrapAge > 5 or (not na(trappedLongsTargetLevel) and high >= trappedLongsTargetLevel)
        trappedLongsIcebergLevel := na
        trappedLongsOriginBar := na
        trappedLongsTargetLevel := na
        trappedLongsProbabilityText := ""
    else if longTrapAge >= 1 and low < trappedLongsIcebergLevel
        isLongInducementTrap := true
        if targetActive
            supersededOriginBar := targetOriginBar
            array.push(supersededTargetBars, targetOriginBar)
            array.push(supersededTargetOutcomes, activeTrend == "BEAR" ? "SUP -> BEAR MOM" : "SUP -> BULL MOM")
            if array.size(supersededTargetBars) > 20
                array.shift(supersededTargetBars)
                array.shift(supersededTargetOutcomes)
            line.delete(targetLine)
            targetLine := na
            label.delete(targetLabel)
            targetLabel := na
            targetActive := false
            activeTarget := na
            targetDirection := 0
            activeTrend := "NONE"
            targetInvalidationLevel := na
            targetOriginBar := na
            targetOriginSignal := ""
            targetTracksSweepOutcome := false
        globalBarStructureText := "⚠️ LONG TRAP"
        globalBarProbabilityText := trappedLongsProbabilityText
        trappedLongsIcebergLevel := na
        trappedLongsOriginBar := na
        trappedLongsTargetLevel := na
        trappedLongsProbabilityText := ""
if barstate.isconfirmed and not na(trappedShortsIcebergLevel)
    if trappedShortsOriginBar == targetOriginBar and targetDirection == -1
        trappedShortsTargetLevel := activeTarget
    int shortTrapAge = bar_index - trappedShortsOriginBar
    if shortTrapAge > 5 or (not na(trappedShortsTargetLevel) and low <= trappedShortsTargetLevel)
        trappedShortsIcebergLevel := na
        trappedShortsOriginBar := na
        trappedShortsTargetLevel := na
        trappedShortsProbabilityText := ""
    else if shortTrapAge >= 1 and high > trappedShortsIcebergLevel
        isShortInducementTrap := true
        if targetActive
            supersededOriginBar := targetOriginBar
            array.push(supersededTargetBars, targetOriginBar)
            array.push(supersededTargetOutcomes, activeTrend == "BEAR" ? "SUP -> BEAR MOM" : "SUP -> BULL MOM")
            if array.size(supersededTargetBars) > 20
                array.shift(supersededTargetBars)
                array.shift(supersededTargetOutcomes)
            line.delete(targetLine)
            targetLine := na
            label.delete(targetLabel)
            targetLabel := na
            targetActive := false
            activeTarget := na
            targetDirection := 0
            activeTrend := "NONE"
            targetInvalidationLevel := na
            targetOriginBar := na
            targetOriginSignal := ""
            targetTracksSweepOutcome := false
        globalBarStructureText := "⚠️ SHORT TRAP"
        globalBarProbabilityText := trappedShortsProbabilityText
        trappedShortsIcebergLevel := na
        trappedShortsOriginBar := na
        trappedShortsTargetLevel := na
        trappedShortsProbabilityText := ""
if highVolumePurgeEvent
    if targetActive
        supersededOriginBar := targetOriginBar
        array.push(supersededTargetBars, targetOriginBar)
        array.push(supersededTargetOutcomes, activeTrend == "BEAR" ? "SUP -> BEAR MOM" : "SUP -> BULL MOM")
        if array.size(supersededTargetBars) > 20
            array.shift(supersededTargetBars)
            array.shift(supersededTargetOutcomes)
        line.delete(targetLine)
        targetLine := na
        label.delete(targetLabel)
        targetLabel := na
        targetActive := false
        activeTarget := na
        targetDirection := 0
        activeTrend := "NONE"
        targetInvalidationLevel := na
        targetOriginBar := na
        targetOriginSignal := ""
        targetTracksSweepOutcome := false
    globalBarStructureText := "🔥 INST PURGE"
    globalBarProbabilityText := "Volume: $" + compactUsdt(totalVolumeUsdt)
// Consolidate the dashboard Signal column onto the same winning event so a superseded Sweep
// string cannot linger on the identical bar_index as the higher-priority Trap/Purge text.
if barstate.isconfirmed and (isLongInducementTrap or isShortInducementTrap or highVolumePurgeEvent)
    barSignal := globalBarStructureText

// The compatibility switch remains disabled so every candle retains its AI score/matrix annotation.
bool suppressMicroRatingNoise = false
var label dynamicLiveAI = na
if barstate.isconfirmed
    label.new(x=bar_index, y=smoothTema, text=deltaTextStr, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.white, size=size.normal, force_overlay=true)
if barstate.islast
    label.delete(dynamicLiveAI)
    if not barstate.isconfirmed
        dynamicLiveAI := label.new(x=bar_index, y=smoothTema, text=deltaTextStr, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.white, size=size.normal, force_overlay=true)

bool isInstitutionalWhaleEvent = str.contains(candleRatingStr, "WW") or ((str.contains(candleRatingStr, "AH") or str.contains(candleRatingStr, "AM")) and roundedScoreChange >= 7 and buyVolumeUsdt + sellVolumeUsdt >= 500000000)
bool allowBullishLabel = isTemaLime and buyVolumeUsdt >= sellVolumeUsdt
bool forceInstitutionalOverride = isInstitutionalWhaleEvent and buyVolumeUsdt >= sellVolumeUsdt
// A qualified reversal, an active Bear continuation, or a high-probability/Trap setup must never
// be filtered out purely because the TEMA bias line is the "wrong" color for its direction.
bool reversalProbabilityPulse = drawBullishProbabilityLabel or drawBearishProbabilityLabel
bool bypassTrendFilter = (reversalProbabilityPulse and reversalProbability >= 75.0) or isLongInducementTrap or isShortInducementTrap
bool hasActiveTradingRule = (globalBarStructureText != "" and globalBarStructureText != "NEUTRAL" and globalBarStructureText != "-" and (allowBullishLabel or bearishContinuation or drawBearishProbabilityLabel)) or (globalBarProbabilityText != "" and globalBarProbabilityText != "NEUTRAL" and globalBarProbabilityText != "-" and (allowBullishLabel or drawBearishProbabilityLabel or drawBullishProbabilityLabel)) or reversalProbabilityPulse or forceInstitutionalOverride or sslSwept or bslSwept or bypassTrendFilter
if barstate.isconfirmed and not na(activeBearishSignalLabel) and close < activeBearishSignalLow
    label.set_color(activeBearishSignalLabel, color.new(color.gray, 80))
    label.set_textcolor(activeBearishSignalLabel, color.new(color.gray, 50))
    activeBearishSignalLabel := na
    activeBearishSignalLow := na
    activeBearishSignalBar := na
if barstate.isconfirmed and hasActiveTradingRule
    bool isInstitutionalPurgeLabel = globalBarStructureText == "🔥 INST PURGE"
    bool isConfirmedPivotLow = not na(pivotLow)
    bool isConfirmedPivotHigh = not na(pivotHigh)
    bool isAnySweep = sslSwept or bslSwept
    string currentProbabilityText = reversalProbabilityText + (drawBearishProbabilityLabel ? " BEAR REV" : drawBullishProbabilityLabel ? " BULL REV" : " STRONG")
    string finalChartText = f_mergeChartTexts(globalBarStructureText, globalBarProbabilityText, currentProbabilityText, buyVolumeUsdt, sellVolumeUsdt, isConfirmedPivotLow, isConfirmedPivotHigh, isAnySweep, institutionalAccumulation, volumeAccumulationStrength)
    bool forceBearishLabel = str.contains(finalChartText, "Bear") or str.contains(finalChartText, "BEAR") or drawBearishProbabilityLabel or bearishContinuation or bslSwept
    bool isFlowDirectionValid = forceBearishLabel ? sellVolumeUsdt >= buyVolumeUsdt : buyVolumeUsdt >= sellVolumeUsdt
    bool hasExplicitStructureText = globalBarStructureText != "" and globalBarStructureText != "NEUTRAL" and globalBarStructureText != "-"
    bool isGenericFlowLabel = not hasExplicitStructureText and (isAnySweep or (not isConfirmedPivotLow and not isConfirmedPivotHigh))
    bool isAccumulationOnlyLabel = not hasExplicitStructureText and not isAnySweep and not isConfirmedPivotLow and not isConfirmedPivotHigh and not str.contains(finalChartText, "BULL REV") and not str.contains(finalChartText, "BEAR REV")
    // Locked dashboard events (qualified reversals, Inducement Traps, the aiScore/Trap bypass) must
    // stay in sync with the table: ambiguous flow can never wipe or suppress them here.
    bool isLockedStructuralEvent = bypassTrendFilter or reversalProbabilityPulse
    bool isBullishFlowBlocked = not forceBearishLabel and not isLockedStructuralEvent and buyVolumeUsdt < sellVolumeUsdt
    if isBullishFlowBlocked
        // Section 8 fallback: resolve to a clean SWEEP / VOL ACCUM placeholder derived from the
        // dominant flow instead of suppressing the element outright.
        globalBarStructureText := ""
        globalBarProbabilityText := ""
        finalChartText := f_mergeChartTexts(globalBarStructureText, globalBarProbabilityText, currentProbabilityText, buyVolumeUsdt, sellVolumeUsdt, isConfirmedPivotLow, isConfirmedPivotHigh, isAnySweep, institutionalAccumulation, volumeAccumulationStrength)
        hasExplicitStructureText := false
        isGenericFlowLabel := isAnySweep or (not isConfirmedPivotLow and not isConfirmedPivotHigh)
        isAccumulationOnlyLabel := not isAnySweep and not isConfirmedPivotLow and not isConfirmedPivotHigh and not str.contains(finalChartText, "BULL REV") and not str.contains(finalChartText, "BEAR REV")
        forceBearishLabel := sellVolumeUsdt > buyVolumeUsdt
        isFlowDirectionValid := true
    bool shouldEmitEventLabel = (forceInstitutionalOverride or isLockedStructuralEvent or not isGenericFlowLabel or isFlowDirectionValid) and (not isAccumulationOnlyLabel or institutionalAccumulation)
    bool isBearishDirection = isInstitutionalPurgeLabel ? isShortSqueezeCompleted : forceBearishLabel ? true : isShortInducementTrap ? true : isLongInducementTrap ? false : false
    if not isBearishDirection and str.contains(globalBarProbabilityText, "BEAR REV")
        globalBarProbabilityText := str.replace(globalBarProbabilityText, "BEAR REV", "BULL REV")
        finalChartText := f_mergeChartTexts(globalBarStructureText, globalBarProbabilityText, currentProbabilityText, buyVolumeUsdt, sellVolumeUsdt, isConfirmedPivotLow, isConfirmedPivotHigh, isAnySweep, institutionalAccumulation, volumeAccumulationStrength)
    bool isNewBearishSignal = isBearishDirection and (drawBearishProbabilityLabel or (isShortInducementTrap and not isShortInducementTrap[1]))
    if shouldEmitEventLabel
        color finalChartLabelColor = isInstitutionalPurgeLabel ? color.rgb(190, 24, 93) : isBearishDirection ? color.orange : color.teal
        // Each confirmed-bar event is its own permanent historical annotation. Only a genuine
        // target teardown (trap/purge superseding an active target) deletes targetLabel directly;
        // this general pipeline must never wipe prior bars' labels off the chart.
        if isBearishDirection
            label emittedLabel = label.new(bar_index, high + bearishLabelOffset, finalChartText, yloc=yloc.price, style=label.style_label_down, color=finalChartLabelColor, textcolor=color.white, size=size.tiny)
            if barstate.isconfirmed and isNewBearishSignal
                if not na(activeBearishSignalLabel) and activeBearishSignalBar != bar_index
                    label.set_color(activeBearishSignalLabel, color.new(color.gray, 80))
                    label.set_textcolor(activeBearishSignalLabel, color.new(color.gray, 50))
                activeBearishSignalLabel := emittedLabel
                activeBearishSignalLow := low
                activeBearishSignalBar := bar_index
        else
            label.new(bar_index, low - labelCollisionOffset, finalChartText, yloc=yloc.price, style=label.style_label_up, color=finalChartLabelColor, textcolor=color.white, size=size.tiny)
globalBarStructureText := ""
globalBarProbabilityText := ""

var table infoPanel = table.new(position.bottom_right, 8, 11, frame_color=color.new(chart.fg_color, 60), frame_width=1, border_color=color.new(chart.fg_color, 80), border_width=1)
var table h4StatsPanel = table.new(position.top_right, 2, 6, frame_color=color.new(chart.fg_color, 60), frame_width=1, border_color=color.new(chart.fg_color, 80), border_width=1)
if targetActive and not na(targetLabel)
    label.set_x(targetLabel, bar_index + 10)
    label.set_y(targetLabel, activeTarget)
if barstate.islast or barstate.islastconfirmedhistory
    float displayedH4HighDist = na(lastSignalH4HighDist) ? pctDropFromHigh : lastSignalH4HighDist
    float displayedH4LowDist = na(lastSignalH4LowDist) ? pctRiseFromLow : lastSignalH4LowDist
    bool liveInstitutionalMomentum = heavySellingPressure or heavyBuyingPressure
    bool liveReversalSetup = bullishProbabilityLabel or bearishProbabilityLabel or liveInstitutionalMomentum
    float displayedProbability = reversalProbabilityFixed
    string displayedBias = ""
    string displayedDirection = liveInstitutionalMomentum ? (heavySellingPressure ? " BEAR MOM" : " BULL MOM") : liveReversalSetup ? (bearishProbabilityLabel ? " BEAR REV" : " BULL REV") : not na(lastSignalProbability) ? lastSignalDirectionStr : ""
    bool highProbabilityReversal = displayedProbability > 75
    string probabilityText = str.tostring(displayedProbability, "#.0") + "%" + displayedBias + displayedDirection
    color probabilityBackground = highProbabilityReversal ? color.new(statCorridorColor, 0) : displayedProbability >= 50 ? color.new(color.teal, 55) : color.new(color.black, 25)
    table.cell(h4StatsPanel, 0, 0, "H4 MAP", text_color=color.white, text_size=size.small, bgcolor=color.black)
    table.cell(h4StatsPanel, 1, 0, "Live", text_color=color.white, text_size=size.small, bgcolor=color.black)
    string h4DistanceText = (na(displayedH4HighDist) ? "-" : str.tostring(displayedH4HighDist, "#.0") + "%") + " / " + (na(displayedH4LowDist) ? "-" : str.tostring(displayedH4LowDist, "#.0") + "%")
    table.cell(h4StatsPanel, 0, 1, "H4 Δ", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 1, 1, h4DistanceText, text_color=statCorridorColor, text_size=size.tiny, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 0, 2, "REV %", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 1, 2, probabilityText, text_color=highProbabilityReversal ? color.black : chart.fg_color, text_size=size.tiny, bgcolor=probabilityBackground)
    string cleanTrend = isTemaLime ? "UPTREND" : isTemaFuchsia ? "DOWNTREND" : "CONSOLIDATION"
    string cleanSessionText = na(activeSessionOpenPrice) ? "RANGE" : close >= activeSessionOpenPrice ? "BULLISH" : "BEARISH"
    string longLondonText = londonManipulationText == "LM: BEAR FAKEOUT" ? "⚠️ LONDON BEAR FAKEOUT DETECTED" : londonManipulationText == "LM: BULL FAKEOUT" ? "🚀 LONDON BULL FAKEOUT DETECTED" : londonManipulationText == "LM: SWEEP IN PROGRESS" ? "⚡ ASIA HIGH/LOW SWEEP ACTIVE" : "[NO MANIPULATION]"
    string combinedTrendText = cleanTrend + " | " + cleanSessionText + " | " + longLondonText
    bool isHtfBull = cleanTrend == "UPTREND"
    bool isHtfBear = cleanTrend == "DOWNTREND"
    bool isSessionBull = str.contains(sessionBiasText, "BULL")
    bool isSessionBear = str.contains(sessionBiasText, "BEAR")
    color dynamicCellBg = color.new(color.gray, 50)
    if isHtfBull
        dynamicCellBg := isSessionBull ? color.new(color.green, 20) : color.new(color.green, 65)
    else if isHtfBear
        dynamicCellBg := isSessionBear ? color.new(color.red, 20) : color.new(color.red, 65)
    table.cell(h4StatsPanel, 0, 3, "HTF", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 1, 3, combinedTrendText, text_color=color.white, text_size=size.tiny, bgcolor=dynamicCellBg, width=35)
    string cvdDivergenceText = recentBearishCvdDivergence ? "BEAR DIV" : recentBullishCvdDivergence ? "BULL DIV" : "-"
    color cvdDivergenceColor = recentBearishCvdDivergence ? sslColor : recentBullishCvdDivergence ? bslColor : chart.fg_color
    color relativeVolumeColor = na(relativeVolume) ? chart.fg_color : relativeVolume >= 1.5 ? bslColor : relativeVolume < 1.0 ? color.gray : chart.fg_color
    string relativeVolumeText = na(relativeVolume) ? "-" : str.tostring(relativeVolume, "#.0") + "x"
    table.cell(h4StatsPanel, 0, 4, "CVD/RVOL", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 1, 4, cvdDivergenceText + " / " + relativeVolumeText, text_color=cvdDivergenceText == "-" ? relativeVolumeColor : cvdDivergenceColor, text_size=size.tiny, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 0, 5, "SQ Δ", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25))
    table.cell(h4StatsPanel, 1, 5, bearDistStr + " | " + bullDistStr, text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25))
    int dashboardRowCount = 10
    int dashboardBarWidth = 5
    int dashboardVolumeWidth = 8
    int dashboardTotalWidth = 8
    int dashboardDeltaWidth = 8
    int dashboardCmfWidth = 8
    int dashboardOiWidth = 10
    int dashboardSignalWidth = 37
    table.cell(infoPanel, 0, 0, "Bar", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=dashboardBarWidth, text_halign=text.align_center, text_valign=text.align_center)
    table.cell(infoPanel, 1, 0, "BUY", text_color=bslColor, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=dashboardVolumeWidth, text_halign=text.align_center, text_valign=text.align_center)
    table.cell(infoPanel, 2, 0, "SELL", text_color=tableSellColor, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=dashboardVolumeWidth, text_halign=text.align_center, text_valign=text.align_center)
    table.cell(infoPanel, 3, 0, "TOTAL", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=dashboardTotalWidth, text_halign=text.align_center, text_valign=text.align_center)
    table.cell(infoPanel, 4, 0, "DELTA", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=dashboardDeltaWidth, text_halign=text.align_center, text_valign=text.align_center)
    table.cell(infoPanel, 5, 0, "CMF", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=dashboardCmfWidth, text_halign=text.align_center, text_valign=text.align_center)
    table.cell(infoPanel, 6, 0, "OI Δ", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=dashboardOiWidth, text_halign=text.align_center, text_valign=text.align_center)
    table.cell(infoPanel, 7, 0, "SIGNAL", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 15), width=dashboardSignalWidth, text_halign=text.align_center, text_valign=text.align_center)
    for candleIndex = 0 to dashboardRowCount - 1
        int row = candleIndex + 1
        bool hasCandle = not na(close[candleIndex])
        int candleBar = bar_index - candleIndex
        float candleBuy = dashboardBuyVolume[candleIndex]
        float candleSell = dashboardSellVolume[candleIndex]
        float candleTotal = totalVolumeUsdt[candleIndex]
        float candleDelta = deltaPercent[candleIndex]
        float candleCmf = cmfValue[candleIndex]
        bool isRedCandle = close[candleIndex] < open[candleIndex]
        bool isGreenCandle = close[candleIndex] > open[candleIndex]
        bool candleInsideBullishOb = insideBullishOb[candleIndex]
        bool candleInsideBearishOb = insideBearishOb[candleIndex]
        bool candlePotentialReversal = hasCandle and isPotentialReversal[candleIndex]
        bool candlePotentialBearishReversal = hasCandle and isPotentialBearishReversal[candleIndex]
        bool candleInternalBullishChoch = hasCandle and internalBullishChoch[candleIndex]
        bool candleInternalBearishChoch = hasCandle and internalBearishChoch[candleIndex]
        bool candleInstitutionalVolumeSpike = hasCandle and institutionalVolumeSpike[candleIndex]
        bool candleNoDemandBearishReversal = hasCandle and noDemandBearishReversal[candleIndex]
        bool candleBullishCvdDiv = hasCandle and bullishCvdDivergence[candleIndex]
        bool candleBearishCvdDiv = hasCandle and bearishCvdDivergence[candleIndex]
        bool candleLiveBullishCvdDivergence = candleIndex == 0 and liveBullishCvdDivergence
        bool candleLiveBearishCvdDivergence = candleIndex == 0 and liveBearishCvdDivergence
        string candleMidRangeContext = hasCandle ? midRangeContextText[candleIndex] : ""
        bool candleTemaOrange = hasCandle and isTemaOrange[candleIndex]
        int candleChopLean = hasCandle ? chopLean[candleIndex] : 0
        string candleChopLeanText = candleTemaOrange ? candleChopLean == 1 ? "CONSOL (ACC)" : candleChopLean == -1 ? "CONSOL (DIST)" : "CONSOL (NEUT)" : ""
        float candleReversalProbability = reversalProbability[candleIndex]
        // The resistance cap is live-state only; never retroactively replace C2-C10 history.
        bool candleSellSideBiasLocked = candleIndex == 0 and sellSideBiasLocked
        bool whaleBuy = hasCandle and candleInsideBullishOb and isWhaleBuyVolume[candleIndex] and candleDelta > 0 and candleTotal > totalVolumeSma[candleIndex]
        bool whaleSell = hasCandle and candleInsideBearishOb and isWhaleSellVolume[candleIndex] and candleDelta < 0 and candleTotal > totalVolumeSma[candleIndex]
        bool bullishObTestingWaiting = hasCandle and not candleSellSideBiasLocked and candleInsideBullishOb and candleDelta <= 0
        bool bearishObTestingWaiting = hasCandle and candleInsideBearishOb and candleDelta >= 0
        bool absorptionBuy = hasCandle and isRedCandle and candleDelta > 0 and candleCmf < 0.02 and buyRatio[candleIndex] <= 0.40 and isVolumeClimax[candleIndex]
        bool absorptionSell = hasCandle and isGreenCandle and candleDelta < 0 and candleCmf > -0.02 and buyRatio[candleIndex] >= 0.60 and isVolumeClimax[candleIndex]
        string liquiditySignal = hasCandle ? barSignal[candleIndex] : ""
        bool candleBearObTarget = candleIndex == 0 and liquiditySignal == "BEAR TARGET: OB" and not candlePotentialReversal and not candlePotentialBearishReversal
        string candleExhStatus = hasCandle ? exhDashboardStatus[candleIndex] : ""
        string internalStructureText = candleInternalBullishChoch ? "LTF BULL CHoCH" : candleInternalBearishChoch ? "LTF BEAR CHoCH" : ""
        bool liveWhaleBuyRecovery = candleIndex == 0 and (freshWhaleBuyAgainstBearTarget or whaleBuyRecoveryActive)
        bool liveWhaleSellRecovery = candleIndex == 0 and (freshWhaleSellAgainstBullTarget or whaleSellRecoveryActive)
        string lockedTargetSignal = ""
        int lockedTargetCount = array.size(lockedTargetBars)
        if lockedTargetCount > 0
            for lockedIndex = 0 to lockedTargetCount - 1
                if candleBar == array.get(lockedTargetBars, lockedIndex)
                    lockedTargetSignal := array.get(lockedTargetSignals, lockedIndex)
        bool isTargetHitRow = lockedTargetSignal != ""
        string supersededTargetOutcome = ""
        int supersededTargetCount = array.size(supersededTargetBars)
        if supersededTargetCount > 0
            for supersededIndex = 0 to supersededTargetCount - 1
                if candleBar == array.get(supersededTargetBars, supersededIndex)
                    supersededTargetOutcome := array.get(supersededTargetOutcomes, supersededIndex)
        bool isTargetCancelledRow = candleBar == cancelledOriginBar
        bool isTargetSupersededRow = supersededTargetOutcome != ""
        bool isObReachedRow = candleBar == obReachedOriginBar
        bool candleBtcDivergenceBearish = hasCandle and btc_divergence_bearish[candleIndex]
        bool candleBtcDivergenceBullish = hasCandle and btc_divergence_bullish[candleIndex]
        string btcContextText = ""
        if not suppress_smt_context
            btcContextText := candleBtcDivergenceBearish ? "⚠️ ALT WEAK (BTC RISING)" : candleBtcDivergenceBullish ? "🚀 ALT STRONG (BTC FALLING)" : ""
        string structuralLabels = candleLiveBullishCvdDivergence ? "BULL REV (CVD)" : candleLiveBearishCvdDivergence ? "BEAR REV (CVD)" : isTargetHitRow ? "TGT HIT" : isTargetCancelledRow ? "REV CANCEL" : isTargetSupersededRow ? supersededTargetOutcome : isObReachedRow ? "OB HIT / WAIT" : candlePotentialBearishReversal ? str.tostring(candleReversalProbability, "#.0") + "% BEAR REV" : candlePotentialReversal ? str.tostring(candleReversalProbability, "#.0") + "% BULL REV" : candleSellSideBiasLocked ? "SELL BIAS / BEAR OB" : candleBearObTarget ? "BEAR TGT: OB" : internalStructureText != "" ? internalStructureText : liquiditySignal != "" ? liquiditySignal : candleExhStatus != "" ? candleExhStatus : whaleBuy ? "WHALE BUY" : whaleSell ? "WHALE SELL" : liveWhaleBuyRecovery ? "WHALE BUY / ACC" : liveWhaleSellRecovery ? "WHALE SELL / DIST" : bullishObTestingWaiting ? "OB TEST (B)" : bearishObTestingWaiting ? "OB TEST (S)" : candleInstitutionalVolumeSpike ? "INST VOL" : absorptionBuy ? "AbBuyV" : absorptionSell ? "AbSellV" : candleBullishCvdDiv ? "BULL DIV" : candleBearishCvdDiv ? "BEAR DIV" : candleNoDemandBearishReversal ? "NO DEMAND" : candleMidRangeContext != "" ? candleMidRangeContext : btcContextText
        string candleSqueezeState = hasCandle ? (candleIndex == 0 ? liveC1SqueezeStatus : squeezeStatus[candleIndex]) : ""
        string candleMarketStructure = hasCandle ? liveMarketStructureSignal[candleIndex] : "NEUTRAL"
        string signalText = f_formatDashboardSignal(candleSqueezeState, structuralLabels, candleMarketStructure, candleChopLeanText)
        if candleIndex == 0
            wheelDashboardState := str.contains(signalText, "WHALE BUY") ? "BUY" : str.contains(signalText, "WHALE SELL") ? "SELL" : "NONE"
        color deltaColor = candleDelta >= 0 ? bslColor : tableSellColor
        color cmfColor = candleCmf >= 0 ? bslColor : sslColor
        bool reversalSignal = str.contains(signalText, "REVERSAL") or str.contains(signalText, " REV")
        bool bullishReversal = reversalSignal and (str.contains(signalText, "BULL") or candleDelta >= momentumDeltaThreshold)
        bool bearishReversal = reversalSignal and (str.contains(signalText, "BEAR") or candleDelta <= -momentumDeltaThreshold)
        bool bullishSignal = str.contains(signalText, "BULL MOM") or str.contains(signalText, "BULL TGT") or str.contains(signalText, "WHALE BUY")
        bool bearishSignal = str.contains(signalText, "BEAR TGT") or str.contains(signalText, "SWEEP FAIL") or str.contains(signalText, "WHALE SELL")
        bool isShortSqueezeSignal = str.contains(signalText, "SSQ")
        bool isLongSqueezeSignal = str.contains(signalText, "LSQ")
        color signalBackground = color.new(color.black, 25)
        color signalTextColor = chart.fg_color
        if isShortSqueezeSignal
            signalBackground := ssqBgColor
            signalTextColor := ssqTextColor
        else if isLongSqueezeSignal
            signalBackground := lsqBgColor
            signalTextColor := lsqTextColor
        else if isTargetHitRow
            signalBackground := color.new(color.blue, 20)
        else if isTargetCancelledRow
            signalBackground := color.new(color.orange, 20)
        else if isTargetSupersededRow
            signalBackground := color.rgb(45, 48, 52)
        else if isObReachedRow
            signalBackground := color.new(bslColor, 35)
        else if bullishObTestingWaiting
            signalBackground := color.new(color.teal, 65)
        else if bearishObTestingWaiting
            signalBackground := color.new(color.orange, 65)
        else if bullishReversal or bullishSignal
            signalBackground := color.new(#00e676, 72)
        else if bearishReversal or bearishSignal
            signalBackground := color.new(color.red, 85)
        string buyText = hasCandle ? "$" + compactDashboardUsdt(candleBuy) : "-"
        string sellText = hasCandle ? "$" + compactDashboardUsdt(candleSell) : "-"
        string totalText = hasCandle ? "$" + compactDashboardUsdt(candleTotal) : "-"
        string deltaText = hasCandle ? str.tostring(candleDelta, "#.0") + "%" : "-"
        string cmfText = hasCandle ? str.format("{0,number,#.0}%", candleCmf * 100.0) : "-"
        float historicalOiUsdtDelta = oiDeltaUsdt[candleIndex]
        float historicalOiUsdtTotal = totalOiUsdt[candleIndex]
        bool hasHistoricalOi = not na(historicalOiUsdtDelta) and not na(historicalOiUsdtTotal)
        string historicalOiText = not hasHistoricalOi ? "-" : (historicalOiUsdtDelta > 0 ? "+" : "") + compactUsdt(historicalOiUsdtDelta) + " ($" + compactUsdt(historicalOiUsdtTotal) + ")"
        color historicalOiColor = not hasHistoricalOi ? color.gray : historicalOiUsdtDelta > 0 ? bslColor : historicalOiUsdtDelta < 0 ? sslColor : chart.fg_color
        color historicalOiBackground = not hasHistoricalOi ? color.new(color.gray, 85) : historicalOiUsdtDelta > 0 ? color.new(bslColor, 85) : historicalOiUsdtDelta < 0 ? color.new(sslColor, 85) : color.new(color.black, 25)
        table.cell(infoPanel, 0, row, hasCandle ? "C" + str.tostring(candleIndex + 1) : "-", text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25), width=dashboardBarWidth, text_halign=text.align_center, text_valign=text.align_center)
        table.cell(infoPanel, 1, row, buyText, text_color=bslColor, text_size=size.tiny, bgcolor=color.new(color.black, 25), width=dashboardVolumeWidth, text_halign=text.align_center, text_valign=text.align_center)
        table.cell(infoPanel, 2, row, sellText, text_color=tableSellColor, text_size=size.tiny, bgcolor=color.new(color.black, 25), width=dashboardVolumeWidth, text_halign=text.align_center, text_valign=text.align_center)
        table.cell(infoPanel, 3, row, totalText, text_color=chart.fg_color, text_size=size.tiny, bgcolor=color.new(color.black, 25), width=dashboardTotalWidth, text_halign=text.align_center, text_valign=text.align_center)
        table.cell(infoPanel, 4, row, deltaText, text_color=deltaColor, text_size=size.tiny, bgcolor=color.new(color.black, 25), width=dashboardDeltaWidth, text_halign=text.align_center, text_valign=text.align_center)
        table.cell(infoPanel, 5, row, cmfText, text_color=cmfColor, text_size=size.tiny, bgcolor=color.new(color.black, 25), width=dashboardCmfWidth, text_halign=text.align_center, text_valign=text.align_center)
        table.cell(infoPanel, 6, row, historicalOiText, text_color=historicalOiColor, text_size=size.tiny, bgcolor=historicalOiBackground, width=dashboardOiWidth, text_halign=text.align_center, text_valign=text.align_center)
        table.cell(infoPanel, 7, row, signalText, text_color=signalTextColor, text_size=size.tiny, bgcolor=signalBackground, width=dashboardSignalWidth, text_halign=text.align_center, text_valign=text.align_center)
    wheelExecutionAlert := barstate.isconfirmed and wheelDashboardState != "NONE"
    if wheelExecutionAlert
        alert(syminfo.ticker + " (" + timeframe.period + ") - WHEEL " + wheelDashboardState + " CONFIRMED BY DASHBOARD at " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

alertcondition(wheelExecutionAlert, "WHEEL execution", "WHEEL buy or sell execution confirmed by the dashboard on {{ticker}}.")

if alertBullishMomentum
    alert(syminfo.ticker + " (" + timeframe.period + ") - BULLISH MOMENTUM Detected at price " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

if alertWhaleSell
    alert(syminfo.ticker + " (" + timeframe.period + ") - WARNING: WHALE SELL Event Confirmed at price " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

if historicalHighZoneHit and array.size(historicalSweepsHigh) > 0
    alert("🎯 BTC/ETH STATS ALERT: Price hit the Historic Reversal Zone above H4 High! Target Price: " + str.tostring(close, format.mintick) + ". Current deviation matches the historical average of " + str.tostring(avgHighSweepPercent, "#.##") + "%.", alert.freq_once_per_bar)

if historicalLowZoneHit and array.size(historicalSweepsLow) > 0
    alert("🎯 BTC/ETH STATS ALERT: Price hit the Historic Reversal Zone below H4 Low! Target Price: " + str.tostring(close, format.mintick) + ". Current deviation matches the historical average of " + str.tostring(avgLowSweepPercent, "#.##") + "%.", alert.freq_once_per_bar)

if confirmedH4Reversal
    float historicalAverage = confirmedReversalType == "High" ? avgHighSweepPercent : avgLowSweepPercent
    alert("REVERSAL CONFIRMED | Type: " + confirmedReversalType + " | Peak Penetration: " + str.tostring(maxPenetration, "#.##") + "% | Historic Average for this Asset: " + str.tostring(historicalAverage, "#.##") + "%", alert.freq_once_per_bar_close)

// ==========================================
// REVERSAL FAILURE LOGGING SYSTEM (invalidated Order Blocks)
// ==========================================
var int[] failed_times = array.new_int(0)
var float[] failed_closes = array.new_float(0)
var float[] failed_volumes = array.new_float(0)
var string[] failed_types = array.new_string(0)

// Wired to the live OB invalidation flags: a grayed-out block is a failed structural reversal.
bool is_bull_ob_invalidated = bullObInvalidatedThisBar
bool is_bear_ob_invalidated = bearObInvalidatedThisBar
bool reversal_failed = is_bull_ob_invalidated or is_bear_ob_invalidated
string failure_type = is_bull_ob_invalidated ? "Bull OB Fail" : "Bear OB Fail"

if showReversalFailureLog and reversal_failed and barstate.isconfirmed
    array.push(failed_times, time)
    array.push(failed_closes, close)
    array.push(failed_volumes, volume)
    array.push(failed_types, failure_type)
    if array.size(failed_times) > 200
        array.shift(failed_times)
        array.shift(failed_closes)
        array.shift(failed_volumes)
        array.shift(failed_types)

plotshape(showReversalFailureLog and is_bull_ob_invalidated, title="Bull OB Invalidated", style=shape.xcross, location=location.belowbar, color=color.gray, size=size.small)
plotshape(showReversalFailureLog and is_bear_ob_invalidated, title="Bear OB Invalidated", style=shape.xcross, location=location.abovebar, color=color.gray, size=size.small)

var table log_table = na
if showReversalFailureTable and na(log_table)
    log_table := table.new(position.bottom_left, 4, 6, bgcolor=color.new(color.black, 15), border_color=color.new(color.gray, 50), border_width=1)
else if not showReversalFailureTable and not na(log_table)
    table.delete(log_table)
    log_table := na

if showReversalFailureTable and not na(log_table) and (barstate.islast or barstate.islastconfirmedhistory)
    table.cell(log_table, 0, 0, "Time", text_color=color.white, text_size=size.tiny, bgcolor=color.navy)
    table.cell(log_table, 1, 0, "Type", text_color=color.white, text_size=size.tiny, bgcolor=color.navy)
    table.cell(log_table, 2, 0, "Close Price", text_color=color.white, text_size=size.tiny, bgcolor=color.navy)
    table.cell(log_table, 3, 0, "Volume", text_color=color.white, text_size=size.tiny, bgcolor=color.navy)
    int total_failures = array.size(failed_times)
    if total_failures > 0
        for i = 0 to math.min(total_failures - 1, 4)
            int idx = total_failures - 1 - i
            table.cell(log_table, 0, i + 1, str.format_time(array.get(failed_times, idx), "MM-dd HH:mm"), text_color=color.white, text_size=size.tiny)
            table.cell(log_table, 1, i + 1, array.get(failed_types, idx), text_color=array.get(failed_types, idx) == "Bull OB Fail" ? color.red : color.orange, text_size=size.tiny)
            table.cell(log_table, 2, i + 1, str.tostring(array.get(failed_closes, idx), format.mintick), text_color=color.white, text_size=size.tiny)
            table.cell(log_table, 3, i + 1, compactVolume(array.get(failed_volumes, idx)), text_color=color.white, text_size=size.tiny)

plotshape(plotBearTrapSquare, title="Bear Break Trap (Bull Abs)", style=shape.square, location=location.belowbar, color=color.new(color.green, 0), size=size.small, force_overlay=true)
plotshape(plotBullTrapSquare, title="Bull Break Trap (Bear Abs)", style=shape.square, location=location.abovebar, color=color.new(color.red, 0), size=size.small, force_overlay=true)
plotshape(isMidRangeAbsBull, title="Mid Bull Shape", style=shape.circle, location=location.belowbar, color=color.new(color.green, 30), size=size.small)
plotshape(isMidRangeAbsBear, title="Mid Bear Shape", style=shape.circle, location=location.abovebar, color=color.new(color.red, 30), size=size.small)
plotshape(hiddenBullDiv, title="Hidden Bull CVD Shape", style=shape.triangledown, location=location.belowbar, color=color.new(color.orange, 20), size=size.small)
plotshape(hiddenBearDiv, title="Hidden Bear CVD Shape", style=shape.triangleup, location=location.abovebar, color=color.new(color.orange, 20), size=size.small)

float prevBarScore = nz(aiScore[1], aiScore)
// RETROSPECTIVE 1-BAR PATTERN RECOGNITION CONTEXT
// Bar [1] is the pattern candle; bar [0] is the confirmation candle.
bool isBullBreakoutTriggered = false
bool isBearTrapTriggered = false

bool setupBullOnBar1 = close[1] > open[1] and aiScore[1] > 55.0 and math.round(aiScore[1] - prevBarScore[1]) > 10
if setupBullOnBar1 and close > low[1] and math.round(aiScore - prevBarScore) >= -10
    isBullBreakoutTriggered := true

bool setupBearOnBar1 = close[1] < open[1] and math.round(aiScore[1] - prevBarScore[1]) <= -25
if setupBearOnBar1 and close < high[1] and math.round(aiScore - prevBarScore) <= 10
    isBearTrapTriggered := true

plotshape(isBullBreakoutTriggered and barstate.isconfirmed ? low[1] - reversalLabelAtr * 0.4 : na, title="Bull AI icon", style=shape.triangleup, location=location.absolute, color=color.teal, size=size.small, offset=-1, force_overlay=true)
plotshape(isBearTrapTriggered and barstate.isconfirmed ? high[1] + reversalLabelAtr * 0.4 : na, title="Bear AI icon", style=shape.triangledown, location=location.absolute, color=color.fuchsia, size=size.small, offset=-1, force_overlay=true)
